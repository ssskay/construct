// `provider add|configure` persist to `.construct/providers/<id>.json`; every
// success message names the path relative to cwd so output is copy-pasteable
// and consistent whether the command ran from the project root or a subdir.

function instanceConfigRelPath(id) {
  return path.join(CONFIG_DIR_NAME, 'providers', `${id}.json`);
}

async function cmdProvider(args) {
  const sub = args[0];

  if (!sub || sub === 'list') {
    const { describeProviders } = await import('../lib/providers/registry.mjs');
    const desc = await describeProviders({ rootDir: process.cwd(), env: process.env });
    println('Data-source providers');
    println('═════════════════════');
    for (const entry of desc.summary) {
      const status = entry.health.ok ? '✓' : '○';
      println(`  ${status}  ${entry.id.padEnd(24)} ${entry.displayName}`);
      println(`     capabilities: ${entry.capabilities.join(', ')}`);
      if (entry.health.detail) println(`     health: ${entry.health.detail}`);
      if (entry.source && entry.source !== 'built-in') println(`     source: ${entry.source}`);
    }
    if (desc.errors.length) {
      println('');
      errorln('Errors loading providers:');
      for (const e of desc.errors) errorln(`  ✗ [${e.id}] ${e.error}`);
      process.exit(1);
    }
    return;
  }

  if (sub === 'status') {
    const jsonOutput = args.includes('--json');
    const { getState } = await import('../lib/providers/circuit-breaker.mjs');
    const { describeProviders } = await import('../lib/providers/registry.mjs');
    const { readInstanceConfig } = await import('../lib/providers/instance-config.mjs');
    const desc = await describeProviders({ rootDir: process.cwd(), env: process.env });

    // Breaker state is registered under `provider:<id>` (see registry.mjs
    // wrapWithBreaker); look up with that prefix or the row reads CLOSED for
    // every provider regardless of actual state.
    const rows = desc.summary.map((entry) => {
      const breaker = getState(`provider:${entry.id}`);
      const breakerState = breaker ? breaker.state : 'CLOSED';
      const degraded = !entry.health.ok || breakerState !== 'CLOSED';
      const instance = readInstanceConfig(process.cwd(), entry.id);
      const filter = instance?.config?.filter ?? null;
      return {
        id: entry.id,
        enabled: entry.health.ok,
        breaker: breakerState,
        failures: breaker ? breaker.failures : 0,
        degraded,
        source: entry.source,
        filter,
      };
    });

    if (jsonOutput) {
      println(JSON.stringify({ providers: rows, errors: desc.errors }, null, 2));
      if (desc.errors.length) process.exit(1);
      return;
    }

    println('Provider status');
    println('════════════════');
    println(`  ${'ID'.padEnd(24)} ${'ENABLED'.padEnd(9)} ${'BREAKER'.padEnd(18)} DEGRADED`);
    for (const row of rows) {
      const breakerCol = row.failures > 0 ? `${row.breaker} (${row.failures})` : row.breaker;
      println(`  ${row.id.padEnd(24)} ${(row.enabled ? 'yes' : 'no').padEnd(9)} ${breakerCol.padEnd(18)} ${row.degraded ? 'yes' : 'no'}`);
      if (row.filter) println(`     filter: ${JSON.stringify(row.filter)}`);
    }
    if (desc.errors.length) {
      println('');
      errorln('Errors loading providers:');
      for (const e of desc.errors) errorln(`  ✗ [${e.id}] ${e.error}`);
      process.exit(1);
    }
    return;
  }

  if (sub === 'health') {
    const jsonOutput = args.includes('--json');
    const id = args[1] && !args[1].startsWith('--') ? args[1] : undefined;
    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers, errors } = await resolveProviders({ rootDir: process.cwd(), env: process.env });

    if (id && !providers[id]) {
      const loadError = errors.find((e) => e.id === id);
      if (jsonOutput) {
        println(JSON.stringify({ id, ok: false, error: loadError ? loadError.error : `unknown provider: ${id}` }, null, 2));
      } else {
        errorln(`Unknown provider: ${id}`);
        if (loadError) errorln(loadError.error);
      }
      process.exit(1);
    }

    const targetIds = id ? [id] : Object.keys(providers);
    const results = await Promise.all(
      targetIds.map(async (pid) => {
        try {
          const health = await providers[pid].health({});
          return { id: pid, ok: !!health.ok, detail: health.detail || null };
        } catch (err) {
          return { id: pid, ok: false, detail: err.message };
        }
      })
    );

    const anyFailed = results.some((r) => !r.ok) || errors.length > 0;

    if (jsonOutput) {
      println(JSON.stringify({ results, loadErrors: errors }, null, 2));
      process.exit(anyFailed ? 1 : 0);
    }

    println('Provider health');
    println('════════════════');
    for (const r of results) {
      println(`  ${r.ok ? '✓' : '✗'}  ${r.id.padEnd(24)} ${r.ok ? 'ok' : 'unhealthy'}`);
      if (r.detail) println(`     ${r.detail}`);
    }
    if (errors.length) {
      println('');
      errorln('Errors loading providers:');
      for (const e of errors) errorln(`  ✗ [${e.id}] ${e.error}`);
    }
    process.exit(anyFailed ? 1 : 0);
  }

  if (sub === 'validate') {
    const jsonOutput = args.includes('--json');
    const target = args[1] && !args[1].startsWith('--') ? args[1] : undefined;
    if (!target) { errorln('Usage: construct provider validate <path|id>'); process.exit(1); }

    const { validateManifest } = await import('../lib/extensions/validate.mjs');
    const { loadManifestsFromDir, mergeManifests, resolveManifestDirs } = await import('../lib/extensions/loader.mjs');

    let manifest;
    let filePath;
    const looksLikePath = target.endsWith('.json') || target.includes('/') || target.startsWith('.');

    if (looksLikePath) {
      filePath = path.isAbsolute(target) ? target : path.resolve(process.cwd(), target);
      if (!fs.existsSync(filePath)) {
        const result = { valid: false, errors: [`${filePath}: file not found`] };
        if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(result.errors[0]); }
        process.exit(1);
      }
      try {
        manifest = JSON.parse(fs.readFileSync(filePath, 'utf8'));
      } catch (err) {
        const result = { valid: false, errors: [`${filePath}: failed to parse JSON (${err.message})`] };
        if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(result.errors[0]); }
        process.exit(1);
      }
    } else {
      const dirs = resolveManifestDirs({ rootDir: process.cwd(), homeDir: HOME });
      const builtin = loadManifestsFromDir(dirs.builtin).manifests;
      const user = loadManifestsFromDir(dirs.user).manifests;
      const project = loadManifestsFromDir(dirs.project).manifests;
      const merged = mergeManifests(builtin, user, project);
      manifest = merged.find((m) => m.id === target);
      if (!manifest) {
        const result = { valid: false, errors: [`no manifest found for provider id '${target}'`] };
        if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(result.errors[0]); }
        process.exit(1);
      }
      filePath = manifest._filePath;
    }

    const strict = args.includes('--strict');
    const result = validateManifest(manifest, { filePath, strict });

    if (jsonOutput) {
      println(JSON.stringify(result, null, 2));
      process.exit(result.valid ? 0 : 1);
    }

    if (result.valid) {
      println(`✓ ${filePath || target} is a valid manifest`);
      process.exit(0);
    }
    errorln(`✗ ${filePath || target} failed validation:`);
    for (const e of result.errors) errorln(`  ${e}`);
    process.exit(1);
  }

  if (sub === 'info') {
    const id = args[1];
    if (!id) { errorln('Usage: construct provider info <id>'); process.exit(1); }
    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers, errors } = await resolveProviders({ rootDir: process.cwd(), env: process.env });
    if (!providers[id]) {
      errorln(`Unknown provider: ${id}`);
      if (errors.find((e) => e.id === id)) errorln(errors.find((e) => e.id === id).error);
      process.exit(1);
    }
    const p = providers[id];
    println(`${p.meta.displayName} (${p.meta.id})`);
    println('─'.repeat(48));
    println(`Capabilities: ${p.meta.capabilities.join(', ')}`);
    if (p.meta.description) println(`Description:  ${p.meta.description}`);
    if (p.configSchema) {
      println('');
      println('Config schema:');
      println(JSON.stringify(p.configSchema, null, 2));
    }
    return;
  }

  if (sub === 'test') {
    const id = args[1];
    if (!id) { errorln('Usage: construct provider test <id>'); process.exit(1); }
    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers } = await resolveProviders({ rootDir: process.cwd(), env: process.env });
    if (!providers[id]) { errorln(`Unknown provider: ${id}`); process.exit(1); }
    const health = await providers[id].health({});
    println(`${id}: ${health.ok ? 'ok' : 'unhealthy'}`);
    if (health.detail) println(`  ${health.detail}`);
    process.exit(health.ok ? 0 : 1);
  }

  if (sub === 'plugins') {
    const action = args[1];
    if (action === 'add' || action === 'remove') {
      const id = args[2];
      const pkg = args[3];
      if (!id) { errorln(`Usage: construct provider plugins ${action} <id> [<package>]`); process.exit(1); }
      const isGlobal = args.includes('--global');
      const targetPath = isGlobal
        ? path.join(configDir(HOME), 'providers.json')
        : configPath(process.cwd(), 'providers.json');
      let data = { providers: [] };
      try { data = JSON.parse(fs.readFileSync(targetPath, 'utf8')); } catch { /* fresh */ }
      data.providers ??= [];
      if (action === 'add') {
        if (!pkg) { errorln(`Usage: construct provider plugins add <id> <package>`); process.exit(1); }
        if (data.providers.some((p) => p.id === id && p.package === pkg)) {
          println(`Already present: ${id} → ${pkg}`);
          return;
        }
        data.providers.push({ id, package: pkg, options: {} });
      } else {
        data.providers = data.providers.filter((p) => p.id !== id);
      }
      fs.mkdirSync(path.dirname(targetPath), { recursive: true });
      fs.writeFileSync(targetPath, JSON.stringify(data, null, 2) + '\n');
      println(`✓ ${action === 'add' ? 'Added' : 'Removed'} ${id}${pkg ? ` → ${pkg}` : ''} (${path.relative(process.cwd(), targetPath)})`);
      return;
    }
    errorln(`Usage: construct provider plugins <add|remove> <id> [<package>] [--global]`);
    process.exit(1);
  }

  if (sub === 'new') {
    const name = args[1];
    if (!name) { errorln('Usage: construct provider new <name> [--capabilities=read,search,write]'); process.exit(1); }
    const { scaffoldProvider } = await import('../lib/providers/scaffold.mjs');
    const capFlag = args.find((a) => a.startsWith('--capabilities='));
    const capabilities = capFlag ? capFlag.replace('--capabilities=', '').split(',') : ['read', 'search'];
    const force = args.includes('--force');
    const result = await scaffoldProvider(name, { capabilities, force, rootDir: ROOT_DIR });
    if (result.skipped?.length) println(`Skipped (already exist): ${result.skipped.join(', ')}`);
    if (result.written?.length) println(`Created: ${result.written.join('\n  ')}`);
    println(`\nProvider scaffold ready. Run: npm test tests/providers/${name}.test.mjs`);
    return;
  }

  if (sub === 'add') {
    const id = args[1] && !args[1].startsWith('--') ? args[1] : undefined;
    const jsonOutput = args.includes('--json');
    if (!id) { errorln('Usage: construct provider add <id>'); process.exit(1); }

    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers, errors } = await resolveProviders({ rootDir: process.cwd(), env: process.env });
    if (!providers[id]) {
      const loadError = errors.find((e) => e.id === id);
      const result = { ok: false, error: loadError ? loadError.error : `unknown provider: ${id}` };
      if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(`Unknown provider: ${id}`); if (loadError) errorln(loadError.error); }
      process.exit(1);
    }

    const { readInstanceConfig, writeInstanceConfig, defaultsFromSchema } = await import('../lib/providers/instance-config.mjs');
    const existing = readInstanceConfig(process.cwd(), id);
    if (existing) {
      const result = { ok: false, error: `instance config already exists for '${id}'; use 'provider configure ${id}' to change it` };
      if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(result.error); }
      process.exit(1);
    }

    const configSchema = providers[id].configSchema || {};
    const defaults = defaultsFromSchema(configSchema);
    const record = writeInstanceConfig(process.cwd(), id, defaults);

    if (jsonOutput) {
      println(JSON.stringify({ ok: true, providerId: id, config: record.config, path: instanceConfigRelPath(id) }, null, 2));
      return;
    }
    println(`Added ${id} (${instanceConfigRelPath(id)})`);
    println(JSON.stringify(record.config, null, 2));
    return;
  }

  if (sub === 'configure') {
    const id = args[1] && !args[1].startsWith('--') ? args[1] : undefined;
    const jsonOutput = args.includes('--json');
    if (!id) { errorln('Usage: construct provider configure <id> [--key value ...]'); process.exit(1); }

    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers, errors } = await resolveProviders({ rootDir: process.cwd(), env: process.env });
    if (!providers[id]) {
      const loadError = errors.find((e) => e.id === id);
      const result = { ok: false, error: loadError ? loadError.error : `unknown provider: ${id}` };
      if (jsonOutput) { println(JSON.stringify(result, null, 2)); } else { errorln(`Unknown provider: ${id}`); if (loadError) errorln(loadError.error); }
      process.exit(1);
    }

    const {
      readInstanceConfig, writeInstanceConfig, defaultsFromSchema, applyOverrides, validateInstanceConfig,
    } = await import('../lib/providers/instance-config.mjs');

    // `--json` is the one bare boolean flag this subcommand accepts; every
    // other `--foo` is a key.path expecting a value, so it is excluded from
    // the key/value scan below rather than mis-parsed as a dangling key.
    const BARE_FLAGS = new Set(['--json']);

    const overrides = [];
    for (let i = 2; i < args.length; i++) {
      const a = args[i];
      if (!a.startsWith('--') || BARE_FLAGS.has(a)) continue;
      const keyPath = a.slice(2);
      const value = args[i + 1];
      if (value === undefined || value.startsWith('--')) {
        errorln(`Usage: construct provider configure <id> --<key.path> <value> (missing value for --${keyPath})`);
        process.exit(1);
      }
      overrides.push({ keyPath, value });
      i++;
    }

    const configSchema = providers[id].configSchema || {};
    const existing = readInstanceConfig(process.cwd(), id);
    const base = existing ? existing.config : defaultsFromSchema(configSchema);
    const merged = applyOverrides(base, overrides);

    const result = validateInstanceConfig(id, configSchema, merged);
    if (!result.valid) {
      if (jsonOutput) {
        println(JSON.stringify({ ok: false, providerId: id, errors: result.errors }, null, 2));
      } else {
        errorln(`✗ configure ${id} failed validation:`);
        for (const e of result.errors) errorln(`  ${e}`);
      }
      process.exit(1);
    }

    const record = writeInstanceConfig(process.cwd(), id, merged);
    if (jsonOutput) {
      println(JSON.stringify({ ok: true, providerId: id, config: record.config, path: instanceConfigRelPath(id) }, null, 2));
      return;
    }
    println(`✓ Configured ${id} (${instanceConfigRelPath(id)})`);
    println(JSON.stringify(record.config, null, 2));
    return;
  }

  errorln(`Unknown provider subcommand: ${sub}. Available: list, status, health, validate, info, test, add, configure, plugins, new`);
  process.exit(1);
}

async function cmdTags(args) {
  const sub = args[0];
  const { loadVocabulary } = await import('../lib/tags/vocabulary.mjs');
  const { proposeTag, addTag, deprecateTag, archiveTag, listProposed, auditTags } =
    await import('../lib/tags/lifecycle.mjs');

  if (!sub || sub === 'audit') {
    const report = auditTags();
    println(`Tag audit\n`);
    println(`Active tags: ${Object.keys(report.active).length}`);
    if (report.overBudget.length) {
      println(`\nOver budget:`);
      for (const t of report.overBudget) println(`  ${t.id}  count=${t.count}  budget=${t.budget}`);
    }
    if (report.deprecated.length) {
      println(`\nDeprecated (still in use):`);
      for (const t of report.deprecated) println(`  ${t.id}  docs=${t.docCount}  replacedBy=${t.replacedBy || '—'}`);
    }
    if (report.unknown.length) {
      println(`\nUnknown (in docs, not in vocab):`);
      for (const t of report.unknown) println(`  ${t.id}  docs=${t.docCount}`);
    }
    if (report.orphan.length) {
      println(`\nOrphan (in vocab, never used):`);
      for (const t of report.orphan) println(`  ${t.id}`);
    }
    return;
  }

  if (sub === 'propose') {
    const id = args[1];
    const facetArg = args.find((a) => a.startsWith('--facet='))?.replace('--facet=', '');
    const labelArg = args.find((a) => a.startsWith('--label='))?.replace('--label=', '');
    if (!id || !facetArg) { errorln('Usage: construct tags propose <id> --facet=<f> [--label="..."]'); process.exit(1); }
    proposeTag({ id, facet: facetArg, label: labelArg || id });
    println(`Proposed tag ${id} written to .construct/tags/proposed.jsonl`);
    return;
  }

  if (sub === 'add') {
    const id = args[1];
    const facetArg = args.find((a) => a.startsWith('--facet='))?.replace('--facet=', '');
    const labelArg = args.find((a) => a.startsWith('--label='))?.replace('--label=', '');
    const scope = args.includes('--scope=project') ? 'project' : 'repo';
    if (!id || !facetArg) { errorln('Usage: construct tags add <id> --facet=<f> [--label="..."] [--scope=project]'); process.exit(1); }
    addTag({ id, facet: facetArg, label: labelArg || id, scope, cwd: process.cwd(), rootDir: ROOT_DIR });
    println(`Tag ${id} added to ${scope === 'project' ? '.construct/tags/vocabulary-overrides.json' : 'config/tag-vocabulary.json'}`);
    return;
  }

  if (sub === 'deprecate') {
    const id = args[1];
    const reason = args.find((a) => a.startsWith('--reason='))?.replace('--reason=', '');
    const replacedBy = args.find((a) => a.startsWith('--replaced-by='))?.replace('--replaced-by=', '');
    if (!id) { errorln('Usage: construct tags deprecate <id> --reason="..." [--replaced-by=<other>]'); process.exit(1); }
    deprecateTag({ id, reason: reason || 'deprecated', replacedBy, cwd: process.cwd(), rootDir: ROOT_DIR });
    println(`Tag ${id} marked deprecated.`);
    return;
  }

  if (sub === 'archive') {
    const id = args[1];
    if (!id) { errorln('Usage: construct tags archive <id>'); process.exit(1); }
    archiveTag({ id, cwd: process.cwd(), rootDir: ROOT_DIR });
    println(`Tag ${id} archived.`);
    return;
  }

  if (sub === 'list') {
    const vocab = loadVocabulary({ rootDir: ROOT_DIR, cwd: process.cwd() });
    println(`Tag vocabulary (${vocab.tags.length} entries)\n`);
    for (const t of vocab.tags) {
      if (t.status === 'archived') continue;
      const dep = t.status === 'deprecated' ? ' [deprecated]' : '';
      println(`  ${t.id.padEnd(40)} facet=${t.facet}  status=${t.status}${dep}`);
    }
    return;
  }

  if (sub === 'proposed') {
    const items = listProposed({ cwd: process.cwd() });
    if (!items.length) { println('No pending tag proposals.'); return; }
    println(`${items.length} pending proposal(s):\n`);
    for (const p of items) println(`  ${p.id.padEnd(40)} facet=${p.facet}  proposed=${p.proposedAt}`);
    return;
  }

  if (sub === 'backfill') {
    println('Tag backfill reads .construct/knowledge/**/*.md frontmatter and writes tags to construct_documents.');
    println('Requires DATABASE_URL. Use: node scripts/tag-candidate-mining.mjs for standalone mode.');
    return;
  }

  errorln(`Unknown tags subcommand: ${sub}. Available: audit, propose, add, deprecate, archive, list, proposed, backfill`);
  process.exit(1);
}

async function cmdScheduler(args) {
  const sub = args[0];
  const { runJobOnce, listJobs } = await import('../lib/scheduler/index.mjs');

  if (!sub || sub === 'list') {
    const jobs = listJobs();
    println(`Scheduled jobs (${jobs.length})\n`);
    for (const j of jobs) {
      println(`  ${j.id.padEnd(30)} schedule=${j.schedule}  mode=${j.mode}`);
    }
    return;
  }

  if (sub === 'run') {
    const id = args[1];
    if (!id) { errorln('Usage: construct scheduler run <job-id>'); process.exit(1); }
    println(`Running job '${id}' one-shot…`);
    try {
      await runJobOnce(id, { cwd: process.cwd(), env: process.env });
      println(`Job '${id}' completed.`);
    } catch (err) {
      errorln(`Job '${id}' failed: ${err.message}`);
      process.exit(1);
    }
    return;
  }

  if (sub === 'runner') {
    println('Starting scheduler runner (team/enterprise mode)…');
    println('Set DATABASE_URL for Postgres-backed leader-election runner.');
    println('In solo mode, use native triggers: construct scheduler list');
    return;
  }

  errorln(`Unknown scheduler subcommand: ${sub}. Available: list, run, runner`);
  process.exit(1);
}

async function cmdCreds(args) {
  const sub = args[0];
  const { writeCreds, deleteCreds, listCreds, checkCredsFileMode, credsFilePath } =
    await import('../lib/providers/creds.mjs');
  const { createInterface } = await import('node:readline');

  if (!sub || sub === 'list') {
    const entries = listCreds();
    if (entries.length === 0) {
      println('No provider credentials stored in the rotation store.');
    } else {
      println('Provider credentials\n');
      println('  PROVIDER                  ACCOUNT                    ROTATED_AT             NEXT_ROTATION');
      for (const e of entries) {
        println(`  ${e.provider.padEnd(26)} ${(e.account || '—').padEnd(27)} ${(e.rotatedAt || '—').padEnd(23)} ${e.nextRotationDue || '—'}`);
      }
    }
    try {
      const { getProviderModelCatalog } = await import('../lib/model-router.mjs');
      const { providers } = getProviderModelCatalog({ env: process.env });
      println('\nLLM provider readiness (presence-only — op:// references resolve at call time; run `construct creds test <provider>` to verify auth)\n');
      for (const p of providers) {
        println(`  ${p.configured ? '✓ configured (unverified ref)' : '· not configured'} ${p.id}`);
      }
      println(`\n  Set keys as values or op:// refs in ${getUserEnvPath(HOME)}; run \`construct creds login copilot\` for GitHub Copilot.`);
    } catch { /* readiness view is informational */ }
    return;
  }

  if (sub === 'test') {
    const provider = args[1];
    if (!provider) { errorln('Usage: construct creds test <provider>'); process.exit(1); }
    if (['openrouter', 'anthropic', 'openai'].includes(provider)) {
      const { probeProviderConnection } = await import('../lib/providers/connection-probe.mjs');
      const result = await probeProviderConnection(provider, { env: process.env, cwd: process.cwd() });
      println(`${provider}: ${result.ok ? 'ok' : 'unhealthy'}`);
      if (result.code) println(`  ${result.code}${result.status ? ` (${result.status})` : ''}`);
      process.exit(result.ok ? 0 : 1);
    }
    const { resolveProviders } = await import('../lib/providers/registry.mjs');
    const { providers } = await resolveProviders({ rootDir: ROOT_DIR, env: process.env });
    if (!providers[provider]) { errorln(`Unknown provider: ${provider}`); process.exit(1); }
    const health = await providers[provider].health({});
    println(`${provider}: ${health.ok ? 'ok' : 'unhealthy'}`);
    if (health.detail) println(`  ${health.detail}`);
    process.exit(health.ok ? 0 : 1);
  }

  if (sub === 'revoke') {
    const provider = args[1];
    if (!provider) { errorln('Usage: construct creds revoke <provider>'); process.exit(1); }
    deleteCreds(provider);
    println(`Credentials for ${provider} removed from ${credsFilePath()}.`);
    return;
  }

  if (sub === 'set' || sub === 'rotate') {
    const provider = args[1];
    if (!provider) { errorln(`Usage: construct creds ${sub} <provider>`); process.exit(1); }
    println(`Enter credentials for ${provider} (input hidden):`);
    const rl = createInterface({ input: process.stdin, output: process.stdout });
    const ask = (q) => new Promise((r) => rl.question(q, r));
    const key = await ask('API key / token: ');
    const account = await ask('Account / username (optional): ');
    rl.close();
    writeCreds(provider, { key: key.trim(), account: account.trim() || undefined });
    checkCredsFileMode();
    println(`\nCredentials stored at ${credsFilePath()} (mode 0600).`);
    return;
  }

  if (sub === 'login') {
    const provider = args[1] || 'copilot';
    if (provider !== 'copilot' && provider !== 'github-copilot') {
      errorln(`\`creds login\` currently supports only \`copilot\`. For API-key providers use \`construct creds set ${provider}\`.`);
      process.exit(1);
    }
    const copilot = await import('../lib/providers/copilot-auth.mjs');
    if (copilot.hasStoredCredential() && !args.includes('--force')) {
      try {
        await copilot.getCopilotToken();
        println('GitHub Copilot is already authenticated and the session token exchanged successfully.');
        println('Re-run with --force to authenticate a different account.');
        return;
      } catch {
        println('A stored Copilot credential exists but the session exchange failed; re-authenticating.');
      }
    }
    let device;
    try {
      device = await copilot.requestDeviceCode({});
    } catch (err) {
      errorln(err.message);
      process.exit(1);
    }
    println('\nGitHub Copilot sign-in');
    println(`  1. Open: ${device.verificationUri}`);
    println(`  2. Enter code: ${device.userCode}`);
    println('\nWaiting for authorization...');
    let token;
    try {
      token = await copilot.pollForAccessToken({
        deviceCode: device.deviceCode,
        interval: device.interval,
        expiresIn: device.expiresIn,
        onPending: () => process.stdout.write('.'),
      });
      process.stdout.write('\n');
    } catch (err) {
      process.stdout.write('\n');
      errorln(err.message);
      process.exit(1);
    }
    copilot.persistOAuth({ accessToken: token.accessToken, refreshToken: token.refreshToken, expiresAt: token.expiresAt, user: null });
    try {
      await copilot.getCopilotToken();
      println('GitHub Copilot authenticated. The session token exchanged successfully.');
      println('Credentials stored in ~/.construct/auth/github-copilot.json and ~/.config/github-copilot/apps.json.');
      try {
        const models = await copilot.listCopilotModels({});
        if (models.length) {
          println('\nModels available to your account (use as github-copilot/<id>):');
          for (const id of models) println(`  - github-copilot/${id}`);
        }
      } catch { /* model listing is informational; auth already succeeded */ }
    } catch (err) {
      errorln(`Authenticated with GitHub, but the Copilot token exchange failed: ${err.message}`);
      process.exit(1);
    }
    return;
  }

  errorln(`Unknown creds subcommand: ${sub}. Available: list, login, set, rotate, revoke, test`);
  process.exit(1);
}

async function cmdProviders(args) {
  const sub = args[0];

  if (!sub || sub === 'status') {
    const resetProvider = args.find((a) => a.startsWith('--reset='))?.replace('--reset=', '');
    if (resetProvider) {
      const { reset } = await import('../lib/providers/circuit-breaker.mjs');
      reset(resetProvider);
      println(`Circuit breaker for ${resetProvider} reset to CLOSED.`);
      return;
    }
    const { getState } = await import('../lib/providers/circuit-breaker.mjs');
    const { describeProviders } = await import('../lib/providers/registry.mjs');
    const desc = await describeProviders({ rootDir: ROOT_DIR, env: process.env });
    println('Provider status\n');
    for (const entry of desc.summary) {
      const breaker = getState(entry.id);
      const breakerStatus = breaker.state === 'CLOSED' ? 'closed' : `OPEN (${breaker.failures} failures)`;
      println(`  ${entry.id.padEnd(26)} enabled=${entry.health.ok ? 'yes' : 'no'}  breaker=${breakerStatus}`);
    }
    return;
  }

  if (sub === 'discover') {
    const providerName = args[1];
    if (!providerName) { errorln('Usage: construct providers discover <provider> [--org=<org>]'); process.exit(1); }
    const orgFlag = args.find((a) => a.startsWith('--org='))?.replace('--org=', '');
    println(`Discovering resources for ${providerName}${orgFlag ? ` (org: ${orgFlag})` : ''}…`);
    println('Discovery requires the provider to be configured with a valid API token.');
    println(`Run: construct creds set ${providerName}`);
    return;
  }

  errorln(`Unknown providers subcommand: ${sub}. Available: status, discover`);
  process.exit(1);
}

// Capability discovery surface — a read-only, secret-free description of the
// installed Construct's capabilities, for embedding applications.

async function cmdCapability(args) {
  const sub = args[0];
  if (sub && sub !== 'describe' && !sub.startsWith('--')) {
    errorln(`Unknown capability subcommand: ${sub}. Available: describe`);
    process.exit(1);
  }
  const { buildCapabilityContract } = await import('../lib/embedded-contract/capability.mjs');
  const { wrapContractResult } = await import('../lib/embedded-contract/envelope.mjs');
  const envelope = wrapContractResult(buildCapabilityContract({ rootDir: ROOT_DIR }), { surface: 'cli' });
  println(JSON.stringify(envelope, null, 2));
}

async function cmdWorkflow(args) {
  const sub = args[0] || 'list';

  if (sub === 'invoke') {
    const rest = args.slice(1);
    const flag = (name) => { const i = rest.indexOf(name); return i !== -1 ? rest[i + 1] : undefined; };
    let input = flag('--text') || '';
    const fileArg = flag('--file');
    let ingestion = null;
    if (!input && fileArg) {
      const { resolveInput } = await import('../lib/embedded-contract/ingest.mjs');
      const resolved = await resolveInput({ filePath: fileArg });
      input = resolved.text;
      ingestion = resolved.error ? { ...(resolved.ingestion || {}), error: resolved.error } : resolved.ingestion;
    }
    if (!input && !process.stdin.isTTY) input = fs.readFileSync(0, 'utf8');
    const request = {
      workflowType: flag('--workflow-type'),
      input,
      ingestion,
      roleStrategy: flag('--role-strategy'),
      requestedRoles: flag('--roles')?.split(',').map((s) => s.trim()).filter(Boolean),
      approvalMode: flag('--approval-mode'),
      trace: !rest.includes('--no-trace'),
      host: flag('--host'),
      hostModel: flag('--host-model'),
      hostProvider: flag('--host-provider'),
      recruitment: flag('--recruitment'),
    };
    const { invokeWorkflow } = await import('../lib/embedded-contract/workflow-invoke.mjs');
    const { wrapContractResult } = await import('../lib/embedded-contract/envelope.mjs');
    const envelope = wrapContractResult(await invokeWorkflow(request), { surface: 'cli' });
    println(JSON.stringify(envelope, null, 2));
    return;
  }

  if (sub === 'list') {
    const { existsSync, readdirSync } = await import('node:fs');
    const { join } = await import('node:path');
    const dir = join(ROOT_DIR, 'templates', 'workflows');
    if (!existsSync(dir)) { println('No workflow templates found.'); return; }
    const files = readdirSync(dir).filter((f) => f.endsWith('.yml') || f.endsWith('.yaml'));
    if (files.length === 0) { println('No workflow templates found.'); return; }
    println('Available workflow templates:\n');
    for (const f of files) {
      try {
        const { readFileSync } = await import('node:fs');
        const raw = readFileSync(join(dir, f), 'utf8');
        const titleMatch = raw.match(/^title:\s*(.+)$/m);
        const descMatch = raw.match(/^description:\s*(.+)$/m);
        const id = f.replace(/\.(yml|yaml)$/, '');
        println(`  ${id.padEnd(30)} ${titleMatch?.[1] || ''}`);
        if (descMatch?.[1]) println(`  ${''.padEnd(30)} ${descMatch[1]}`);
      } catch { println(`  ${f}`); }
    }
    return;
  }

  if (sub === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct workflow show <id>'); process.exit(1); }
    const { existsSync, readFileSync } = await import('node:fs');
    const { join } = await import('node:path');
    const candidates = [
      join(ROOT_DIR, 'templates', 'workflows', `${id}.yml`),
      join(ROOT_DIR, 'templates', 'workflows', `${id}.yaml`),
    ];
    const p = candidates.find(existsSync);
    if (!p) { errorln(`Workflow template not found: ${id}`); process.exit(1); }
    println(readFileSync(p, 'utf8'));
    return;
  }

  if (sub === 'new') {
    const id = args[1];
    if (!id) { errorln('Usage: construct workflow new <template-id> [--name=<name>] [--non-interactive]'); process.exit(1); }
    const { instantiateWorkflow } = await import('../lib/workflows/instantiate.mjs');
    const nameFlag = args.find((a) => a.startsWith('--name='))?.replace('--name=', '');
    const nonInteractive = args.includes('--non-interactive');
    const inputs = {};
    if (nameFlag) inputs.feature_name = nameFlag;
    try {
      const { artifacts, beadsItems } = await instantiateWorkflow(id, inputs, { cwd: process.cwd(), nonInteractive });
      println(`\nWorkflow '${id}' instantiated:`);
      for (const a of artifacts) println(`  + ${a.path}`);
      if (beadsItems?.length) {
        println(`\n${beadsItems.length} beads item(s) ready to create via: bd create`);
        for (const item of beadsItems) println(`  - ${item.title}`);
      }
    } catch (err) {
      errorln(`Workflow instantiation failed: ${err.message}`);
      process.exit(1);
    }
    return;
  }

  errorln(`Unknown workflow subcommand: ${sub}. Available: list, show, new`);
  process.exit(1);
}

async function cmdTelemetryQuery(args) {
  const sub = args[0];
  const rest = args.slice(1);
  const flags = {};
  for (let i = 0; i < rest.length; i++) {
    const m = rest[i].match(/^--(\w[\w-]*)(?:=(.+))?$/);
    if (m) flags[m[1]] = m[2] ?? rest[++i] ?? true;
  }

  const { summarizeSkillCalls } = await import('../lib/telemetry/skill-calls.mjs');

  if (sub === 'latency') {
    const p = flags.p ? parseInt(flags.p, 10) : 95;
    const since = flags.since || '24h';
    const op = flags.operation;
    const { skills } = summarizeSkillCalls({ since });
    const relevant = op
      ? Object.entries(skills).filter(([id]) => id.includes(op))
      : Object.entries(skills);
    if (relevant.length === 0) { println('No latency data found.'); return; }
    const key = p >= 95 ? 'p95LatencyMs' : 'p50LatencyMs';
    const sorted = relevant.filter(([, s]) => s[key] != null).sort((a, b) => b[1][key] - a[1][key]);
    println(`p${p} latency — last ${since}${op ? `  operation: ${op}` : ''}\n`);
    for (const [id, s] of sorted.slice(0, 20)) {
      println(`  ${id.padEnd(50)} p${p}=${s[key]}ms`);
    }
    return;
  }

  if (sub === 'top-slow') {
    const limit = parseInt(flags.limit || '10', 10);
    const since = flags.since || '24h';
    const { skills } = summarizeSkillCalls({ since });
    const sorted = Object.entries(skills)
      .filter(([, s]) => s.p95LatencyMs != null)
      .sort((a, b) => b[1].p95LatencyMs - a[1].p95LatencyMs)
      .slice(0, limit);
    if (sorted.length === 0) { println('No latency data found.'); return; }
    println(`Top ${limit} slow operations — last ${since}\n`);
    for (const [id, s] of sorted) {
      println(`  ${id.padEnd(50)} p95=${s.p95LatencyMs}ms p50=${s.p50LatencyMs}ms calls=${s.calls}`);
    }
    return;
  }

  if (sub === 'errors') {
    println('Error trace query requires an OTLP backend (OTEL_EXPORTER_OTLP_ENDPOINT).');
    println('In local-only mode, check ~/.cx/mcp-audit.json for recent tool call errors.');
    return;
  }

  if (sub === 'trace') {
    const traceId = rest[0];
    if (!traceId) { errorln('Usage: construct telemetry query trace <traceId>'); process.exit(1); }
    println(`Trace ${traceId}:`);
    println('Full span tree query requires an OTLP-compatible backend (Langfuse, Honeycomb, Grafana Tempo).');
    println('Local mode only captures skill call events — set OTEL_EXPORTER_OTLP_ENDPOINT for full traces.');
    return;
  }

  println('Usage: construct telemetry query <subcommand> [flags]');
  println('');
  println('Subcommands:');
  println('  latency [--p=95] [--operation=<op>] [--since=24h]   p-ile latency by skill');
  println('  top-slow [--limit=10] [--since=24h]                  slowest operations');
  println('  errors [--agent=<name>] [--since=24h]                error span summary');
  println('  trace <traceId>                                       full span tree');
  println('');
  println('For Langfuse/Honeycomb/Grafana Tempo/Datadog, see docs/guides/concepts/observability.md');
}

async function cmdHook(args) {
  const name = args[0];
  if (!name) {
    errorln('Usage: construct hook <name>  (e.g. construct hook session-start)');
    process.exit(1);
  }
  const safe = name.replace(/[^a-z0-9-]/gi, '');
  if (safe !== name) {
    errorln(`Invalid hook name '${name}': use lowercase letters, digits, or hyphens.`);
    process.exit(1);
  }
  const hookPath = path.join(ROOT_DIR, 'lib', 'hooks', `${safe}.mjs`);
  if (!fs.existsSync(hookPath)) {
    errorln(`Hook not found: ${hookPath}`);
    process.exit(1);
  }
  const started = Date.now();
  const result = spawnSync(process.execPath, [hookPath, ...args.slice(1)], { stdio: 'inherit' });
  const exitCode = result.status ?? 0;

  // Record fire + outcome so hooks can be judged on whether they ever gate
  // anything, not just on latency. Dynamic import keeps non-hook commands from
  // paying the load; a telemetry failure must never change the hook's exit code.
  try {
    const { logHookCall } = await import('../lib/telemetry/hook-calls.mjs');
    logHookCall({ hookId: safe, exitCode, latencyMs: Date.now() - started });
  } catch { /* telemetry is best-effort */ }

  process.exit(exitCode);
}

const [command, ...rest] = process.argv.slice(2);
const restArgsCache = rest;

// Parse `--key=value` and repeatable `--source-url=<url>` for `construct knowledge add`.
function parseKnowledgeAddArgs(args) {
  const opts = { slug: null, topic: null, confidence: 'inferred', sources: [] };
  for (const arg of args) {
    if (arg.startsWith('--slug=')) opts.slug = arg.slice('--slug='.length);
    else if (arg.startsWith('--topic=')) opts.topic = arg.slice('--topic='.length);
    else if (arg.startsWith('--confidence=')) opts.confidence = arg.slice('--confidence='.length);
    else if (arg.startsWith('--source-url=')) opts.sources.push({ url: arg.slice('--source-url='.length) });
    else if (arg.startsWith('--source=')) { /* tag, ignored for now */ }
  }
  return opts;
}

// Read all of stdin as a UTF-8 string. Returns '' if nothing was piped.
async function readStdin() {
  if (process.stdin.isTTY) return '';
  let raw = '';
  for await (const chunk of process.stdin) raw += chunk;
  return raw;
}

async function cmdStudio(args = []) {
  const { startOrgStudio } = await import('../lib/org-studio/server.mjs');
  const portArg = args.find((a) => a.startsWith('--port='));
  const port = portArg ? Number(portArg.split('=')[1]) : 4321;
  const { url } = await startOrgStudio({ rootDir: PROJECT_ROOT, port });
  ok(`Org Studio → ${url}`);
  info('Authoring specialists, teams, relationships, and fences. Writes go through org-api (same schema as the CLI). Ctrl-C to stop.');
  if (!args.includes('--no-open')) {
    const { platform } = await import('node:os');
    const { spawn } = await import('node:child_process');
    const opener = platform() === 'darwin' ? 'open' : platform() === 'win32' ? 'start' : 'xdg-open';
    try { spawn(opener, [url], { stdio: 'ignore', detached: true }).unref(); } catch { /* headless: url already printed */ }
  }
  await new Promise(() => {});
}

// CLI/MCP/UI parity for participation rules (construct-pteo2.16): every
// subcommand is a thin envelope over the same lib/registry/org-api.mjs
// functions Org Studio's /api/participation endpoints call, so all three
// surfaces produce identical config writes and identical validation errors.

async function cmdParticipation(args = []) {
  const api = await import('../lib/registry/org-api.mjs');
  const sub = args.find((a) => !a.startsWith('--')) || 'list';
  const positionals = args.filter((a) => !a.startsWith('--')).slice(1);
  const wantsJson = args.includes('--json');
  const scopeArg = args.find((a) => a.startsWith('--scope='));
  const scope = scopeArg ? scopeArg.split('=')[1] : 'project';
  const rootDir = PROJECT_ROOT;

  const readRuleJson = async () => {
    const ruleArg = args.find((a) => a.startsWith('--rule='));
    const raw = ruleArg ? ruleArg.slice('--rule='.length) : await readStdin();
    if (!raw.trim()) { errorln('Provide the rule JSON via --rule=\'{...}\' or stdin.'); process.exit(1); }
    try { return JSON.parse(raw); } catch { errorln('Rule is not valid JSON.'); process.exit(1); }
  };
  const emitErrors = (result) => {
    for (const e of result.errors || []) errorln(`  ${e.id}: ${e.message}`);
    for (const w of result.warnings || []) warn(`  ${w.id}: ${w.message}`);
  };

  if (sub === 'list') {
    const result = api.listParticipationRules({ rootDir });
    if (wantsJson) { println(JSON.stringify(result, null, 2)); return; }
    if (!result.count) { info('No participation rules declared.'); return; }
    for (const it of result.items) {
      const cond = it.rule.when?.watchCondition || it.rule.when?.signalExpr || '?';
      const who = [...(it.rule.recruit?.specialists || []), ...(it.rule.recruit?.teams || []).map((t) => `team:${t}`)].join(',');
      println(`${it.rule.id}  [${it.scope}]  ${cond} → ${who}  ${it.rule.role}/${it.rule.gate}  on ${it.owner}`);
    }
    return;
  }

  if (sub === 'show') {
    const [owner, ruleId] = positionals;
    if (!owner || !ruleId) { errorln('Usage: construct participation show <owner> <ruleId> [--json]'); process.exit(1); }
    const row = api.listParticipationRules({ rootDir }).items.find((it) => it.owner === owner && it.rule.id === ruleId);
    if (!row) { errorln(`No rule "${ruleId}" on "${owner}".`); process.exit(1); }
    println(JSON.stringify(row, null, 2));
    return;
  }

  if (sub === 'add') {
    const [owner] = positionals;
    if (!owner) { errorln('Usage: construct participation add <owner> --rule=\'{...}\' [--scope=project|user] [--json]'); process.exit(1); }
    const rule = await readRuleJson();
    const result = api.upsertParticipationRule(owner, rule, { rootDir, scope });
    if (wantsJson) { println(JSON.stringify(result, null, 2)); }
    else if (result.ok) { ok(`Rule ${rule.id} written to ${result.path}`); emitErrors(result); }
    else { errorln(`Rule ${rule.id ?? ''} refused:`); emitErrors(result); }
    if (!result.ok) process.exit(1);
    return;
  }

  if (sub === 'validate') {
    const [owner] = positionals;
    if (!owner) { errorln('Usage: construct participation validate <owner> --rule=\'{...}\' [--json]'); process.exit(1); }
    const rule = await readRuleJson();
    const result = api.validateParticipationRule(owner, rule, { rootDir });
    if (wantsJson) { println(JSON.stringify(result, null, 2)); }
    else if (result.ok) { ok(`Rule ${rule.id ?? ''} is valid.`); emitErrors(result); }
    else { errorln(`Rule ${rule.id ?? ''} is invalid:`); emitErrors(result); }
    if (!result.ok) process.exit(1);
    return;
  }

  if (sub === 'remove') {
    const [owner, ruleId] = positionals;
    if (!owner || !ruleId) { errorln('Usage: construct participation remove <owner> <ruleId> [--scope=project|user] [--json]'); process.exit(1); }
    const result = api.removeParticipationRule(owner, ruleId, { rootDir, scope });
    if (wantsJson) { println(JSON.stringify(result, null, 2)); }
    else if (result.ok) { ok(`Rule ${ruleId} removed (${result.path}).`); }
    else { errorln(`Remove refused:`); emitErrors(result); }
    if (!result.ok) process.exit(1);
    return;
  }

  if (sub === 'preview') {
    const requestArg = args.find((a) => a.startsWith('--request='));
    if (!requestArg) { errorln('Usage: construct participation preview --request="..." [--json]'); process.exit(1); }
    const result = api.previewParticipation({ rootDir, request: requestArg.slice('--request='.length) });
    if (wantsJson) { println(JSON.stringify(result, null, 2)); return; }
    if (!result.recruited.length) { info('No condition-driven recruits for this request.'); return; }
    for (const p of result.recruited) {
      println(`${p.specialist || `team:${p.team}`}  ${p.role}/${p.gate}  via ${p.via}${p.rule ? ` (${p.rule})` : ''} — ${p.reason}`);
    }
    return;
  }

  if (sub === 'meta') {
    println(JSON.stringify(api.participationEditorMeta({ rootDir }), null, 2));
    return;
  }

  errorln(`Unknown subcommand "${sub}". Usage: construct participation list|show|add|validate|remove|preview|meta`);
  process.exit(1);
}

