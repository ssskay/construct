        errorln('Usage: construct scope archive <id> --reason="..." [--yes] [--dry-run]');
        process.exit(1);
      }
      const skipConfirm = args.includes('--yes') || args.includes('-y') || args.includes('--non-interactive');
      const dryRun = args.includes('--dry-run');
      const isTTY = process.stdin.isTTY && process.stdout.isTTY;

      const pathMod = await import('node:path');
      const fsMod = await import('node:fs');
      const target = loadScope(id);
      if (!target) {
        errorln(`Unknown scope: ${id}. Curated catalog: ${listScopes().join(', ')}`);
        process.exit(1);
      }
      const fileURL = await import('node:url');
      const moduleDir = pathMod.dirname(fileURL.fileURLToPath(import.meta.url));
      const repoRoot = pathMod.resolve(moduleDir, '..');
      const srcScope = pathMod.join(repoRoot, 'specialists', 'org', 'scopes', `${id}.json`);
      const tableRel = typeof target?.intake?.classificationTable === 'string' ? target.intake.classificationTable : null;
      const srcTable = tableRel ? pathMod.join(repoRoot, tableRel) : null;
      const dstDir = pathMod.join(repoRoot, 'archive', 'scopes', id);

      // Gather reason interactively if missing. The lifecycle module already
      // enforces a >= 8 char reason, but the operator should see why before
      // the call fails.
      if (!reason && isTTY && !skipConfirm) {
        const readline = await import('node:readline');
        const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
        reason = await new Promise((res) => rl.question('Archive reason (>= 8 chars): ', (a) => res(a.trim())));
        rl.close();
      }
      if (!reason || reason.trim().length < 8) {
        errorln('A substantive --reason (>= 8 chars) is required. Archiving is permanent in repo history; the reason becomes the archive note.');
        process.exit(1);
      }

      println('');
      println(`About to archive curated scope:`);
      println(`  id:           ${id}`);
      println(`  displayName:  ${target.displayName || id}`);
      println(`  reason:       ${reason}`);
      println('');
      println(`Files that will move:`);
      println(`  ${pathMod.relative(process.cwd(), srcScope)}`);
      println(`    -> ${pathMod.relative(process.cwd(), pathMod.join(dstDir, `${id}.json`))}`);
      if (srcTable && fsMod.existsSync(srcTable)) {
        println(`  ${pathMod.relative(process.cwd(), srcTable)}`);
        println(`    -> ${pathMod.relative(process.cwd(), pathMod.join(dstDir, pathMod.basename(srcTable)))}`);
      }
      println(`  ${pathMod.relative(process.cwd(), pathMod.join(dstDir, 'archive-note.md'))}  (new)`);
      println('');
      println(`What stays:`);
      println(`  Observations under .construct/observations/ are not touched.`);
      println(`  Outcomes under .construct/outcomes/ are not touched.`);
      println(`  Any project still configured with scope=${id} will fall back to rnd on next load.`);
      println('');

      if (dryRun) {
        println(`[dry-run] No files were moved.`);
        return;
      }
      if (!skipConfirm && isTTY) {
        const readline = await import('node:readline');
        const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
        const answer = await new Promise((res) => rl.question(`Archive ${id}? (y/N) `, (a) => res(a.trim().toLowerCase())));
        rl.close();
        if (answer !== 'y' && answer !== 'yes') {
          println('Aborted. Nothing was archived.');
          return;
        }
      }

      const { archiveScope } = await import('../lib/scopes/lifecycle.mjs');
      try {
        const { archived } = archiveScope({ id, reason });
        process.stdout.write(`✓ archived ${id} to ${pathMod.relative(process.cwd(), archived)}\n`);
        return;
      } catch (err) {
        errorln(err.message);
        process.exit(1);
      }
    }
    if (sub === 'health') {
      const id = args[1];
      if (!id) { errorln('Usage: construct scope health <id> [--days=N]'); process.exit(1); }
      const daysArg = args.find((a) => a.startsWith('--days='));
      const windowDays = daysArg ? Number(daysArg.split('=')[1]) || 30 : 30;
      const { scopeHealth } = await import('../lib/scopes/lifecycle.mjs');
      const report = scopeHealth(process.cwd(), id, { windowDays });
      process.stdout.write(JSON.stringify(report, null, 2) + '\n');
      return;
    }
    errorln(`Unknown scope subcommand: ${sub}. Available: list, show, set, create, drafts, archive, health`);
    process.exit(1);
  }],
]);

// Help flags → show usage
if (command === '--help' || command === '-h' || command === 'help') {
  usage();
  process.exit(0);
}

// --all / -a as a standalone flag — equivalent to `help --all`. Without
// this, `construct --all` (which the help footer advertises) 404s.
if (command === '--all' || command === '-a') {
  usage({ all: true });
  process.exit(0);
}

// Version flags → print version and exit
if (command === '--version' || command === '-V') {
  const pkg = JSON.parse(fs.readFileSync(path.join(ROOT_DIR, 'package.json'), 'utf8'));
  println(`construct v${pkg.version}`);
  process.exit(0);
}

// Bare invocation stays non-interactive. OpenCode is the first-class
// conversational surface; this CLI remains the setup/admin/headless substrate.
if (!command) {
  usage();
  process.exit(0);
}

if (command.startsWith('-')) {
  errorln(uiFail(`Unknown global flag: ${COLORS.bold}${command}${COLORS.reset}`, { colors: COLORS, glyphs: GLYPHS }));
  errorln(`${COLORS.dim}OpenCode is the primary conversation surface; run ${COLORS.reset}construct sync${COLORS.dim} to refresh adapters, or ${COLORS.reset}construct --help${COLORS.dim} for CLI commands.${COLORS.reset}`);
  process.exit(1);
}

// Unknown-flag guidance for commands that fully declare their flags (strictFlags
// in the spec). A stray or typo'd flag on these is a user error, not a no-op:
// reject it with the nearest declared flag and the command's help, matching how
// install (lib/setup.mjs KNOWN_FLAGS) already behaves, so no flag is silently
// swallowed. Opt-in keeps commands that accept undeclared flags unaffected.

function validateKnownFlags(name, argv) {
  const spec = CLI_COMMANDS.find((c) => c.name === name);
  if (!spec || !spec.strictFlags) return;

  const exact = new Set(['--help', '-h']);
  const prefixes = [];
  for (const opt of spec.options || []) {
    for (const part of String(opt.flag).split(',')) {
      const token = part.trim().split('=')[0].split(/\s/)[0];
      if (!token.startsWith('-')) continue;
      if (/-<[^>]+>$/.test(token)) prefixes.push(token.replace(/<[^>]+>$/, ''));
      else exact.add(token);
    }
  }

  const declared = [...exact].filter((f) => f.startsWith('--'));
  const dist = (a, b) => {
    const row = Array(b.length + 1).fill(0).map((_, i) => i);
    for (let i = 1; i <= a.length; i += 1) {
      let prev = i;
      for (let j = 1; j <= b.length; j += 1) {
        const cur = a[i - 1] === b[j - 1] ? row[j - 1] : 1 + Math.min(row[j - 1], row[j], prev);
        row[j - 1] = prev;
        prev = cur;
      }
      row[b.length] = prev;
    }
    return row[b.length];
  };

  const unknown = [];
  for (const tok of argv) {
    if (tok === '--') break;
    if (!/^--?[A-Za-z]/.test(tok)) continue;
    const bare = tok.split('=')[0];
    if (exact.has(bare) || prefixes.some((p) => bare.startsWith(p))) continue;
    unknown.push(bare);
  }
  if (unknown.length === 0) return;

  for (const flag of unknown) {
    errorln(`Unknown flag: ${flag}`);
    let best = 4;
    let suggestion = null;
    for (const cand of declared) {
      const d = dist(flag, cand);
      if (d < best) { best = d; suggestion = cand; }
    }
    if (suggestion) errorln(`Did you mean: ${suggestion}?`);
  }
  println('');
  println(`${COLORS.dim}Run 'construct ${name} --help' for valid options${COLORS.reset}`);
  process.exit(1);
}

const handler = handlers.get(command);
if (!handler) {
  if (command === 'chat') {
    errorln('Unknown command: chat');
    errorln(`${COLORS.dim}Construct's local conversation UI has been removed. Use OpenCode as the primary conversation surface after running ${COLORS.reset}construct sync${COLORS.dim}.${COLORS.reset}`);
    process.exit(1);
  }
  errorln(uiFail(`Unknown command: ${COLORS.bold}${command}${COLORS.reset}`, { colors: COLORS, glyphs: GLYPHS }));
  // Three-tier suggestion: prefix match → substring match → Levenshtein
  // distance ≤ 2. Catches single-letter typos, missing-letter typos, and
  // transpositions ('sycn' → 'sync') without dragging in a full fuzzy lib.
  const known = CLI_COMMANDS.filter((c) => !c.internal).map((c) => c.name);
  const editDistance = (a, b) => {
    if (a === b) return 0;
    if (!a.length || !b.length) return Math.max(a.length, b.length);
    const row = Array(b.length + 1).fill(0).map((_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let prev = i;
      for (let j = 1; j <= b.length; j++) {
        const cur = a[i - 1] === b[j - 1]
          ? row[j - 1]
          : 1 + Math.min(row[j - 1], row[j], prev);
        row[j - 1] = prev;
        prev = cur;
      }
      row[b.length] = prev;
    }
    return row[b.length];
  };
  let suggestion = known.find((n) => n.startsWith(command)) ||
                   known.find((n) => n.includes(command));
  if (!suggestion) {
    let bestDist = 3;
    for (const name of known) {
      const d = editDistance(command, name);
      if (d < bestDist) { bestDist = d; suggestion = name; }
    }
  }
  if (suggestion) errorln(`${COLORS.muted}Did you mean${COLORS.reset} ${COLORS.highlight}construct ${suggestion}${COLORS.reset}?`);
  println('');
  println(`${COLORS.dim}Run ${COLORS.reset}construct --help${COLORS.dim} for available commands${COLORS.reset}`);
  process.exit(1);
}

// Per-command --help / -h intercept. Critical safety: without this guard,
// commands like `dev`, `stop`, `init`, `uninstall` silently ignore --help
// and execute (running `construct stop --help` actually stops services).
// Every command — including internal ones — gets the same shape via
// formatCommandHelp(); per-command handlers need no opt-in.

if (rest.includes('--help') || rest.includes('-h')) {
  process.stdout.write(formatCommandHelp(command, { colors: true }));
  process.exit(0);
}

// Self-maintenance on version change. Skipped for high-frequency hook calls
// (the harness invokes `construct hook <name>` many times per session and
// must stay fast). When the installed version differs from the stamp at
// ~/.construct/.cleanup-stamp, we run a single bounded cleanup pass and
// update the stamp. Subsequent invocations are a single file read.
if (command !== 'hook') {
  try {
    const { maybeRunCleanupOnUpgrade, formatBytes } = await import('../lib/maintenance/cleanup.mjs');
    const pkg = JSON.parse(fs.readFileSync(path.join(ROOT_DIR, 'package.json'), 'utf8'));
    const result = maybeRunCleanupOnUpgrade({ homeDir: HOME, env: process.env, currentVersion: pkg.version });
    if (result.ran && result.summary?.freedBytes > 1024 * 1024) {
      const previous = result.previousVersion ? ` from v${result.previousVersion}` : '';
      process.stderr.write(`[construct] Maintenance after upgrade${previous} to v${pkg.version}: freed ${formatBytes(result.summary.freedBytes)}.\n`);
    }
  } catch (err) {
    // Maintenance must never block the actual command. Surface the failure
    // but continue. The next invocation will retry.
    process.stderr.write(`[construct] startup maintenance skipped: ${err.message}\n`);
  }
}

// First-invocation resource probe — skipped for hooks, setup, uninstall,
// doctor, and once BOOTSTRAP_CHECKED=1 is cached in ~/.construct/config.env.
// On TTY: if anything's missing, prints the status table and offers to run
// setup. Silent on success; never blocks the command.

const probe = await maybeFirstInvocationProbe({ command, homeDir: HOME, env: process.env });
if (probe?.runSetup) {
  await cmdInstall([]);
}

validateKnownFlags(command, rest);

await handler(rest);
