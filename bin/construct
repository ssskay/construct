async function cmdEvals(args) {
  const sub = args[0];

  if (sub === 'retrieval') {
    const jsonOutput = args.includes('--json');
    const fixtureArg = args.find((a) => a.startsWith('--fixture='));
    const defaultFixture = path.join(ROOT_DIR, 'tests', 'fixtures', 'retrieval-eval', 'queries.json');
    const fixturePath = fixtureArg ? fixtureArg.split('=')[1] : defaultFixture;

    const { evaluateFixture, formatReport } = await import('../lib/engine/eval-retrieval.mjs');
    const report = await evaluateFixture(fixturePath);

    try {
      const cacheDir = path.join(doctorRoot(), 'evals');
      fs.mkdirSync(cacheDir, { recursive: true });
      const ts = new Date().toISOString();
      fs.writeFileSync(
        path.join(cacheDir, 'retrieval-latest.json'),
        JSON.stringify({ ts, fixture: fixturePath, report }, null, 2),
      );
      const sum = report?.summary || report || {};
      const historyEntry = {
        ts,
        fixture: path.basename(fixturePath),
        recallAt5: sum.recallAt5 ?? sum.recall_at_5 ?? null,
        precisionAt5: sum.precisionAt5 ?? sum.precision_at_5 ?? null,
        mrr: sum.mrr ?? null,
        p50LatencyMs: sum.p50LatencyMs ?? sum.p50_latency_ms ?? null,
        p95LatencyMs: sum.p95LatencyMs ?? sum.p95_latency_ms ?? null,
      };
      fs.appendFileSync(path.join(cacheDir, 'retrieval-history.jsonl'), JSON.stringify(historyEntry) + '\n');
    } catch { /* cache write is best-effort */ }

    if (jsonOutput) {
      println(JSON.stringify(report, null, 2));
      return;
    }
    println(`Retrieval evaluation — ${path.relative(ROOT_DIR, fixturePath)}`);
    println('═══════════════════════════════════════════════════════');
    println(formatReport(report));
    return;
  }

  const jsonOutput = args.includes('--json');
  const catalog = {
    description: 'Evaluators are managed via telemetry quality scores. Use cx_score MCP tool or POST /api/public/scores to record quality scores. Run `construct evals retrieval` for the local IR-metric harness against a fixture corpus.',
    backendUrl: process.env.CONSTRUCT_TELEMETRY_BASEURL ?? 'http://localhost:3000',
    configured: Boolean(process.env.CONSTRUCT_TELEMETRY_PUBLIC_KEY && process.env.CONSTRUCT_TELEMETRY_SECRET_KEY),
  };
  if (jsonOutput) {
    println(JSON.stringify(catalog, null, 2));
    return;
  }
  println('Evaluator Catalog');
  println('═════════════════');
  println('');
  println(`Backend:     Telemetry (${catalog.backendUrl})`);
  println(`Configured:  ${catalog.configured ? 'yes' : 'no — set CONSTRUCT_TELEMETRY_PUBLIC_KEY and CONSTRUCT_TELEMETRY_SECRET_KEY'}`);
  println('');
  println('Quality scores are recorded by agents via the cx_score MCP tool.');
  println('View and manage scores at your telemetry dashboard.');
  println('');
  println('Local retrieval evaluation:');
  println('  construct evals retrieval [--fixture=PATH] [--json]');
}

async function cmdDocsReconcile(args) {
  const { existsSync, readdirSync, readFileSync, mkdirSync, writeFileSync } = await import('node:fs');
  const { join, relative } = await import('node:path');
  const scopeArg = args.find((a) => a.startsWith('--scope='))?.replace('--scope=', '');
  const scopes = scopeArg ? scopeArg.split(',') : ['docs/prd', 'docs/adr', 'docs/rfc'];

  const cwd = process.cwd();
  const now = new Date().toISOString().slice(0, 10);
  const driftDir = configPath(cwd, 'doc-drift', now);
  mkdirSync(driftDir, { recursive: true });

  const candidates = [];
  for (const scope of scopes) {
    const dir = join(cwd, scope);
    if (!existsSync(dir)) continue;
    const walk = (d) => {
      try {
        for (const f of readdirSync(d, { withFileTypes: true })) {
          if (f.isDirectory()) walk(join(d, f.name));
          else if (f.name.endsWith('.md') || f.name.endsWith('.mdx')) {
            candidates.push(join(d, f.name));
          }
        }
      } catch { /* skip */ }
    };
    walk(dir);
  }

  if (candidates.length === 0) {
    println(`No documents found in scopes: ${scopes.join(', ')}`);
    return;
  }

  println(`Reconciling ${candidates.length} document(s) across ${scopes.join(', ')}…\n`);
  println('This performs a structural drift check (frontmatter, section headings, cross-refs).');
  println('Full AI-assisted reconciliation requires a specialist dispatch via the MCP worker_run tool.\n');

  const reports = [];
  const STALE_DAYS = 30;
  const now_ms = Date.now();

  for (const p of candidates) {
    let text = '';
    try { text = readFileSync(p, 'utf8'); } catch { continue; }

    // Extract last_verified_at from frontmatter.
    const fmMatch = text.match(/^---\n([\s\S]*?)\n---/);
    let lastVerified = null;
    if (fmMatch) {
      const lvaMatch = fmMatch[1].match(/last_verified_at:\s*(.+)/);
      if (lvaMatch) lastVerified = lvaMatch[1].trim();
    }

    const ageDays = lastVerified
      ? Math.floor((now_ms - new Date(lastVerified).getTime()) / 86400000)
      : null;

    const verdict = lastVerified === null ? 'unverified'
      : ageDays > STALE_DAYS ? 'stale'
      : 'current';

    const rel = relative(cwd, p);
    reports.push({ path: rel, verdict, lastVerified, ageDays });

    const reportPath = join(driftDir, rel.replace(/[/\\]/g, '-') + '.md');
    mkdirSync(driftDir, { recursive: true });
    writeFileSync(reportPath, [
      `# Drift report: ${rel}`,
      '',
      `**Verdict:** ${verdict}`,
      `**Last verified:** ${lastVerified || '(none)'}`,
      `**Age (days):** ${ageDays ?? '—'}`,
      '',
      '## Notes',
      '',
      verdict === 'stale'
        ? `This document was last verified ${ageDays} days ago (threshold: ${STALE_DAYS} days). Review against current implementation.`
        : verdict === 'unverified'
        ? 'This document has no last_verified_at frontmatter field. Add one after reviewing.'
        : 'This document appears current.',
    ].join('\n'));
  }

  // Write summary.
  const stale = reports.filter((r) => r.verdict === 'stale');
  const unverified = reports.filter((r) => r.verdict === 'unverified');
  const current = reports.filter((r) => r.verdict === 'current');

  const summaryPath = join(driftDir, 'summary.md');
  writeFileSync(summaryPath, [
    `# Doc drift summary — ${now}`,
    '',
    `Scopes: ${scopes.join(', ')}`,
    `Total: ${reports.length}  |  Current: ${current.length}  |  Stale: ${stale.length}  |  Unverified: ${unverified.length}`,
    '',
    stale.length ? `## Stale (>${STALE_DAYS} days)\n${stale.map((r) => `- ${r.path} (${r.ageDays}d)`).join('\n')}` : '',
    unverified.length ? `\n## Unverified\n${unverified.map((r) => `- ${r.path}`).join('\n')}` : '',
  ].filter(Boolean).join('\n'));

  println(`Results:`);
  println(`  current:    ${current.length}`);
  println(`  stale:      ${stale.length}`);
  println(`  unverified: ${unverified.length}`);
  println(`\nDrift reports written to: .construct/doc-drift/${now}/`);
  println(`Summary: .construct/doc-drift/${now}/summary.md`);
}

async function cmdDocsUpdate(args) {
  const check = args.includes('--check');
  const { regenerateDocs: regen } = await import('../lib/auto-docs.mjs');
  const { changed, checked } = await regen({ rootDir: ROOT_DIR, check });
  if (checked) {
    if (changed.length) {
      errorln(`  ✗  Docs are out of date. Run 'construct docs:update' to regenerate:`);
      for (const f of changed) errorln(`     ${path.relative(ROOT_DIR, f)}`);
      process.exit(1);
    } else {
      ok('Docs are up to date.');
    }
  } else {
    if (changed.length) {
      for (const f of changed) ok(`Updated ${path.relative(ROOT_DIR, f)}`);
    } else {
      ok('Docs already up to date — nothing changed.');
    }
  }
}

async function cmdDocsCheck(args) {
  const jsonOutput = args.includes('--json');
  const { checkDocsCoverage } = await import('../lib/auto-docs.mjs');
  const result = checkDocsCoverage({ rootDir: ROOT_DIR });
  if (jsonOutput) {
    println(JSON.stringify(result, null, 2));
    return;
  }
  println(`Doc coverage: ${result.covered.length}/${result.total} commands have a how-to guide`);
  if (result.uncovered.length === 0) {
    ok('All user-facing commands are covered by a how-to guide.');
  } else {
    println('');
    println('Commands with no linked how-to in docs/README.md:');
    for (const name of result.uncovered) println(`  ✗  construct ${name}`);
    println('');
    println(`Add cookbook recipes under docs/guides/cookbook/ and link them from the cookbook index.`);
    process.exitCode = 1;
  }
}

async function cmdDocsSite(args = []) {
  const check = args.includes('--check');
  const { buildFumadocsReference, checkFumadocsReferenceDrift } = await import('../lib/auto-docs.mjs');
  if (check) {
    const { drift } = checkFumadocsReferenceDrift({ rootDir: ROOT_DIR });
    if (drift.length === 0) {
      ok('docs/guides/reference/ is up to date.');
      return;
    }
    println('');
    println('Generated reference docs are out of date. Run `construct docs:site` to regenerate:');
    for (const f of drift) println(`  ✗  ${f}`);
    process.exitCode = 1;
    return;
  }
  const { written } = buildFumadocsReference({ rootDir: ROOT_DIR });
  if (written.length === 0) {
    ok('docs/guides/reference/ already up to date.');
  } else {
    ok(`docs/guides/reference/ regenerated (${written.length} file${written.length === 1 ? '' : 's'}).`);
  }
}

