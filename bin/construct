async function cmdStatus() {
  const jsonOutput = restArgsCache.includes('--json');
  const status = await buildStatus({ rootDir: ROOT_DIR, cwd: process.cwd(), homeDir: HOME, env: process.env });

  if (jsonOutput) {
    println(JSON.stringify(status, null, 2));
    return;
  }

  println(formatStatusReport(status));

  // Append the learning-loops summary so the operator gets a single answer
  // to "is this thing actually learning?" without remembering a second
  // command. Cheap: just reads .construct/observations + .construct/outcomes summaries.
  try {
    const { resolveActiveScope } = await import('../lib/scopes/loader.mjs');
    const { readSummary } = await import('../lib/outcomes/aggregate.mjs');
    const fs = await import('node:fs');
    const cwd = process.cwd();
    const active = resolveActiveScope(cwd);
    const obsIdxPath = configPath(cwd, 'observations', 'index.json');
    let obsTotal = 0;
    let obs24h = 0;
    if (fs.existsSync(obsIdxPath)) {
      const idx = JSON.parse(fs.readFileSync(obsIdxPath, 'utf8'));
      obsTotal = idx.length;
      const since = Date.now() - 24 * 60 * 60 * 1000;
      obs24h = idx.filter((e) => Date.parse(e.createdAt) >= since).length;
    }
    const researchDir = configPath(cwd, 'knowledge', 'external', 'research');
    const researchCount = fs.existsSync(researchDir)
      ? fs.readdirSync(researchDir).filter((f) => f.endsWith('.md')).length
      : 0;
    const summary = readSummary(cwd);
    const outcomeRoles = summary?.roles ? Object.keys(summary.roles).length : 0;

    println('');
    println('Learning loops');
    println('──────────────');
    println(`  Profile          ${active.id} (${active.displayName || ''})`);
    println(`  Observations     ${obsTotal} total, ${obs24h} in last 24h`);
    println(`  Research files   ${researchCount}`);
    println(`  Outcome roles    ${outcomeRoles}`);
    println(`  Detail:          npm run learning:status`);
  } catch { /* best-effort surface; never block status */ }
}

async function cmdWorkers(args = []) {
  const sub = args.find((a) => !a.startsWith('--')) || 'list';
  const wantsJson = args.includes('--json');
  if (sub !== 'list') {
    errorln('Usage: construct workers <list> [--json]');
    process.exit(1);
  }

  const { createSqlClient, closeSqlClient } = await import('../lib/storage/backend.mjs');
  const { WorkerRegistry } = await import('../lib/orchestration/worker-runtime.mjs');
  const { resolveIntakeTenantId, INTAKE_PROJECT_ENV_KEY } = await import('../lib/intake/queue.mjs');
  const sql = createSqlClient(process.env);
  const project = process.env[INTAKE_PROJECT_ENV_KEY] || path.basename(path.resolve(process.cwd())) || 'construct';
  const tenantId = resolveIntakeTenantId(process.env);

  if (!sql) {
    const payload = { status: 'unavailable', reason: 'postgres-unavailable', workers: [] };
    if (wantsJson) { println(JSON.stringify(payload, null, 2)); return; }
    println('Workers unavailable: DATABASE_URL or CONSTRUCT_DATABASE_URL is not configured.');
    return;
  }

  try {
    const registry = new WorkerRegistry({ sql, project, tenantId });
    const workers = await registry.list();
    const payload = { status: 'available', project, tenantId, workers };
    if (wantsJson) { println(JSON.stringify(payload, null, 2)); return; }
    if (!workers.length) {
      println(`No workers registered for ${project}/${tenantId}.`);
      return;
    }
    for (const worker of workers) {
      println(`${worker.workerId}  ${worker.status}  heartbeat=${worker.heartbeatAt || 'never'}  ttl=${worker.ttlSeconds}s`);
    }
  } finally {
    await closeSqlClient(sql);
  }
}

async function cmdSync(args) {
  const { startOpLog } = await import('../lib/op-log.mjs');
  const opLog = startOpLog('sync', { homeDir: HOME });
  opLog.event('args', { args });

  generateCompletions();
  const syncStatus = runNodeScript(path.join(ROOT_DIR, 'scripts', 'sync-specialists.mjs'), args, {}, { exitOnError: false });
  if (syncStatus !== 0) {
    opLog.close('failed', { stage: 'sync-specialists', status: syncStatus });
    process.exit(syncStatus);
  }

  // State reconciliation (ADR-0027): bring on-disk state in line with the
  // current disposition contract. Auto-safety tasks run silently; ask-safety
  // tasks surface via construct doctor instead. --reconcile=<id> runs one task
  // on explicit consent (the path for ask-safety tasks). --no-reconcile
  // bypasses the auto pass entirely for diagnostic runs.

  const reconcileArg = args.find((a) => a.startsWith('--reconcile='));
  if (reconcileArg) {
    const id = reconcileArg.slice('--reconcile='.length);
    try {
      const { runReconciliation } = await import('../lib/reconcile/index.mjs');
      const result = await runReconciliation(id, {});
      if (!result.ok) {
        errorln(`Reconciliation failed (${id}): ${result.reason}`);
        if (result.available) errorln(`Available: ${result.available.join(', ')}`);
        opLog.close('failed', { stage: 'reconcile', id, reason: result.reason });
        process.exit(1);
      }
      if (result.ran) ok(`Reconciled (${id}): ${result.summary}`);
      else println(`Reconciliation (${id}): ${result.summary}`);
      opLog.event('reconcile-explicit', { id, ran: !!result.ran });
    } catch (err) {
      errorln(`Reconciliation error (${id}): ${err.message}`);
      opLog.close('failed', { stage: 'reconcile', id, reason: err.message });
      process.exit(1);
    }
  } else if (!args.includes('--no-reconcile')) {
    try {
      const verbose = args.includes('--verbose') || args.includes('-v');
      const { runAutoReconciliations } = await import('../lib/reconcile/index.mjs');
      const { applied } = await runAutoReconciliations({ verbose });
      for (const entry of applied) ok(`Reconciled (${entry.id}): ${entry.summary}`);
      opLog.event('reconcile', { applied: applied.length });
    } catch (err) {
      opLog.event('reconcile-error', { message: err.message });
    }
  }

  // Advisory only: workflow-defs.mjs (LMCP-D2) can only drift from the
  // manifests via a source regression, which release:check's --check run
  // treats as a hard failure. Sync surfaces it early without blocking.

  try {
    const driftStatus = runNodeScript(path.join(ROOT_DIR, 'scripts', 'check-workflow-defs-drift.mjs'), ['--check'], {}, { exitOnError: false });
    if (driftStatus !== 0) {
      errorln('workflow-defs.mjs drift detected — run: npm run workflow-defs:check');
    }
    opLog.event('workflow-defs-check', { status: driftStatus });
  } catch (err) {
    opLog.event('workflow-defs-check-error', { message: err.message });
  }

  if (args.includes('--no-docs')) {
    opLog.close('ok', { docs: 'skipped' });
    return;
  }
  const { regenerateDocs } = await import('../lib/auto-docs.mjs');
  const { changed } = await regenerateDocs({ rootDir: ROOT_DIR });
  for (const f of changed) ok(`Updated ${path.relative(ROOT_DIR, f)}`);
  opLog.close('ok', { docsChanged: changed.length });
}

async function cmdCompletions(args) {
  const sub = args[0] ?? 'install';
  if (sub === 'bash' || sub === 'zsh') {
    println(getCompletionScript(sub));
    return;
  }
  if (sub === 'install') {
    const outDir = generateCompletions();
    if (!outDir) process.exit(1);
    println(`Completions written to ${outDir}`);
    println('');
    println('Enable them in your shell:');
    println(`  bash: source ${path.join(outDir, 'construct.bash')}`);
    println(`  zsh:  fpath=(${outDir} $fpath) && autoload -Uz compinit && compinit`);
    return;
  }
  errorln('Usage: construct completions [bash|zsh|install]');
  process.exit(1);
}

async function cmdList() {
  const registry = loadRegistry({ rootDir: ROOT_DIR });
  println('Construct Agents\n');
  println('Specialists:');
  const specialists = Object.values(registry.specialists ?? {});
  for (const specialist of specialists) {
    const id = specialist.name.startsWith('cx-') ? specialist.name : `cx-${specialist.name}`;
    println(`  ${id} ${specialist.displayName || ''}`);
  }
}

async function cmdDoctor() {
  const args = process.argv.slice(3);

  const DAEMON_SUBS = new Set(['status', 'watch', 'stop', 'logs', 'tick', 'report', 'consistency']);
  if (args.length > 0 && DAEMON_SUBS.has(args[0])) {
    const { runCli } = await import('../lib/doctor/cli.mjs');
    const code = await runCli(args);
    if (code) process.exit(code);
    return;
  }

  if (args[0] === 'credentials' || (args.length && args.some(a => a.startsWith('cred')))) {
    println(`${COLORS.bold}Credential diagnostics${COLORS.reset}`);
    println('');

    const { homedir } = await import('node:os');
    const { join } = await import('node:path');
    const fs = await import('node:fs');

    const vars = [
      'OPENROUTER_API_KEY',
      'ANTHROPIC_API_KEY',
      'GITHUB_TOKEN',
      'OPENAI_API_KEY',
      'OPENCODE_API_KEY',
      'JIRA_API_TOKEN',
      'CONFLUENCE_API_TOKEN',
      'SLACK_BOT_TOKEN',
    ];

    for (const varName of vars) {
      const sources = [];

      // process.env
      if (process.env[varName]) {
        sources.push('process.env (set)');
      }

      // .env files
      for (const envPath of [join(process.cwd(), '.env'), join(homedir(), '.env'), getUserEnvPath(homedir())]) {
        if (fs.existsSync(envPath)) {
          try {
            const content = fs.readFileSync(envPath, 'utf8');
            const m = content.match(new RegExp(`^${varName}=["']?(.+?)["']?$`, 'm'));
            if (m) sources.push(`${envPath.replace(homedir(), '~')} (found)`);
          } catch {}
        }
      }

      // Shell rc files
      const shellFiles = [join(homedir(), '.zshrc'), join(homedir(), '.bashrc'), join(homedir(), '.bash_profile'), join(homedir(), '.profile')];
      for (const rcPath of shellFiles) {
        if (!fs.existsSync(rcPath)) continue;
        try {
          const content = fs.readFileSync(rcPath, 'utf8');
          const opRe = new RegExp(`export\\s+${varName}=["']?\\$\\(op read '([^']+)'\\)["']?`, 'm');
          const opMatch = content.match(opRe);
          if (opMatch) {
            sources.push(`${rcPath.replace(homedir(), '~')} → op:// reference (run \`op read\` to verify)`);
          }
          // Check for direct export (allow leading whitespace for indented rc files)
          const directRe = new RegExp(`^\\s*export\\s+${varName}=(.+)$`, 'm');
          const directMatch = content.match(directRe);
          if (directMatch) {
            sources.push(`${rcPath.replace(homedir(), '~')} (export found)`);
          }
        } catch {}
      }

      const pip = sources.length > 0 ? COLORS.green + '✓' : COLORS.yellow + '○';
      println(`  ${pip}${COLORS.reset} ${COLORS.bold}${varName}${COLORS.reset}`);
      if (sources.length) {
        for (const s of sources.slice(0, 3)) {
          println(`       ${s}`);
        }
        if (sources.length > 3) println(`       … +${sources.length - 3} more`);
      } else {
        println(`       not found in env, .env, config.env, or shell rc files`);
      }
    }

    println('');
    println('Fix tips:');
    println('  - If op read fails with "does not have a field": the field name in .zshrc');
    println('    doesn\'t match the 1Password item. Run `op item get <item> --vault <vault>`');
    println('    to see the correct field name, then update your .zshrc.');
    println('  - If op read fails with "not signed in": run `op signin` or enable the');
    println('    1Password desktop app CLI integration (Settings → Developer).');
    println('  - Set env vars directly in ~/.construct/config.env to bypass shell rc.');
    return;
  }

  if (args.includes('--bootstrap')) {
    const { registerBuiltInResources } = await import('../lib/bootstrap/built-ins.mjs');
    const { probeAll, formatProbe } = await import('../lib/bootstrap/resources.mjs');
    registerBuiltInResources();
    const probes = await probeAll();
    println('Bootstrap resource probe');
    println('═══════════════════════');
    for (const probe of probes) println(formatProbe(probe));
    const missingRequired = probes.filter((p) => p.required && !p.present);
    const missingOptional = probes.filter((p) => !p.required && !p.present);
    println('');
    if (missingRequired.length) {
      errorln(`${missingRequired.length} required resource(s) missing — install them before continuing.`);
      process.exit(1);
    }
    if (missingOptional.length) {
      println(`${missingOptional.length} optional resource(s) absent — Construct runs in degraded mode.`);
      println('Run `construct setup` to install on consent.');
    } else {
      ok('All resources present.');
    }
    return;
  }

  // --fix-* flags drive auto-remediation for legacy state left behind by
  // pre-2.0 installs. Layer-2 update triggers (npm i -g postinstall, brew
  // upgrade) normally handle this; --fix-* is the manual recovery path.
  // --fix-all runs every available fix.

  const wantsFixAll = args.includes('--fix-all') || args.includes('--fix');
  const wantsFixGitignore = wantsFixAll || args.includes('--fix-gitignore');
  const wantsFixLegacyAgents = wantsFixAll || args.includes('--fix-legacy-agents');
  const wantsFixEmbedLog = wantsFixAll || args.includes('--fix-embed-log');
  const wantsFixMigrateState = wantsFixAll || args.includes('--fix-migrate-state');

  const checks = [];
  // Set inside the worker-backend/web-capability readiness check below;
  // printed as the last line of doctor's output regardless of pass/fail so a
  // scrolled-past health-check table never buries the EXECUTE-vs-PLAN signal.
  let firstRunReadinessLine = null;
  const { DOCTOR_STATES } = await import('../lib/doctor/diagnosis.mjs');
  const add = (label, pass, optional = false, failureState = pass ? DOCTOR_STATES.healthy : null) => checks.push({ label, pass, optional, failureState });
  const { isConstructSourceCheckout } = await import('../lib/doctor/source-checkout.mjs');
  const isSourceCheckout = isConstructSourceCheckout(ROOT_DIR);
  add('specialists/org exists', fs.existsSync(path.join(ROOT_DIR, 'specialists', 'org')));
  add('sync-specialists.mjs exists', fs.existsSync(path.join(ROOT_DIR, 'scripts', 'sync-specialists.mjs')));

  // Extension manifests check
  try {
    const extManifestsDir = path.join(ROOT_DIR, 'lib', 'extensions', 'manifests');
    const extManifestFiles = fs.existsSync(extManifestsDir)
      ? fs.readdirSync(extManifestsDir).filter((f) => f.endsWith('.manifest.json'))
      : [];
    add(`Extension manifests: ${extManifestFiles.length} loaded`, extManifestFiles.length > 0);
  } catch {
    add('Extension manifests: check failed', false);
  }

  // Project .gitignore must cover .construct/. Auto-fix via --fix-gitignore.
  // Only checks when cwd looks like a Construct project (has .construct/);
  // non-project cwds get no warning.

  const cwd = process.cwd();
  const isProject = PROJECT_MARKERS.some((m) => fs.existsSync(path.join(cwd, m)));
  if (isProject) {
    const giPath = path.join(cwd, '.gitignore');
    const giContent = fs.existsSync(giPath) ? fs.readFileSync(giPath, 'utf8') : '';
    const lines = giContent.split('\n').map((l) => l.trim());
    const cxIgnored = lines.some((l) => l === CONFIG_DIR_NAME || l === `${CONFIG_DIR_NAME}/` || l === `${CONFIG_DIR_NAME}/**` || l === '*' || l === '**');
    if (!cxIgnored && wantsFixGitignore) {
      const prefix = giContent.length === 0 || giContent.endsWith('\n') ? '' : '\n';
      fs.writeFileSync(giPath, giContent + `${prefix}\n# Construct runtime state — local-only, never source\n${CONFIG_DIR_NAME}/\n`, 'utf8');
      println(`  fix: appended ${CONFIG_DIR_NAME}/ to ${path.relative(cwd, giPath)}`);
      add(`Project .gitignore covers ${CONFIG_DIR_NAME}/`, true);
    } else {
      add(`Project .gitignore covers ${CONFIG_DIR_NAME}/` + (cxIgnored ? '' : ' (run `construct doctor --fix-gitignore` to add)'), cxIgnored);
    }
  }

  // Legacy cx-* files at user scope. Layer-2 (npm postinstall, brew
  // upgrade) sweeps these via `construct sync --global`; this check is
  // the manual safety net. Counts files matching a registered specialist
  // name across Claude / Codex / Copilot user-scope dirs.

  const userHome = HOME;
  const registry = loadRegistry({ rootDir: ROOT_DIR });
  const specialistSet = new Set(Object.values(registry.specialists ?? {}).map((s) => `cx-${s.name}`));
  const legacyTargets = [
    { dir: path.join(userHome, '.claude', 'agents'), ext: '.md' },
    { dir: path.join(userHome, '.codex', 'agents'), ext: '.toml' },
    { dir: path.join(userHome, '.github', 'prompts'), ext: '.prompt.md' },
  ];
  let legacyCount = 0;
  for (const t of legacyTargets) {
    if (!fs.existsSync(t.dir)) continue;
    for (const f of fs.readdirSync(t.dir)) {
      if (!f.endsWith(t.ext)) continue;
      const base = f.slice(0, -t.ext.length);
      if (specialistSet.has(base)) legacyCount++;
    }
  }
  if (legacyCount > 0 && wantsFixLegacyAgents) {
    const syncScript = path.join(ROOT_DIR, 'scripts', 'sync-specialists.mjs');
    const result = spawnSync(process.execPath, [syncScript, '--global'], { stdio: 'pipe', encoding: 'utf8' });
    if (result.status === 0) {
      println(`  fix: swept ${legacyCount} legacy cx-* file(s) from user scope via construct sync --global`);
      add('No legacy cx-* files at user scope', true);
    } else {
      add(`Legacy cx-* sweep failed: ${result.stderr?.substring(0, 200)}`, false);
    }
  } else {
    // Soft-warn instead of hard-fail: legacy v1.0.10 cx-* files are an
    // expected upgrade-state, not real drift. The hint is what matters;
    // the fix is one --fix-legacy-agents run away and CI never sees this.
    // Mirrors the parity check's legacy-install reclassification.

    add(
      legacyCount === 0
        ? 'No legacy cx-* files at user scope'
        : `Legacy cx-* files at user scope: ${legacyCount} (run \`construct doctor --fix-legacy-agents\` to sweep)`,
      true,
      legacyCount !== 0,
    );
  }

  // (Pre-push bypass doctor check removed in v1.0.16.) v1.0.15 deleted the
  // entire skip-var infrastructure (CONSTRUCT_SKIP_PREPUSH, _COMMENT_LINT,
  // _PR_LINT, _DOCS, CONSTRUCT_ALLOW_CLAUDE_PUSH). Nothing writes to
  // ~/.construct/audit/prepush-bypass.log, so any entries there are stale
  // and would otherwise surface the warning indefinitely. The file itself
  // is harmless — next cleanup tick may sweep it.

  // Embed daemon log size. The daemon's own scheduler rotates every
  // minute at 50MB, but a freshly-upgraded install with a 34GB legacy
  // log shouldn't wait 60s. --fix-embed-log forces rotation now.

  const embedLogPath = path.join(doctorRoot(userHome), 'runtime', 'embed-daemon.log');
  if (fs.existsSync(embedLogPath)) {
    const sizeMb = fs.statSync(embedLogPath).size / 1024 / 1024;
    const FORCE_THRESHOLD_MB = Number(process.env.CONSTRUCT_DOCTOR_EMBED_LOG_FORCE_MB) || 500;
    if (sizeMb > FORCE_THRESHOLD_MB && wantsFixEmbedLog) {
      const { rotateIfOversized } = await import('../lib/logging/rotate.mjs');
      println(`  fix: rotating ${sizeMb.toFixed(0)}MB embed-daemon.log (gzipping may take a moment)…`);
      const start = Date.now();
      const seg = await rotateIfOversized(embedLogPath, { maxBytes: 1, maxSegments: 5, gzip: true });
      const elapsed = ((Date.now() - start) / 1000).toFixed(0);
      println(`  fix: rotated to ${path.basename(seg)} in ${elapsed}s`);
      add('Embed daemon log size sane', true);
    } else {
      const label = sizeMb > FORCE_THRESHOLD_MB
        ? `Embed daemon log oversized: ${sizeMb.toFixed(0)}MB (run \`construct doctor --fix-embed-log\` to rotate now)`
        : `Embed daemon log size: ${sizeMb.toFixed(1)}MB`;
      add(label, sizeMb <= FORCE_THRESHOLD_MB);
    }
  }

  // Legacy ~/.cx/<project-scoped>.jsonl files left over from before the
  // cross-project state isolation refactor. Four files moved from user
  // scope to <project>/.cx/: contract-violations, audit-reads, agent-log,
  // intent-verifications. Pre-refactor data still sits at ~/.cx/ where it
  // mixed every project together. --fix-migrate-state archives them to
  // ~/.cx/legacy/<name>.<ts>.jsonl so the new writers start fresh; the
  // legacy data stays readable for forensics.

  const projectScopedNames = [
    'contract-violations.jsonl',
    'audit-reads.jsonl',
    'agent-log.jsonl',
    'intent-verifications.jsonl',
  ];
  const legacyState = projectScopedNames
    .map((name) => ({ name, path: path.join(doctorRoot(userHome), name) }))
    .filter((p) => fs.existsSync(p.path) && fs.statSync(p.path).size > 0);

  if (legacyState.length > 0 && wantsFixMigrateState) {
    const archiveDir = path.join(doctorRoot(userHome), 'legacy');
    fs.mkdirSync(archiveDir, { recursive: true });
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    const moved = [];
    for (const { name, path: src } of legacyState) {
      const dest = path.join(archiveDir, `${name.replace('.jsonl', '')}.${ts}.jsonl`);
      fs.renameSync(src, dest);
      moved.push(path.basename(dest));
    }
    println(`  fix: archived ${moved.length} legacy user-scope file(s) to ~/.cx/legacy/`);
    for (const m of moved) println(`         → ${m}`);
    add('No legacy user-scope project-state files', true);
  } else {
    add(
      legacyState.length === 0
        ? 'No legacy user-scope project-state files'
        : `Legacy user-scope project-state files: ${legacyState.length} (run \`construct doctor --fix-migrate-state\` to archive)`,
      legacyState.length === 0,
    );
  }

  // Legacy in-project heavy state (ADR-0066): runtime/traces/lancedb now
  // resolve through the machine-scoped state root, so a project that still
  // carries these directories is holding pre-refit state at the old
  // project-local path. No auto-fix — the ADR calls for manual deletion, not
  // a migration shim, since the durable copy already lives at the state root.

  if (isProject) {
    const legacyHeavyDirs = [
      { rel: path.join(CONFIG_DIR_NAME, 'runtime'), label: `${CONFIG_DIR_NAME}/runtime` },
      { rel: path.join(CONFIG_DIR_NAME, 'traces'), label: `${CONFIG_DIR_NAME}/traces` },
      { rel: path.join(CONFIG_DIR_NAME, 'lancedb'), label: `${CONFIG_DIR_NAME}/lancedb` },
    ]
      .map((d) => ({ ...d, full: path.join(cwd, d.rel) }))
      .filter((d) => fs.existsSync(d.full) && fs.readdirSync(d.full).length > 0);

    add(
      legacyHeavyDirs.length === 0
        ? 'No legacy in-project heavy state (runtime/traces/lancedb)'
        : `Legacy in-project heavy state found: ${legacyHeavyDirs.map((d) => d.label).join(', ')} — `
          + 'durable state now lives at ~/.construct/projects/<key>/ (ADR-0066); delete the old directories manually to reclaim disk',
      true,
      legacyHeavyDirs.length !== 0,
    );
  }

  // Mirror model tier overrides stranded in the pre-XDG legacy config forward
  // before resolving tiers, so an install upgraded across the XDG move reports
  // configured without a manual copy. Applied to process.env too so the check
  // below sees the just-migrated values in the same run.
  try {
    const { migrateLegacyModelConfig, migrateLegacyCredentialConfig } = await import('../lib/config/legacy-config-migration.mjs');
    const migration = migrateLegacyModelConfig({ homeDir: HOME });
    if (migration.performed) {
      Object.assign(process.env, migration.migrated);
      println(`  fix: migrated ${Object.keys(migration.migrated).join(', ')} from ${migration.legacyPath} → ${migration.xdgPath}`);
    }
    const credentialMigration = migrateLegacyCredentialConfig({ homeDir: HOME });
    if (credentialMigration.performed) {
      Object.assign(process.env, credentialMigration.migrated);
      println(`  fix: migrated credentials ${Object.keys(credentialMigration.migrated).join(', ')} from ${credentialMigration.legacyPath} → ${credentialMigration.xdgPath}`);
    }
  } catch (err) {
    add(`Models — legacy config migration failed: ${err.message}`, false, true);
  }

  // Tier model selection. Construct ships with no default — at least
  // one tier must be configured (registry.json primary OR CX_MODEL_*
  // env override) before any LLM-backed workflow can run.
  // A missing, partial, or unresolvable tier is advisory, not a repo defect:
  // model tiers are user/machine-specific config, so doctor warns and never
  // fails the gate on them.
  try {
    const { resolveModelTiers } = await import('../lib/model-registry.mjs');
    const resolved = resolveModelTiers({ env: process.env });
    if (resolved.complete) {
      add('Models — all tiers configured', true);
    } else if (resolved.configured === 0) {
      add('Models — no tier configured (run `construct models --apply`)', false, true);
    } else {
      const missing = Object.entries(resolved.models)
        .filter(([, v]) => !v)
        .map(([k]) => k);
      add(`Models — only ${resolved.configured}/3 tiers configured (missing: ${missing.join(', ')})`, false, true);
    }
  } catch (err) {
    add(`Models — check failed: ${err.message}`, false, true);
  }

  // Worker-backend and web-capability visibility (construct-1yhp.2,
  // construct-1yhp.8): reuse buildOrchestrationReadiness — the same
  // resolution orchestration_run itself calls — so doctor can never
  // advertise a backend/web mode that diverges from what a run would
  // actually get. Both lines are advisory only; the resolved values never
  // fail the gate.
  try {
    const { buildOrchestrationReadiness, formatFirstRunExecutionReadiness } = await import('../lib/orchestration/readiness.mjs');
    const orchReadiness = buildOrchestrationReadiness({}, { env: process.env, cwd });
    const backendNote = orchReadiness.workerBackend === 'inline'
      ? 'inline (prepare-only — no specialist LLM reasoning runs; set orchestration.workerBackend=provider for real execution)'
      : orchReadiness.workerBackend;
    add(`Worker backend: ${backendNote}`, true, true);

    const webNote = orchReadiness.webMode === 'unavailable'
      ? 'unavailable (set WEB_SEARCH_URL for governed mode, or CONSTRUCT_ORCHESTRATION_WEB_DELEGATE=1 to delegate to a tool-capable host)'
      : orchReadiness.webMode;
    add(`Web capability: ${webNote}`, true, true);

    firstRunReadinessLine = formatFirstRunExecutionReadiness(orchReadiness);
  } catch (err) {
    add(`Worker backend / web capability check failed: ${err.message}`, false, true);
  }

  // Provider worker reliability settings (construct-5wkl): the effective
  // per-call timeout and retry policy are resolved the same way the worker
  // itself resolves them (resolveNonNegativeSetting over CONSTRUCT_PROVIDER_*),
  // so this can never drift from what a real provider-backed run applies, and
  // a test-scale or otherwise unintended override is never invisible. Advisory only.
  try {
    const { resolveNonNegativeSetting } = await import('../lib/env-config.mjs');
    const { PROVIDER_TIMEOUT_DEFAULT_MS } = await import('../lib/orchestration/worker.mjs');
    const timeoutMs = resolveNonNegativeSetting(process.env, 'CONSTRUCT_PROVIDER_TIMEOUT_MS', PROVIDER_TIMEOUT_DEFAULT_MS);
    const maxAttempts = resolveNonNegativeSetting(process.env, 'CONSTRUCT_PROVIDER_MAX_ATTEMPTS', 3);
    const retryBaseMs = resolveNonNegativeSetting(process.env, 'CONSTRUCT_PROVIDER_RETRY_BASE_MS', 250);
    add(`Provider timeout: ${timeoutMs}ms · retry attempts: ${maxAttempts} (base backoff ${retryBaseMs}ms)`, true, true);
  } catch (err) {
    add(`Provider reliability settings check failed: ${err.message}`, false, true);
  }


  // Opt-in deep credential check (construct-1yhp.5). Default doctor stays
  // presence-first (construct-trxz: a default-on op:// probe would fight the
  // prompt-storm mitigation) — `--probe-providers` performs the real network
  // auth probe only for providers already presence-configured.
  if (args.includes('--probe-providers')) {
    try {
      const { getProviderModelCatalog } = await import('../lib/model-router.mjs');
      const { probeProviderConnection } = await import('../lib/providers/connection-probe.mjs');
      const { providers } = getProviderModelCatalog({ env: process.env });
      const probeable = providers.filter((p) => p.configured && ['openrouter', 'anthropic', 'openai'].includes(p.id));
      if (probeable.length === 0) {
        add('Provider auth probe — no presence-configured openrouter/anthropic/openai provider to probe', true, true);
      }
      for (const p of probeable) {
        const result = await probeProviderConnection(p.id, { env: process.env, cwd: process.cwd() });
        if (result.ok) {
          add(`Provider auth probe — ${p.id}: auth-verified (SERVING)`, true, true);
        } else if (result.code === 'auth_error') {
          add(`Provider auth probe — ${p.id}: ${result.status || '401/403'} (NOT_SERVING) — rotate or re-authenticate the key`, false, true);
        } else if (result.code === 'missing_key') {
          add(`Provider auth probe — ${p.id}: credential did not materialize (op:// ref unresolved) — check the ref or run \`op signin\``, false, true);
        } else {
          add(`Provider auth probe — ${p.id}: ${result.code}${result.status ? ` (${result.status})` : ''} (unverified)`, false, true);
        }
      }
    } catch (err) {
      add(`Provider auth probe failed: ${err.message}`, false, true);
    }
  }

  const { resolveCommandOnPath } = await import('../lib/doctor/command-on-path.mjs');

  add('Node.js 20+ (recommended)', Number.parseInt(process.versions.node.split('.')[0], 10) >= 20);
  add('npm available', resolveCommandOnPath('npm').status === 0);
  const npmDevdir = process.env.npm_config_devdir ?? process.env.NPM_CONFIG_DEVDIR;
  if (npmDevdir) {
    add(
      'npm env: npm_config_devdir set (Cursor sandbox) — npm 11.2+ warns on every `npm run`. Unset: unset npm_config_devdir NPM_CONFIG_DEVDIR. Or run scripts directly: node scripts/... / construct ...',
      false,
      true,
    );
  }
  const constructOnPath = resolveCommandOnPath('construct');
  const constructPath = constructOnPath.status === 0 ? constructOnPath.stdout.trim() : '';
  const constructVersion = constructPath
    ? spawnSync(constructPath, ['version'], { encoding: 'utf8', env: process.env })
    : null;
  add('construct command on PATH', Boolean(constructPath), true);
  add('construct command is this CLI', Boolean(constructVersion && constructVersion.status === 0 && /^construct v\d+\./.test(constructVersion.stdout.trim())), true);
  add('OpenCode config exists', fs.existsSync(path.join(HOME, '.config', 'opencode', 'opencode.json')), true);
  add('Claude Code agents dir', fs.existsSync(path.join(HOME, '.claude', 'agents')), true);
  add('Codex agents dir', fs.existsSync(path.join(HOME, '.codex', 'agents')), true);
  add('Copilot prompts dir', fs.existsSync(path.join(HOME, '.github', 'prompts')), true);
  // Only check Cursor MCP config when Cursor is actually installed (its home
  // directory exists). Absent Cursor, no warning — the adapter parity check
  // already surfaces 'cursor: not installed' for informational purposes.
  const cursorHomeDir = path.join(HOME, '.cursor');
  if (fs.existsSync(cursorHomeDir)) {
    add('Cursor MCP config', fs.existsSync(path.join(cursorHomeDir, 'mcp.json')), true);
  }

  const vscodeSettingsPaths = process.platform === 'darwin'
    ? [
        path.join(HOME, 'Library', 'Application Support', 'Code', 'User', 'settings.json'),
        path.join(HOME, 'Library', 'Application Support', 'Code - Insiders', 'User', 'settings.json'),
      ]
    : process.platform === 'linux'
      ? [
          path.join(HOME, '.config', 'Code', 'User', 'settings.json'),
          path.join(HOME, '.config', 'Code - Insiders', 'User', 'settings.json'),
        ]
      : [
          path.join(process.env.APPDATA ?? path.join(HOME, 'AppData', 'Roaming'), 'Code', 'User', 'settings.json'),
          path.join(process.env.APPDATA ?? path.join(HOME, 'AppData', 'Roaming'), 'Code - Insiders', 'User', 'settings.json'),
        ];
  // Only check VS Code settings when VS Code is actually installed. On macOS,
  // Code's Application Support directory is the installation signal.
  const vscodeAppSupportRoots = process.platform === 'darwin'
    ? [
        path.join(HOME, 'Library', 'Application Support', 'Code'),
        path.join(HOME, 'Library', 'Application Support', 'Code - Insiders'),
      ]
    : process.platform === 'linux'
      ? [path.join(HOME, '.config', 'Code'), path.join(HOME, '.config', 'Code - Insiders')]
      : [
          path.join(process.env.APPDATA ?? path.join(HOME, 'AppData', 'Roaming'), 'Code'),
          path.join(process.env.APPDATA ?? path.join(HOME, 'AppData', 'Roaming'), 'Code - Insiders'),
        ];
  if (vscodeAppSupportRoots.some((r) => fs.existsSync(r))) {
    // VS Code installed → check settings.json presence as a green/info signal.
    // Absence is not a doctor finding — VS Code adapter support hasn't landed
    // yet, so "create one or wait for support" isn't actionable. The line is
    // suppressed entirely when missing; doctor surfaces facts, not roadmap.
    const vscodeSettingsPath = vscodeSettingsPaths.find((candidate) => fs.existsSync(candidate)) ?? null;
    const vscodeSettingsOk = Boolean(vscodeSettingsPath);
    if (vscodeSettingsOk) add('VS Code settings file', true, true);

    // classifyHostReadiness distinguishes the discrete host-config states
    // (missing_config/stale_path/jsonc_unpatched/wrong_key/disabled/healthy)
    // instead of collapsing readiness to settings.json presence above — only
    // meaningful once VS Code has a settings file or a project mcp.json to read.
    const vscodeProjectMcpPath = path.join(process.cwd(), '.vscode', 'mcp.json');
    const vscodeMcpPath = fs.existsSync(vscodeProjectMcpPath) ? vscodeProjectMcpPath : null;
    if (vscodeSettingsPath || vscodeMcpPath) {
      const { classifyHostReadiness, HOST_READINESS_NEXT_STEPS } = await import('../lib/host/readiness.mjs');
      const reasonCode = classifyHostReadiness({
        host: 'vscode',
        settingsPath: vscodeSettingsPath,
        mcpPath: vscodeMcpPath,
        root: ROOT_DIR,
      });
      const nextStep = HOST_READINESS_NEXT_STEPS[reasonCode];
      add(
        reasonCode === 'healthy'
          ? 'VS Code MCP host readiness: healthy'
          : `VS Code MCP host readiness: ${reasonCode} — ${nextStep}`,
        reasonCode === 'healthy',
        true,
      );
    }
  }
  add('User config ready', fs.existsSync(getUserEnvPath(HOME)) || fs.existsSync(configDir(HOME)), true);
  add('skills/ directory', fs.existsSync(path.join(ROOT_DIR, 'skills')));
  add('rules/common/', fs.existsSync(path.join(ROOT_DIR, 'rules', 'common')));
  add('specialists/prompts/ directory', fs.existsSync(path.join(ROOT_DIR, 'specialists', 'prompts')));
  add('Hybrid storage env keys documented', fs.existsSync(path.join(ROOT_DIR, '.env.example')));
  const perfReviewsDir = path.join(doctorRoot(), 'performance-reviews');
  fs.mkdirSync(perfReviewsDir, { recursive: true });
  add('performance-reviews/ ready', fs.existsSync(perfReviewsDir));

  // Living-graph truth: doctor runs `graph validate` so workflow/manifest drift
  // surfaces as a health check, not only via the standalone command (LMCP-C7).

  try {
    const { checkGraphValidateForDoctor } = await import('../lib/doctor/graph-validate.mjs');
    const graphCheck = checkGraphValidateForDoctor({ rootDir: process.cwd() });
    add(graphCheck.label, graphCheck.ok, graphCheck.warning);
  } catch (err) {
    add(`Graph validate check failed: ${err.message}`, false, true);
  }

  // construct.config.json — optional today (config is permitted to be absent;
  // env vars + defaults still work). The check enforces that when the file
  // *is* present it parses and validates against the v1 schema.
  try {
    const projectCfg = loadProjectConfig(process.cwd(), process.env);
    if (projectCfg.source === 'invalid') {
      const detail = projectCfg.errors[0] || 'unknown error';
      const more = projectCfg.errors.length > 1 ? ` (+${projectCfg.errors.length - 1} more)` : '';
      add(`construct.config.json invalid: ${detail}${more} — defaults applied; run \`construct config validate\``, false, false);
    } else if (projectCfg.source === 'file') {
      add(`construct.config.json valid`, true, true);
    } else {
      add('construct.config.json (optional)', true, true);
    }
  } catch (err) {
    add(`construct.config.json check failed: ${err.message}`, false, true);
  }

  // Claude Code Stop-hook installation check. The settings template
  // wires several Stop hooks (policy-engine / stop-typecheck /
  // stop-notify / readme-age-check) whose commands sync resolves to the
  // hook lib symlink. If those scripts don't resolve, every Stop hook
  // fails silently — including stop-notify, which is what appends session
  // cost data. Result: the dashboard stops updating and the user sees stale
  // data. Surface loudly so the fix is one command away.
  try {
    const settingsPath = path.join(HOME, '.claude', 'settings.json');
    if (fs.existsSync(settingsPath)) {
      const settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
      const stopHooks = settings?.hooks?.Stop || [];
      const installRoot = path.join(configDir(HOME), 'lib', 'hooks');
      const referenced = [];
      for (const group of stopHooks) {
        for (const h of (group?.hooks || [])) {
          const cmd = String(h?.command || '');
          const m = cmd.match(/(?:^|["\s])(\/[^"\s]*\/lib\/hooks\/[a-zA-Z0-9_-]+\.mjs)/);
          if (m) referenced.push(m[1]);
        }
      }
      const missing = referenced.filter((scriptPath) => !fs.existsSync(scriptPath));
      if (referenced.length > 0 && missing.length > 0) {
        add(
          `Claude Stop hooks broken: ${missing.length} hook${missing.length === 1 ? '' : 's'} do not resolve. Re-run \`construct install --footprint=user\` (symlinks ${ROOT_DIR}/lib → ${installRoot.replace(/\/hooks$/, '')}).`,
          false,
          false,
        );
      } else if (referenced.length > 0) {
        add(`Claude Stop hooks installed (${referenced.length} hooks resolve)`, true, true);
      }
    }
  } catch (err) {
    add(`Claude Stop hooks check failed: ${err.message}`, false, true);
  }

  // Handoff hygiene. Files in .construct/handoffs/ accumulate per session; this
  // probe surfaces stale files past retention and files whose bead refs
  // have all closed (safe to prune). Advisory — graceful when no .construct/
  // handoffs/ directory exists.
  try {
    const { summarizeHandoffs } = await import('../lib/handoffs/inventory.mjs');
    const h = summarizeHandoffs(process.cwd(), process.env);
    if (h.state === 'empty') {
      add('Handoffs: empty', true, true);
    } else if (h.pastRetentionCount > 0) {
      add(`Handoffs: ${h.pastRetentionCount} past ${h.maxDays}d retention — \`construct prune\``, false, true);
    } else if (h.resolvedCount > 0) {
      add(`Handoffs: ${h.total} files (${h.resolvedCount} reference only closed beads)`, true, true);
    } else {
      add(`Handoffs: ${h.total} files (oldest ${h.oldestAgeDays?.toFixed(0)}d)`, true, true);
    }
  } catch (err) {
    add(`Handoff check failed: ${err.message}`, false, true);
  }

  // Disk resource budgets. Construct writes .construct/traces/, .construct/intake/,
  // task graphs, backups, worker logs continuously. Without ceilings a
  // long-lived install can fill the user's disk. Doctor surfaces usage
  // vs cap as advisory at <=80%, warn at 80-100%, fail at >100%.
  try {
    const { measureUsage } = await import('../lib/resources/budget.mjs');
    const u = measureUsage(process.cwd(), process.env);
    const usedMb = u.totalCxBytes / 1024 / 1024;
    const capMb = u.totalCxCap / 1024 / 1024;
    const pct = (u.totalCxUsageRatio * 100).toFixed(0);
    if (u.totalCxUsageRatio > 1) {
      add(`.construct/ ${usedMb.toFixed(0)}MB / ${capMb.toFixed(0)}MB cap (${pct}% — over) — run \`construct prune\``, false, false);
    } else if (u.totalCxUsageRatio > 0.8) {
      add(`.construct/ ${usedMb.toFixed(1)}MB / ${capMb.toFixed(0)}MB cap (${pct}% — warning) — \`construct prune\` recommended`, false, true);
    } else {
      add(`.construct/ ${usedMb.toFixed(1)}MB / ${capMb.toFixed(0)}MB cap (${pct}%)`, true, true);
    }
  } catch (err) {
    add(`Resource budget check failed: ${err.message}`, false, true);
  }

  // construct-95phc.3: cumulative spend must be re-verifiable from the real
  // ledgers, not a placeholder — cost-ledger.mjs's USD/day figures and
  // unattended-budget.mjs's token/day figures for daemon-originated spend.
  try {
    const { getTotalDailySpend, totalBudget, enforcementActive } = await import('../lib/cost-ledger.mjs');
    const { unattendedSpendSummary } = await import('../lib/policy/unattended-budget.mjs');
    const total = getTotalDailySpend();
    const cap = totalBudget();
    const pct = cap > 0 ? Math.round((total.costUsd / cap) * 100) : 0;
    add(
      `Cumulative spend today: $${total.costUsd.toFixed(4)} / $${cap.toFixed(2)} cap (${pct}%) — enforcement ${enforcementActive() ? 'on' : 'advisory'}`,
      total.costUsd <= cap,
      true,
    );
    const unattended = unattendedSpendSummary(process.cwd());
    if (unattended.length) {
      for (const row of unattended) {
        const overCap = row.cap > 0 && row.tokensSpent > row.cap;
        add(`Unattended spend — ${row.capability}: ${row.tokensSpent} / ${row.cap || 0} tokens today`, !overCap, true);
      }
    } else {
      add('Unattended spend: no daemon-originated LLM spend recorded today', true, true);
    }
  } catch (err) {
    add(`Cumulative spend check failed: ${err.message}`, false, true);
  }

  // Pricing-catalog freshness + divergence are not surfaced in doctor output.
  // The underlying ledger writes and catalog refresh continue; consumer
  // surfaces land with the OTel + dashboard wiring (plan Workstream J).

  // Validate promptFile references and skill bindings
  try {
    const registry = loadRegistry({ rootDir: ROOT_DIR });
    const brokenPromptFiles = Object.values(registry.specialists ?? {}).filter((s) => {
      if (!s.promptFile) return false;
      return !fs.existsSync(path.join(ROOT_DIR, s.promptFile));
    });
    add('All specialist promptFiles resolve', brokenPromptFiles.length === 0);
    const headhuntClassifierAgents = ['cx-operations', 'cx-researcher', 'cx-architect', 'cx-security', 'cx-engineer'];
    const registryNames = new Set(Object.values(registry.specialists ?? {}).map((s) => `cx-${s.name}`));
    const classifierOrphans = headhuntClassifierAgents.filter((n) => !registryNames.has(n));
    add('Headhunt classifier agents exist in registry', classifierOrphans.length === 0);
    const skillAudit = auditSkills({ rootDir: ROOT_DIR, silent: true });
    add('No declared skills missing on disk', skillAudit.pass, false);
    if (isSourceCheckout) {
      const { scanRetiredRegistryPathReferences } = await import('../lib/registry/retired-paths.mjs');
      const staleRegistryPaths = scanRetiredRegistryPathReferences(ROOT_DIR);
      add(
        staleRegistryPaths.length === 0
          ? 'No retired registry path references'
          : `Retired registry path references (${staleRegistryPaths.length}: ${staleRegistryPaths.slice(0, 3).map((h) => h.file).join(', ')}${staleRegistryPaths.length > 3 ? ', …' : ''})`,
        staleRegistryPaths.length === 0,
        false,
      );
      const specialistAudit = auditSpecialists({ rootDir: ROOT_DIR, silent: true });
      add('Specialist/skill audit cross-checks', specialistAudit.pass, false);

      // The catalog is the public-service source of truth; doctor joins it to runtime dispatch
      // and the generated reference so a command that is unroutable or undocumented surfaces here.

      const { buildCliServiceInventory } = await import('../lib/cli-service-inventory.mjs');
      const cliDrift = buildCliServiceInventory({ rootDir: ROOT_DIR })
        .filter((entry) => !entry.runnable || !entry.documented);
      add('Public CLI dispatch/reference parity', cliDrift.length === 0, false);
    } else {
      add('Specialist/skill audit cross-checks (skipped — published package)', true, true);
      add('Public CLI dispatch/reference parity (skipped — published package)', true, true);
    }
    const { lintResearchRepo } = await import('../lib/research-lint.mjs');
    const researchLintResults = lintResearchRepo({ rootDir: process.cwd() });
    add('Research artifacts meet minimum evidence structure', researchLintResults.every((entry) => entry.errors.length === 0), true);

    // isHealthy() connects to LanceDB, which creates the index directory on
    // first touch — checking existence first keeps doctor from provisioning
    // the vector store on a project that has never run semantic search
    // (construct-rf26.17: lazy provisioning, not "on every project touch").
    const { resolveStateDir } = await import('../lib/state-root.mjs');
    const lancedbPath = process.env.CONSTRUCT_LANCEDB_PATH || resolveStateDir(process.cwd(), 'lancedb', { ensureDir: false });
    if (fs.existsSync(lancedbPath)) {
      const { VectorClient } = await import('../lib/storage/vector-client.mjs');
      const vectorClient = new VectorClient({ env: process.env });
      const vectorOk = await vectorClient.isHealthy();
      add('Vector backend (LanceDB) reachable', vectorOk);

      const { purgeExpiredData } = await import('../lib/storage/admin.mjs');
      const purge = await purgeExpiredData(process.cwd(), { env: process.env });
      if (purge.status === 'ok') {
        const sizeMb = (purge.sizeBytes / 1024 / 1024).toFixed(1);
        const oldest = purge.oldestRetainedAt ? new Date(purge.oldestRetainedAt).toISOString().slice(0, 10) : 'n/a';
        add(
          `Observations (vector index): ${sizeMb}MB, ${purge.remainingCount} row(s), oldest ${oldest}` +
          (purge.evictedCount > 0 ? ` — evicted ${purge.evictedCount} past ${purge.maxAgeDays}d/${purge.maxRows} rows` : ''),
          true,
          true,
        );
      }
    } else {
      add('Vector backend (LanceDB): not yet provisioned (lazy — first semantic-search use creates it)', true, true);
    }

    const { regenerateDocs } = await import('../lib/auto-docs.mjs');
    const { changed: stale } = await regenerateDocs({ rootDir: ROOT_DIR, check: true });
    add('AUTO docs up to date', stale.length === 0, true);

    const settingsPath = path.join(ROOT_DIR, 'platforms', 'claude', 'settings.template.json');
    if (fs.existsSync(settingsPath)) {
      const raw = fs.readFileSync(settingsPath, 'utf8');
      const refs = [...raw.matchAll(/lib\/hooks\/([\w-]+\.m?js)/g)].map((m) => m[1]);
      const uniq = [...new Set(refs)];
      const missing = uniq.filter((f) => !fs.existsSync(path.join(ROOT_DIR, 'lib', 'hooks', f)));
      const label = missing.length === 0
        ? `Hook registrations resolve (${uniq.length} hooks)`
        : `Hook registrations resolve (${missing.length} phantom: ${missing.join(', ')})`;
      add(label, missing.length === 0);
    }

    const beadsPreCommit = path.join(ROOT_DIR, '.beads', 'hooks', 'pre-commit');
    const inCI = process.env.CI === 'true' || process.env.CI === '1';
    if (fs.existsSync(beadsPreCommit) && !inCI) {
      const hp = spawnSync('git', ['config', '--get', 'core.hooksPath'], { cwd: ROOT_DIR, encoding: 'utf8' });
      const value = hp.status === 0 ? (hp.stdout || '').trim() : '';
      const absEquiv = path.join(ROOT_DIR, '.beads', 'hooks');
      const wired = value === '.beads/hooks' || value === absEquiv;
      const label = wired
        ? 'Git hooks wired (core.hooksPath = .beads/hooks)'
        : value
          ? `Git hooks unwired (core.hooksPath = '${value}', expected '.beads/hooks') — pre-commit policy gates inactive`
          : 'Git hooks unwired (core.hooksPath unset) — pre-commit policy gates inactive. Fix: git config core.hooksPath .beads/hooks';
      add(label, wired);
    }

    // Half-initialized Beads: .claude/settings.json references bd but .beads/ is
    // absent or has no database file. A project set up before D3 (fail-closed Beads)
    // fired the hooks without a tracker, so bd exits non-zero with no database to read.

    try {
      const projectSettingsPath = path.join(process.cwd(), '.claude', 'settings.json');
      let hasHooksRef = false;
      if (fs.existsSync(projectSettingsPath)) {
        hasHooksRef = /\bbd\b/.test(fs.readFileSync(projectSettingsPath, 'utf8'));
      }
      if (hasHooksRef) {
        const beadsDir = path.join(process.cwd(), '.beads');
        const beadsHasDb = fs.existsSync(beadsDir) && (
          fs.existsSync(path.join(beadsDir, 'issues.jsonl')) ||
          fs.existsSync(path.join(beadsDir, 'metadata.json'))
        );
        add(
          beadsHasDb
            ? 'Beads tracker initialized'
            : 'Beads tracker not initialized (hooks reference bd but .beads/ missing — run: bd init)',
          beadsHasDb,
          false,
        );
      }
    } catch (err) {
      add(`Beads half-staged check failed: ${err.message}`, false, true);
    }

    const pluginRegistry = loadPluginRegistry({ cwd: process.cwd(), homeDir: HOME, rootDir: ROOT_DIR, env: process.env });
    add('Plugin manifests valid', pluginRegistry.valid);

    try {
      const { describeEngine } = await import('../lib/engine/index.mjs');
      const engine = await describeEngine({ rootDir: process.cwd() });
      add('Retrieval engine layers resolve', engine.errors.length === 0, true);
    } catch {
      add('Retrieval engine layers resolve', false, true);
    }

    try {
      const { checkParity } = await import('../lib/parity.mjs');
      const parity = checkParity({ rootDir: ROOT_DIR, homeDir: HOME });
      // Legacy-install rolls up to ok (so the gate doesn't hard-fail during
      // a v1.0.10 → v1.0.13+ upgrade) but renders as a warning so the
      // --fix-legacy-agents hint stays visible.
      const hasLegacy = parity.surfaces.some((s) => s.status === 'legacy-install');
      add(`Cross-surface adapter parity (${parity.summary.join(' · ')})`, parity.ok, hasLegacy);
    } catch {
      add('Cross-surface adapter parity', false);
    }

    try {
      const { checkProjectAdaptersForDoctor } = await import('../lib/doctor/project-adapters.mjs');
      const projectAdapters = checkProjectAdaptersForDoctor({ rootDir: ROOT_DIR, projectDir: process.cwd() });
      add(projectAdapters.label, projectAdapters.ok, projectAdapters.warning);
    } catch {
      add('Project adapters', false, true);
    }

    try {
      const { validateSkills } = await import('../lib/validators/skills.mjs');
      const skillsRoot = path.join(ROOT_DIR, 'skills');
      const skillReport = validateSkills(skillsRoot);
      const label = skillReport.warnings.length > 0
        ? `Skill structure (${skillReport.skills.length} skills, ${skillReport.warnings.length} authoring warnings)`
        : `Skill structure (${skillReport.skills.length} skills)`;
      add(label, skillReport.valid, true);
    } catch {
      add('Skill structure', false, true);
    }

    try {
      const { lintWorkflowSkillVerification } = await import('../lib/registry/skill-verification.mjs');
      const wf = lintWorkflowSkillVerification(path.join(ROOT_DIR, 'skills'));
      const wfLabel = wf.warnings.length
        ? `Workflow skill verification (${wf.checked} checked, ${wf.warnings.length} missing bars)`
        : `Workflow skill verification (${wf.checked} checked)`;
      add(wfLabel, wf.valid && wf.warnings.length === 0, true);
    } catch {
      add('Workflow skill verification', false, true);
    }

    try {
      const { validateCapabilityRegistry } = await import('../lib/registry/validate.mjs');
      const reg = validateCapabilityRegistry({ rootDir: ROOT_DIR });
      const regLabel = reg.warnings.length
        ? `Capability registry (${reg.count} entries, ${reg.warnings.length} warnings)`
        : `Capability registry (${reg.count} entries)`;
      add(regLabel, reg.valid, reg.errors.length > 0);
    } catch {
      add('Capability registry', false, true);
    }

    try {
      const { describeBreakers, STATES } = await import('../lib/providers/circuit-breaker.mjs');
      const breakers = describeBreakers();
      const open = breakers.filter((b) => b.state === STATES.OPEN);
      const label = open.length === 0
        ? `Provider circuit breakers (${breakers.length} tracked, none open)`
        : `Provider circuit breakers (${open.length} open: ${open.map((b) => b.key).join(', ')})`;
      add(label, open.length === 0, true);
    } catch {
      add('Provider circuit breakers', false, true);
    }

    try {
      const { recentViolations, violationLogPath } = await import('../lib/contracts/violation-log.mjs');
      const violations = recentViolations({ windowMs: 24 * 60 * 60 * 1000 });
      // Path is project-scoped (.construct/contract-violations.jsonl in cwd when
      // inside a project, ~/.cx/ otherwise). Print the resolved one so
      // users find the real file, not a stale ~/.cx/ reference.
      const violationPath = violationLogPath();
      const label = violations.length === 0
        ? 'Contract violations (none in last 24h)'
        : `Contract violations (${violations.length} in last 24h — see ${violationPath})`;
      add(label, violations.length === 0, true);
    } catch {
      add('Contract violations', false, true);
    }

    try {
      const capWarnPath = configPath(process.cwd(), 'observation-cap-warnings.jsonl');
      if (fs.existsSync(capWarnPath)) {
        const lines = fs.readFileSync(capWarnPath, 'utf8').trim().split('\n').filter(Boolean);
        const cutoff = Date.now() - 7 * 24 * 60 * 60 * 1000;
        const recent = lines.filter((l) => {
          try { return new Date(JSON.parse(l).ts).getTime() >= cutoff; } catch { return false; }
        });
        const totalDropped = recent.reduce((acc, l) => {
          try { return acc + (JSON.parse(l).dropped || 0); } catch { return acc; }
        }, 0);
        const label = recent.length === 0
          ? 'Observation cap (no recent drops)'
          : `Observation cap (${totalDropped} obs dropped in last 7d — run \`construct memory consolidate\`)`;
        add(label, recent.length === 0, true);
      } else {
        add('Observation cap (no recent drops)', true, true);
      }
    } catch {
      add('Observation cap', false, true);
    }

    try {
      const { checkObservationsSize } = await import('../lib/observation-store.mjs');
      const sz = checkObservationsSize(process.cwd());
      const mb = (sz.size / 1024 / 1024).toFixed(1);
      const capMb = (sz.cap / 1024 / 1024).toFixed(0);
      const sizeLabel = sz.ok
        ? `Observation size (${mb} MB / ${capMb} MB cap)`
        : `Observation size (${mb} MB exceeds ${capMb} MB cap — run \`construct memory consolidate\`)`;
      add(sizeLabel, sz.ok, true);
    } catch {
      add('Observation size', false, true);
    }

    try {
      const { detectBeadsDrift } = await import('../lib/beads/drift.mjs');
      const drift = detectBeadsDrift();
      const ok = drift.counts.stuckInProgress === 0 && drift.counts.mergeDrift === 0;
      let label = 'Beads hygiene: no drift';
      if (!ok) {
        const parts = [];
        if (drift.counts.stuckInProgress > 0) parts.push(`${drift.counts.stuckInProgress} stuck in_progress`);
        if (drift.counts.mergeDrift > 0) parts.push(`${drift.counts.mergeDrift} possible merge-drift`);
        label = `Beads hygiene: ${parts.join(', ')} — run \`construct beads drift\``;
      } else if (drift.counts.staleOpen > 0) {
        label = `Beads hygiene: ${drift.counts.staleOpen} stale-open (advisory) — run \`construct beads drift\``;
      }
      add(label, ok, true);
    } catch {
      // bd not on PATH or repo not a bd workspace — skip silently.
    }

    // cm and Docker are optional but downstream services (memory MCP,
    // managed Postgres) depend on them. Surface missing tools
    // as warnings rather than failures so doctor doesn't flip-flop.
    try {
      const cmProbe = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['cm'], { stdio: 'pipe' });
      const cmAvailable = cmProbe.status === 0;
      add(cmAvailable ? 'cm available' : 'cm available (optional — memory MCP at 127.0.0.1:8765 needs it)', cmAvailable, true);
    } catch {
      add('cm available', false, true);
    }

    try {
      const failuresPath = path.join(doctorRoot(), 'hook-failures.jsonl');
      if (fs.existsSync(failuresPath)) {
        const lines = fs.readFileSync(failuresPath, 'utf8').trim().split('\n').filter(Boolean);
        const cutoff = Date.now() - 24 * 60 * 60 * 1000;
        const recent = lines.filter((l) => {
          try { return new Date(JSON.parse(l).ts).getTime() >= cutoff; } catch { return false; }
        });
        add(`No recent hook failures (${recent.length} in last 24h)`, recent.length === 0, true);
      } else {
        add('No recent hook failures (0 in last 24h)', true, true);
      }
    } catch {
      add('No recent hook failures (24h)', false, true);
    }

    // Agent contracts integrity. A contract is broken if it lacks id,
    // producer, or consumer, or declares neither postconditions nor output —
    // mirrors the predicate in tests/doctor/contract-validation.test.mjs.
    const { getAllContracts } = await import('../lib/specialist-contracts.mjs');
    const contracts = getAllContracts();
    add('Agent contracts loaded', contracts.length > 0);
    if (contracts.length > 0) {
      const brokenContracts = contracts.filter((c) =>
        !c.id || !c.producer || !c.consumer || (!c.postconditions && !c.output),
      );
      add('Agent contract schema intact', brokenContracts.length === 0);
    }

    // Skills profile — if present, check staleness against current tags
    const profilePath = configPath(process.cwd(), 'skills-profile.json');
    if (fs.existsSync(profilePath)) {
      try {
        const { detectProjectProfile } = await import('../lib/project-profile.mjs');
        const current = detectProjectProfile(process.cwd());
        const saved = JSON.parse(fs.readFileSync(profilePath, 'utf8'));
        const savedTags = new Set(saved?.profile?.tags || []);
        const currentTags = new Set(current.tags);
        const drift =
          savedTags.size !== currentTags.size ||
          [...savedTags].some((t) => !currentTags.has(t)) ||
          [...currentTags].some((t) => !savedTags.has(t));
        add('Skills profile matches current project stack', !drift, true);
      } catch {
        add('Skills profile matches current project stack', false, true);
      }
    }
  } catch {
    add('Registry integrity check', false);
  }

  // Deployment-mode capability check: surfaces stub/not-implemented capabilities
  // for team/enterprise modes so users know which advertised features are unbuilt.
  // Solo mode is fully-implemented; this check is a no-op there.
  //
  // Enterprise mode additionally applies ADR-0057's status contract: a
  // FAIL-CLOSED capability (tenant-isolation, isolated-workers) is architecturally
  // non-trivial and "must not be a warning; it must be a hard error" surfaced
  // "at startup (during construct doctor)". A LATER capability (rbac,
  // signed-mcp-allowlists) has no runtime effect and must not read as a doctor
  // failure at all — it is reported informationally only.

  try {
    const { getModeCapabilityStatus, getUnsupportedCapabilities, getCapabilities, categorizeEnterpriseCapability } =
      await import('../lib/mode-capabilities.mjs');
    const currentMode = getDeploymentMode(process.env);
    const capStatus = getModeCapabilityStatus(currentMode);
    if (currentMode === 'enterprise') {
      const allCaps = getCapabilities('enterprise');
      const failClosed = allCaps.filter((cap) => categorizeEnterpriseCapability(cap) === 'fail-closed');
      const later = allCaps.filter((cap) => categorizeEnterpriseCapability(cap) === 'later');
      if (failClosed.length > 0) {
        add(
          `Mode capabilities (enterprise): ${failClosed.length} fail-closed, not yet implemented (${failClosed.map((c) => c.label).join(', ')}) — ADR-0057 refuses these hard, not just a warning`,
          false,
          false,
        );
      } else {
        add('Mode capabilities (enterprise): no fail-closed gaps', true, true);
      }
      if (later.length > 0) {
        add(`Mode capabilities (enterprise): ${later.length} deferred to a later wave, no runtime effect (${later.map((c) => c.label).join(', ')})`, true, true);
      }
    } else if (capStatus !== 'fully-implemented') {
      const unsupported = getUnsupportedCapabilities(currentMode);
      add(
        `Mode capabilities (${currentMode}): ${unsupported.length} stub/not-implemented (${unsupported.map(c => c.label).join(', ')})`,
        false,
        true,
      );
    } else {
      add(`Mode capabilities (${currentMode})`, true, true);
    }
  } catch (err) {
    add(`Mode capabilities check failed: ${err.message}`, false, true);
  }

  try {
    const currentMode = getDeploymentMode(process.env);
    if (currentMode === 'team' || currentMode === 'enterprise') {
      const { summarizeTeamHealth } = await import('../lib/team/health.mjs');
      const teamHealth = await summarizeTeamHealth({ rootDir: process.cwd(), env: process.env });
      add(`Team queue/worker health: ${teamHealth.summary}`, teamHealth.status !== 'unavailable');
      if (teamHealth.status !== 'unavailable') {
        add(`Team queue DLQ depth: ${teamHealth.deadLetter}`, teamHealth.deadLetter === 0, teamHealth.deadLetter > 0);
        add(`Team stale workers: ${teamHealth.staleWorkers}`, teamHealth.staleWorkers === 0, teamHealth.staleWorkers > 0);
      }
    }
  } catch (err) {
    add(`Team health check failed: ${err.message}`, false);
  }

  // Reconciliation drift (ADR-0027). Any task reporting needsRepair is surfaced
  // with its summary and the exact `construct sync --reconcile=<id>` command.
  // Auto tasks that still show drift (e.g. a run with --no-reconcile) and all
  // ask tasks both land here, since ask tasks never run from the auto pass.
  let reconcileDrift = [];
  try {
    const { listReconciliations } = await import('../lib/reconcile/index.mjs');
    const tasks = await listReconciliations();
    reconcileDrift = tasks.filter((t) => t.needsRepair);
    add(
      reconcileDrift.length === 0
        ? 'Reconciliation drift: none'
        : `Reconciliation drift: ${reconcileDrift.length} task${reconcileDrift.length === 1 ? '' : 's'} need repair (see below)`,
      reconcileDrift.length === 0,
      true,
    );
  } catch (err) {
    add(`Reconciliation drift check failed: ${err.message}`, false, true);
  }

  // Source-target health (B8): directory paths that vanished and corpus caches
  // past TTL, plus soft credential-presence notices. Filesystem + env only — no
  // outbound fetch — so the default doctor keeps its zero-network invariant. A
  // project with no registered targets stays silent.
  try {
    const { checkSourceTargetHealth } = await import('../lib/doctor/source-target-health.mjs');
    const { configured, findings } = checkSourceTargetHealth({ cwd: process.cwd() });
    if (configured > 0) {
      const problems = findings.filter((f) => !f.ok);
      if (problems.length === 0) {
        add(`Source targets healthy (${configured} configured)`, true);
      } else {
        for (const f of findings) {
          if (!f.ok) add(f.label, false, Boolean(f.optional));
        }
      }
    }
  } catch (err) {
    add(`Source-target health check failed: ${err.message}`, false, true);
  }

  // Docling document-extraction runtime (Python venv via uv). Provisioned lazily
  // on first document ingest, or eagerly via `construct install --with-docling`.
  // Advisory: absence is fine until a document is ingested.
  try {
    const { describeDoclingRuntime } = await import('../lib/runtime/uv-bootstrap.mjs');
    const docling = describeDoclingRuntime();
    if (docling.available) {
      add(`Docling runtime ready (docling ${docling.marker?.doclingVersion ?? '?'})`, true, true);
    } else {
      add('Docling runtime not provisioned (`construct install --with-docling`, or auto on first ingest)', false, true);
    }
  } catch (err) {
    add(`Docling runtime check failed: ${err.message}`, false, true);
  }

  // Capability honesty without re-probing: if the OpenCode default model is one the
  // probe recorded as COLLAPSED (and its digest still matches), flag it at health
  // time. Reads the persisted store only — the slow probe stays behind --probe-local.
  try {
    const { readOpenCodeConfig } = await import('../lib/opencode-config.mjs');
    const { isKnownCollapsed } = await import('../lib/ollama/capability-store.mjs');
    const { modelDigest } = await import('../lib/ollama/provision-context.mjs');
    const { config } = readOpenCodeConfig();
    const defaultModel = (config?.model || config?.defaultModel || '').replace(/^ollama\//, '');
    if (defaultModel && isKnownCollapsed(defaultModel, modelDigest(defaultModel))) {
      add(`Default local model ${defaultModel} probed COLLAPSED — not agentic-capable (re-verify: construct doctor --probe-local)`, false, true);
    }
  } catch { /* advisory */ }

  // Opt-in agentic-coherence probe for local models (`construct doctor --probe-local`).
  // Loads each registered Ollama model and measures repetition collapse on an agentic
  // prompt, so it is gated behind the flag. COLLAPSED models produce word salad no
  // matter how context and tools are tuned (capability is not predictable from size).
  if (args.includes('--probe-local')) {
    try {
      const { ollamaAvailable, listModels, probeAgenticCoherence, probeStreamingToolCallLeak, modelDigest } = await import('../lib/ollama/provision-context.mjs');
      const { recordProbeResult } = await import('../lib/ollama/capability-store.mjs');
      // --probe-stream additionally drives a streaming turn and flags a tool-call
      // leaked into the text channel (`<function=…>`) — the artifact the buffered
      // probe cannot reproduce. It reloads each model, so it stays opt-in.
      const probeStream = args.includes('--probe-stream');
      if (!ollamaAvailable()) {
        add('Local-model probe: Ollama not available', false, true);
      } else {
        const models = listModels().filter((m) => !/embed/i.test(m));
        for (const m of models) {
          const r = await probeAgenticCoherence(m);
          if (r.ok) recordProbeResult(m, r, modelDigest(m));
          const verdict = r.ok ? (r.coherent ? `COHERENT (repeat ${r.repeatRatio})` : `COLLAPSED (repeat ${r.repeatRatio})`) : `error: ${r.reason}`;
          add(`Local probe ${m}: ${verdict}`, r.ok && r.coherent, true);
          if (probeStream && r.ok && r.coherent) {
            const s = await probeStreamingToolCallLeak(m);
            if (s.ok) add(`Stream probe ${m}: ${s.leaked ? `TOOL-CALL LEAK (${s.marker})` : 'clean (native tool_calls)'}`, !s.leaked, true);
          }
        }
        add('Quantization: prefer Q4_K_M+ — low quants are a known word-salad source', true, true);
        add('Verified agentic-capable locals: qwen3-coder:32k, devstral:24b', true, true);
      }
    } catch (err) {
      add(`Local-model probe failed: ${err.message}`, false, true);
    }
  }

  println('Construct Health Check');
  println('══════════════════════');
  println('');
  let okCount = 0; let warnCount = 0; let failCount = 0;
  for (const check of checks) {
    const symbol = check.pass ? '✓' : check.optional ? '⚠' : '✗';
    println(`  ${check.label.padEnd(40)} ${symbol}`);
    if (check.pass) okCount += 1;
    else if (check.optional) warnCount += 1;
    else failCount += 1;
  }

  if (reconcileDrift.length > 0) {
    println('');
    println('Reconciliation drift:');
    for (const task of reconcileDrift) {
      println(`  ⚠ ${task.id} (${task.safety})`);
      if (task.summary) println(`       ${task.summary}`);
      println(`       fix: construct sync --reconcile=${task.id}`);
    }
  }

  println('');
  println(`Results: ${okCount} passed, ${warnCount} warnings, ${failCount} failed`);
  if (firstRunReadinessLine) {
    println('');
    println(firstRunReadinessLine);
  }
  if (failCount > 0) process.exit(1);
}

// Resolve which services `construct dev` should start. Returns null (start
// everything) unless --only= or --select narrows it. Unknown --only keys fail
// loud rather than silently starting the wrong set; --select on a non-TTY is an
// error pointing at --only so scripts get a deterministic path.
async function resolveServiceSelection(args, selectable) {
  const validKeys = new Set(selectable.map((s) => s.key));
  const onlyArg = args.find((a) => a.startsWith('--only='));

  if (onlyArg) {
    const keys = onlyArg.slice('--only='.length).split(',').map((k) => k.trim()).filter(Boolean);
    const unknown = keys.filter((k) => !validKeys.has(k));
    if (unknown.length) {
      errorln(`Unknown service(s) for --only: ${unknown.join(', ')}`);
      errorln(`Valid services: ${[...validKeys].join(', ')}`);
      process.exit(1);
    }
    if (keys.length === 0) {
      errorln('--only requires at least one service.');
      process.exit(1);
    }
    return new Set(keys);
  }

  if (args.includes('--select')) {
    if (!process.stdin.isTTY) {
      errorln('--select needs an interactive terminal. Use --only=<a,b,c> in scripts.');
      errorln(`Valid services: ${[...validKeys].join(', ')}`);
      process.exit(1);
    }
    const { multiSelect } = await import('../lib/tty-prompts.mjs');
    try {
      const chosen = await multiSelect({
        title: 'Start which services?',
        instructions: 'Pressure Guard and Doctor always run. Space toggles, Enter confirms.',
        options: selectable.map((s) => ({ label: s.label, value: s.key, description: s.description, checked: true })),
      });
      if (!chosen.length) {
        errorln('No services selected — nothing to start.');
        process.exit(1);
      }
      return new Set(chosen);
    } catch {
      errorln('Service selection canceled.');
      process.exit(1);
    }
  }

  return null;
}

async function cmdDev(args = []) {
  const { SELECTABLE_SERVICES } = await import('../lib/service-manager.mjs');

  // --only=a,b,c picks services non-interactively; --select opens a checklist.
  // Both resolve to a Set of service keys (null = start everything).

  const selected = await resolveServiceSelection(args, SELECTABLE_SERVICES);

  const { startOpLog } = await import('../lib/op-log.mjs');
  const opLog = startOpLog('dev', { homeDir: HOME });
  opLog.event('selection', { services: selected ? [...selected] : 'all' });

  // Auto-magic health check — catch missing prerequisites before starting services
  const { quickHealthCheck, resolveCredentials } = await import('../lib/health-check.mjs');

  // Resolve credentials from env, .env files, and 1Password before starting services
  const resolvedCreds = await resolveCredentials({ homeDir: HOME });

  const health = await quickHealthCheck({ homeDir: HOME, showCredentials: true });
  opLog.event('prereq', { ok: health.ok, missing: health.missing ?? [] });

  if (!health.ok) {
    errorln('Prerequisites missing for starting services:');
    for (const item of health.missing) {
      errorln(`  ✗  ${item}`);
    }
    println('');
    info('Run `construct install --yes` to install missing dependencies.');
    opLog.close('failed', { reason: 'prerequisites-missing' });
    process.exit(1);
  }

  const { results, recovery } = await startServices({ rootDir: PROJECT_ROOT, homeDir: HOME, selected });
  opLog.event('services', { results: results.map((r) => ({ name: r.name, status: r.status })) });
  for (const svc of results) {
    const label = svc.url ? `${svc.name} → ${svc.url}` : svc.name;
    if (svc.status === 'started') ok(svc.note ? `${label} (${svc.note})` : label);
    else if (svc.status === 'reused') info(`${label} (already running)`);
    else if (svc.status === 'configured') info(`${svc.name}: ${svc.note}`);
    else if (svc.status === 'failed') errorln(`${svc.name}: ${svc.note}`);
    else warn(`${svc.name}: ${svc.note}`);
  }

  // Show Langfuse credentials guidance after first start
  const langfuseService = results.find(r => r.name === 'Langfuse');
  if (langfuseService && langfuseService.status === 'started' && langfuseService.note?.includes('auto-configured')) {
    println('');
    info('Langfuse credentials:');
    info('  Dashboard: http://localhost:54330 (login: admin@construct.local / construct-admin)');
    info('  API keys auto-saved to ~/.construct/config.env');
    info('  Run `construct status` anytime to view credentials');
  }

  if (recovery) {
    println('');
    info(`Recovery: ${recovery.message}`);
    const anchors = [
      recovery.durable?.plan,
      recovery.durable?.context,
      recovery.durable?.latestHandoff,
      recovery.durable?.beads,
    ].filter(Boolean);
    if (anchors.length) info(`Durable anchors: ${anchors.join(', ')}`);
    if (recovery.degraded?.length) {
      info(`Degraded services: ${recovery.degraded.map((entry) => `${entry.name} (${entry.status})`).join(', ')}`);
    }
  }
  
  // Auto-start embed daemon if embed.yaml exists and autoEmbed is enabled
  const { loadProjectConfig } = await import('../lib/config/project-config.mjs');
  const { existsSync } = await import('node:fs');
  const { join } = await import('node:path');
  
  const embedConfigExists = existsSync(join(PROJECT_ROOT, 'embed.yaml'));
  const config = loadProjectConfig(PROJECT_ROOT);
  const autoEmbed = config.config?.autoEmbed;

  if (embedConfigExists && autoEmbed) {
    try {
      const { runEmbedCli } = await import('../lib/embed/cli.mjs');
      await runEmbedCli(['start'], { rootDir: PROJECT_ROOT });
      opLog.event('embed', { status: 'started' });
    } catch (err) {
      warn(`embed start failed: ${err.message} — check ~/.cx/runtime/embed-daemon.log`);
      opLog.warn('embed', { status: 'failed', error: err.message });
    }
  }

  // Post-start summary
  println('');
  println('═══════════════════════════════════════════════════════════');
  println('  SERVICES RUNNING');
  println('═══════════════════════════════════════════════════════════');
  println('');
  for (const svc of results) {
    if (svc.status === 'started' || svc.status === 'reused') {
      const label = svc.url ? `${svc.url}` : svc.name;
      println(`  ${svc.name.padEnd(14)} ${label}`);
    }
  }

  // Show credentials summary
  const creds = health.credentials;
  const credKeys = Object.keys(resolvedCreds);
  if (creds || credKeys.length > 0) {
    const configured = [];
    if (creds.github_cli) configured.push('GitHub CLI');
    if (creds.copilot) configured.push('Copilot');
    if (creds.anthropic_key || credKeys.includes('ANTHROPIC_API_KEY')) configured.push('Anthropic');
    if (creds.openai_key || credKeys.includes('OPENAI_API_KEY')) configured.push('OpenAI');
    if (creds.openrouter_key || credKeys.includes('OPENROUTER_API_KEY')) configured.push('OpenRouter');
    if (creds.ollama) configured.push('Ollama');
    if (creds.vscode) configured.push('VS Code');
    if (creds.claude_code) configured.push('Claude Code');
    if (creds.opencode) configured.push('OpenCode');
    if (creds.github_token || credKeys.includes('GITHUB_TOKEN') || credKeys.includes('GH_TOKEN')) configured.push('GitHub token');

    if (configured.length > 0) {
      println('');
      println('  Credentials:');
      println(`  ${configured.join(', ')}`);
      if (credKeys.length > 0) {
        println(`  ${credKeys.length} key${credKeys.length === 1 ? '' : 's'} resolved`);
      }
    }
  }
  
  println('');
  println('Run \x1b[32mconstruct\x1b[0m for commands');
  println('');

  const failed = results.filter((r) => r.status === 'error' || r.status === 'failed');
  opLog.close(failed.length ? 'degraded' : 'ok', { failed: failed.map((r) => r.name) });
}

async function cmdStop() {
  const { stopServices } = await import('../lib/service-manager.mjs');
  const result = await stopServices({ homeDir: HOME, rootDir: ROOT_DIR });
  for (const svc of result.results) {
    if (svc.status === 'stopped') ok(`${svc.name} stopped${svc.note ? ` (${svc.note})` : ''}.`);
    else if (svc.status === 'cleaned') warn(`${svc.name}: ${svc.note}.`);
    else if (svc.status === 'error') errorln(`${svc.name}: ${svc.note}.`);
    else if (svc.status === 'skipped') info(`${svc.name}: skipped — ${svc.note}.`);
    else info(`${svc.name}: not running.`);
  }

  try {
    const { autoCleanHandoffs } = await import('../lib/handoffs/cleanup.mjs');
    const { result: cleanResult } = autoCleanHandoffs(process.cwd(), process.env);
    const total = (cleanResult.moved?.length || 0) + (cleanResult.deleted?.length || 0);
    if (total > 0) info(`Handoff cleanup: ${cleanResult.moved?.length || 0} archived, ${cleanResult.deleted?.length || 0} deleted.`);
  } catch { /* best effort */ }
}

async function cmdVersion() {
  const pkg = JSON.parse(fs.readFileSync(path.join(ROOT_DIR, 'package.json'), 'utf8'));
  println(`construct v${pkg.version}`);
}

async function cmdMigrate(args) {
  const dryRun = args.includes('--dry-run');
  const pathArg = args.find((a) => a.startsWith('--path='))?.split('=')[1];
  const fromArg = args.find((a) => a.startsWith('--from='))?.split('=')[1];
  const { runMigrations, planMigrations, CURRENT_SCHEMA_VERSION } = await import('../lib/migrations/index.mjs');

  const candidates = pathArg
    ? [pathArg]
    : [
        path.join(ROOT_DIR, 'specialists', 'unified-registry.json'),
        configPath(process.cwd(), 'config.json'),
      ];

  let anyFailed = false;
  for (const artifactPath of candidates) {
    if (!fs.existsSync(artifactPath)) continue;
    let from;
    try {
      const data = JSON.parse(fs.readFileSync(artifactPath, 'utf8'));
      from = typeof data?.version === 'number' ? data.version : Number(fromArg) || 0;
    } catch {
      println(`  ⚠  ${artifactPath}: parse error, skipping`);
      continue;
    }

    const plan = planMigrations(from, CURRENT_SCHEMA_VERSION);
    if (plan === null) {
      println(`  ✗  ${artifactPath}: no migration path from v${from} to v${CURRENT_SCHEMA_VERSION}`);
      anyFailed = true;
      continue;
    }
    if (plan.length === 0) {
      println(`  ✓  ${artifactPath}: already at v${CURRENT_SCHEMA_VERSION}`);
      continue;
    }

    println(`  ${dryRun ? '·' : '→'}  ${artifactPath}: ${plan.length} step(s) (v${from} → v${CURRENT_SCHEMA_VERSION})`);
    const result = await runMigrations({ artifactPath, fromVersion: from, dryRun });
    for (const step of result.applied) {
      println(`     v${step.from}→v${step.to}: ${step.summary}`);
    }
    if (!result.ok) {
      println(`  ✗  ${result.error}`);
      anyFailed = true;
    }
  }

  if (dryRun) println(`\n(dry-run — no files were written)`);
  if (anyFailed) process.exit(1);
}

async function cmdReview(args) {
  const sub = args[0];

  if (!sub || sub === 'run') {
    fs.mkdirSync(path.join(doctorRoot(), 'performance-reviews'), { recursive: true });
    const { runGenerator } = await import('../lib/performance/generate.mjs');
    const result = await runGenerator({ env: process.env });
    info(`Wrote ${result.filename} · ${result.agentCount} agent${result.agentCount === 1 ? '' : 's'}`);
    println(`  ${result.path}`);
    return;
  }

  if (sub === 'legacy') {
    fs.mkdirSync(path.join(doctorRoot(), 'performance-reviews'), { recursive: true });
    if (!ENV.CONSTRUCT_TELEMETRY_PUBLIC_KEY || !ENV.CONSTRUCT_TELEMETRY_SECRET_KEY) {
      errorln('Error: CONSTRUCT_TELEMETRY_PUBLIC_KEY and CONSTRUCT_TELEMETRY_SECRET_KEY must be set.');
      errorln('Configure telemetry credentials in ~/.construct/config.env or .env.');
      process.exit(1);
    }
    runNodeScript(path.join(ROOT_DIR, 'scripts', 'review.mjs'), args.slice(1), ENV);
    return;
  }

  if (sub === 'pr') {
    const { runReviewPrCli } = await import('../lib/review-pr.mjs');
    const { exitCode, error, result, json, outputPath } = runReviewPrCli(args.slice(1));
    if (error) {
      errorln(error);
      process.exit(exitCode);
    }
    if (outputPath) {
      info(`Wrote ${outputPath} · ${result.findings.length} finding${result.findings.length === 1 ? '' : 's'}`);
    } else {
      println(json);
    }
    return;
  }

  errorln('Usage: construct review [run|legacy|pr --base=<ref> [--output=<file>]]');
  process.exit(1);
}

