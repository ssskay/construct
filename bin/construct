}

async function cmdIntegrations(args) {
  const sub = args[0];
  if (sub === '--help' || sub === '-h') {
    println('construct integrations — check and manage external system integrations.');
    println('');
    println('Usage:');
    println('  construct integrations status    Check which integrations are configured');
    return;
  }

  if (sub === 'status') {
    const { detectIntegrationConfig } = await import('../lib/integrations/intake-integrations.mjs');
    const config = detectIntegrationConfig();
    println(`${COLORS.bold}Integration status:${COLORS.reset}`);
    const ghMethod = config.githubMethod === 'gh' ? ' (gh CLI)' : config.githubMethod === 'env' ? ' (env vars)' : '';
    const ghLabel = `GitHub Issues${ghMethod}`;
    if (config.github) {
      println(`  ${COLORS.green}✓${COLORS.reset} ${ghLabel} — repo: ${config.githubRepo}`);
    } else {
      println(`  ${COLORS.yellow}⚠${COLORS.reset} GitHub Issues not configured (run gh auth login, or set GITHUB_TOKEN)`);
    }
    println(`  ${config.jira ? COLORS.green + '✓' : COLORS.yellow + '⚠'}${COLORS.reset} Jira${config.jira ? ` — ${config.jiraHost}` : ' not configured'}`);
    println(`  ${config.confluence ? COLORS.green + '✓' : COLORS.yellow + '⚠'}${COLORS.reset} Confluence${config.confluence ? ` — ${config.confluenceSpace}` : ' not configured'}`);
    println('');
    println('Auth methods (tried in order):');
    println('  GitHub:    gh CLI → GITHUB_TOKEN env → .env → config.env → 1Password');
    println('  Jira/Conf: JIRA_/CONFLUENCE_ env → ~/.env → config.env → shell rc → 1Password');
    println('');
    println('Configure: construct intake integrate <id> <github|jira|confluence>');
    return;
  }

  errorln(`Unknown subcommand: ${sub}. Available: status`);
}

function printCustomerHelp() {
  println('');
  println('Construct customer — manage customer profiles for product intelligence.');
  println('');
  println('Usage:');
  println('  construct customer list                     List all customer profiles');
  println('  construct customer show <id>                Show detailed profile');
  println('  construct customer add --name=Acme [--owner=Jane] [--domain=acme.com]');
  println('  construct customer search <query>           Search by name, domain, or alias');
  println('  construct customer update <id> --status=inactive   Update profile status');
}

async function cmdCustomer(args) {
  const sub = args[0];
  if (!sub || sub === '--help' || sub === '-h') { printCustomerHelp(); return; }

  const { createCustomerProfile, getCustomerProfile, listCustomerProfiles, searchCustomerProfiles, updateCustomerProfile } = await import('../lib/embed/customer-profiles.mjs');

  if (sub === 'list') {
    const profiles = listCustomerProfiles();
    if (!profiles.length) { println('No customer profiles. Create one with: construct customer add --name=Acme'); return; }
    println(`${COLORS.bold}Customer profiles:${COLORS.reset}`);
    for (const p of profiles) {
      println(`  ${COLORS.cyan}${p.id}${COLORS.reset}  ${COLORS.bold}${p.name}${COLORS.reset}  [${p.status}]  ${p.workspace}  updated ${p.updatedAt?.slice(0, 10)}`);
    }
    return;
  }

  if (sub === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct customer show <id>'); process.exit(1); }
    const profile = getCustomerProfile(id);
    if (!profile) { errorln(`Customer profile not found: ${id}`); process.exit(1); }
    println(`ID:      ${profile.id}`);
    println(`Name:    ${profile.name}`);
    println(`Status:  ${profile.status}`);
    println(`Owner:   ${profile.owner}`);
    println(`Workspace: ${profile.workspace}`);
    println(`Updated: ${profile.updatedAt?.slice(0, 10) || '—'}`);
    return;
  }

  if (sub === 'add') {
    const name = args.find(a => a.startsWith('--name='))?.split('=').slice(1).join('=');
    const owner = args.find(a => a.startsWith('--owner='))?.split('=').slice(1).join('=');
    const domain = args.find(a => a.startsWith('--domain='))?.split('=').slice(1).join('=');
    if (!name) { errorln('Usage: construct customer add --name=Acme [--owner=Jane] [--domain=acme.com]'); process.exit(1); }
    const result = createCustomerProfile({ name, owner, domain });
    println(`Created customer profile: ${result.id} — ${result.profile.name}`);
    return;
  }

  if (sub === 'search') {
    const query = args.slice(1).join(' ');
    if (!query) { errorln('Usage: construct customer search <query>'); process.exit(1); }
    const results = searchCustomerProfiles(query);
    if (!results.length) { println('No matches.'); return; }
    for (const r of results) {
      println(`  ${r.id}  ${r.name}  [${r.status}]`);
    }
    return;
  }

  if (sub === 'update') {
    const id = args[1];
    const status = args.find(a => a.startsWith('--status='))?.split('=').slice(1).join('=');
    if (!id || !status) { errorln('Usage: construct customer update <id> --status=active|inactive|archived'); process.exit(1); }
    updateCustomerProfile(id, { status, changeLogEntry: `Status changed to ${status} via CLI` });
    println(`Updated: ${id}`);
    return;
  }

  errorln(`Unknown customer subcommand: ${sub}. Available: list, show, add, search, update`);
}

function printWorkspaceHelp() {
  println('');
  println('Construct workspace — manage PM workspaces for signal routing.');
  println('');
  println('Usage:');
  println('  construct workspace list                              List all workspaces');
  println('  construct workspace create --name=Auth --owner=Jane   Create a new workspace');
  println('  construct workspace show <id>                         Show workspace details');
  println('  construct workspace assign --customer=X --workspace=Y Assign customer to workspace');
}

async function cmdWorkspace(args) {
  const sub = args[0];
  if (!sub || sub === '--help' || sub === '-h') { printWorkspaceHelp(); return; }

  const { createWorkspace, getWorkspace, listWorkspaces } = await import('../lib/embed/workspaces.mjs');

  if (sub === 'list') {
    const workspaces = listWorkspaces();
    if (!workspaces.length) { println('No workspaces.'); return; }
    println(`${COLORS.bold}Workspaces:${COLORS.reset}`);
    for (const ws of workspaces) {
      println(`  ${COLORS.cyan}${ws.id}${COLORS.reset}  ${COLORS.bold}${ws.name}${COLORS.reset}  owner: ${ws.owner}  [${ws.status}]  areas: ${(ws.productAreas || []).join(', ') || '—'}`);
    }
    return;
  }

  if (sub === 'create') {
    const name = args.find(a => a.startsWith('--name='))?.split('=').slice(1).join('=');
    const owner = args.find(a => a.startsWith('--owner='))?.split('=').slice(1).join('=');
    const areas = args.find(a => a.startsWith('--areas='))?.split('=').slice(1).join('=')?.split(',') || [];
    if (!name || !owner) { errorln('Usage: construct workspace create --name=Auth --owner=Jane [--areas=auth,users]'); process.exit(1); }
    const result = createWorkspace({ name, owner, productAreas: areas });
    println(`Created workspace: ${result.id} — ${result.workspace.name}`);
    return;
  }

  if (sub === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct workspace show <id>'); process.exit(1); }
    const ws = getWorkspace(id);
    if (!ws) { errorln(`Workspace not found: ${id}`); process.exit(1); }
    println(`ID:          ${ws.id}`);
    println(`Name:        ${ws.name}`);
    println(`Owner:       ${ws.owner}`);
    println(`Status:      ${ws.status}`);
    println(`Product areas: ${(ws.productAreas || []).join(', ') || '—'}`);
    println(`Customers:   ${(ws.customerIds || []).join(', ') || '—'}`);
    return;
  }

  errorln(`Unknown workspace subcommand: ${sub}. Available: list, create, show`);
}

function printRecommendationsHelp() {
  println('');
  println('Construct recommendations — view and manage artifact recommendations.');
  println('');
  println('These are generated by the daemon\'s docs-lifecycle job based on intake');
  println('signals, snapshot analysis, and doc gap detection. Recommendations are');
  println('deduplicated, prioritized, and auto-suppressed after 7 days without new signals.');
  println('');
  println('Usage:');
  println('  construct recommendations list [--type=prd] [--priority=P0]');
  println('                                        List active recommendations, sorted by priority.');
  println('  construct recommendations stats       Show recommendation store stats.');
  println('  construct recommendations dismiss <type> <title> [--reason=…]');
  println('                                        Permanently dismiss a recommendation.');
  println('  construct recommendations dismiss <type> <title> --suppress-days=30');
  println('                                        Temporarily suppress a recommendation.');
}

async function cmdRecommendations(args) {
  const sub = args[0];
  if (!sub || sub === '--help' || sub === '-h') { printRecommendationsHelp(); return; }

  if (sub === 'list') {
    const typeFlag = args.find(a => a.startsWith('--type='))?.split('=')[1];
    const priorityFlag = args.find(a => a.startsWith('--priority='))?.split('=')[1];
    try {
      const { listActiveRecommendations, recommendationStats } = await import('../lib/embed/recommendation-store.mjs');
      const recs = listActiveRecommendations({ type: typeFlag, priority: priorityFlag, limit: 30 });
      if (!recs.length) {
        println('No active recommendations.');
        const stats = recommendationStats();
        println(`(${stats.total} total in store: ${stats.active} active, ${stats.dismissed} dismissed, ${stats.superseded} superseded)`);
        return;
      }
      println(`${COLORS.bold}Active recommendations:${COLORS.reset}`);
      for (const rec of recs) {
        const priorityColor = rec.priority === 'P0' ? COLORS.red : rec.priority === 'P1' ? COLORS.yellow : COLORS.reset;
        println(`  ${priorityColor}${rec.priority}${COLORS.reset} ${COLORS.bold}${rec.type.toUpperCase()}${COLORS.reset}: ${rec.title}`);
        println(`       Score: ${rec.score} · Signals: ${rec.totalSignalCount} · Impact: ${rec.customerImpact}/3 · ${rec.reason?.slice(0, 80)}`);
      }
      const stats = recommendationStats();
      println(`\n(${stats.active} active · ${stats.dismissed} dismissed · ${stats.superseded} superseded)`);
    } catch (err) {
      errorln(`Recommendations error: ${err.message}`);
    }
    return;
  }

  if (sub === 'stats') {
    try {
      const { recommendationStats } = await import('../lib/embed/recommendation-store.mjs');
      const stats = recommendationStats();
      println('Recommendation store:');
      println(`  Total:       ${stats.total}`);
      println(`  Active:      ${stats.active}`);
      println(`  Dismissed:   ${stats.dismissed}`);
      println(`  Superseded:  ${stats.superseded}`);
      println(`  By priority: ${JSON.stringify(stats.byPriority)}`);
      println(`  By type:     ${JSON.stringify(stats.byType)}`);
    } catch (err) {
      errorln(`Recommendations stats error: ${err.message}`);
    }
    return;
  }

  if (sub === 'dismiss') {
    const recType = args[1];
    const recTitle = args[2];
    if (!recType || !recTitle) {
      errorln('Usage: construct recommendations dismiss <type> <title> [--reason=…] [--suppress-days=N]');
      process.exit(1);
    }
    const reasonFlag = args.find(a => a.startsWith('--reason='))?.split('=').slice(1).join('=');
    const suppressDaysFlag = args.find(a => a.startsWith('--suppress-days='))?.split('=')[1];
    try {
      const key = `${recType}::${recTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 60)}`;
      const { dismissRecommendation } = await import('../lib/embed/recommendation-store.mjs');
      dismissRecommendation(key, {
        reason: reasonFlag || 'CLI dismiss',
        suppressDays: suppressDaysFlag ? Number(suppressDaysFlag) : undefined,
      });
      println(`Dismissed: ${recType} / ${recTitle}`);
    } catch (err) {
      errorln(`Dismiss error: ${err.message}`);
    }
    return;
  }

  errorln(`Unknown recommendations subcommand: ${sub}. Available: list, stats, dismiss`);
}

async function cmdGraph(args) {
  const sub = args[0];
  if (!sub || sub === '--help' || sub === '-h') { printGraphHelp(); return; }

  if (sub === 'recommend') {
    return await cmdEmbeddedTriage(args.slice(1));
  }

  const { FilesystemTaskGraphStore } = await import('../lib/task-graph/store.mjs');
  const { generateTaskGraphFromTriage } = await import('../lib/task-graph/generate.mjs');
  const cwd = process.cwd();
  const store = new FilesystemTaskGraphStore(cwd);

  if (sub === 'list') {
    const graphs = store.list();
    if (graphs.length === 0) { println('No task graphs.'); return; }
    println('Graph ID                                                Nodes  Triage');
    println('-'.repeat(80));
    for (const g of graphs) {
      const triage = g.triage ? `${g.triage.intakeType}/${g.triage.rdStage}` : '—';
      println(`${g.id.padEnd(56)}  ${String(g.nodes.length).padStart(5)}  ${triage}`);
    }
    return;
  }

  if (sub === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct graph show <graph-id>'); process.exit(1); }
    const g = store.read(id);
    if (!g) { errorln(`No graph: ${id}`); process.exit(1); }
    println(`Graph: ${g.id}`);
    println(`Created: ${g.createdAt}`);
    if (g.triage) println(`Triage: ${g.triage.intakeType} / ${g.triage.rdStage} · owner ${g.triage.primaryOwner}`);
    if (g.intake?.sourcePath) println(`Source: ${g.intake.sourcePath}`);
    if (g.verificationRequirements?.length) println(`Verification: ${g.verificationRequirements.join(', ')}`);
    println('');
    println('Nodes:');
    for (const node of g.nodes) {
      const deps = (node.dependsOn || []).length > 0 ? ` ← ${node.dependsOn.length} dep(s)` : '';
      println(`  [${node.status.padEnd(11)}] ${node.title}${deps}`);
      if ((node.evidence || []).length > 0) {
        for (const ev of node.evidence) println(`    evidence: ${typeof ev === 'string' ? ev : JSON.stringify(ev)}`);
      }
    }
    if ((g.edges || []).length > 0) {
      println('');
      println(`Edges: ${g.edges.length}`);
    }
    return;
  }

  if (sub === 'from-intake') {
    const intakeId = args[1];
    if (!intakeId) { errorln('Usage: construct graph from-intake <intake-id>'); process.exit(1); }
    const { createIntakeQueue } = await import('../lib/intake/queue.mjs');
    const queue = createIntakeQueue(cwd, process.env);
    const entry = await queue.read(intakeId);
    if (!entry) { errorln(`No intake packet: ${intakeId}`); process.exit(1); }
    const graph = generateTaskGraphFromTriage({
      triage: entry.triage,
      project: path.basename(path.resolve(cwd)),
      request: entry.excerpt || '',
      intake: entry.intake,
    });
    const r = store.save(graph);
    info(`Generated ${graph.nodes.length}-node graph ${r.id}`);
    println(`Wrote: ${r.filePath}`);
    return;
  }

  if (sub === 'status') {
    const graphId = args[1];
    const nodeId = args[2];
    const status = args[3];
    if (!graphId || !nodeId || !status) {
      errorln('Usage: construct graph status <graph-id> <node-id> <status> [--evidence=…]');
      process.exit(1);
    }
    const flags = parseKvFlags(args.slice(4), ['evidence']);
    try {
      const patch = flags.evidence ? { addEvidence: flags.evidence } : {};
      const updated = store.updateNodeStatus(graphId, nodeId, status, patch);
      info(`Updated ${nodeId} → ${updated.status}`);
    } catch (err) {
      errorln(err.message || 'status update failed');
      process.exit(1);
    }
    return;
  }

  errorln(`Unknown graph subcommand: ${sub}. Available: list, show, from-intake, status`);
  process.exit(1);
}

function printFlowHelp() {
  println('Construct flow — resume a checkpointed flow-engine run (ADR-0067).');
  println('');
  println('Usage:');
  println('  construct flow resume <run-id> --flow=<path> [--state=<json>]');
  println('                                                  Resume <run-id> from its last checkpoint (or start it if none');
  println('                                                  exists yet) and drive it to completion. <path> loads a JS');
  println('                                                  flow module (default export from defineFlow). --state supplies');
  println('                                                  the initial state as a JSON string, used only when starting fresh.');
  println('  construct flow status <run-id>                  Print a checkpoint\'s persisted status without driving it.');
}

async function cmdFlow(args) {
  const sub = args[0];
  if (!sub || sub === '--help' || sub === '-h') { printFlowHelp(); return; }

  const { loadCheckpoint, runCheckpointed } = await import('../lib/flows/checkpoint.mjs');
  const cwd = process.cwd();

  if (sub === 'status') {
    const runId = args[1];
    if (!runId) { errorln('Usage: construct flow status <run-id>'); process.exit(1); }
    const checkpoint = loadCheckpoint(cwd, runId);
    if (!checkpoint) { errorln(`No checkpoint for run "${runId}".`); process.exit(1); }
    println(`Run: ${checkpoint.runId}`);
    println(`Flow: ${checkpoint.flowId ?? '(unnamed)'}`);
    println(`Updated: ${checkpoint.updatedAt}`);
    println(`Status: ${checkpoint.run.status}`);
    println(`Completed steps: ${checkpoint.run.completed.join(', ') || '(none)'}`);
    println(`Frontier: ${checkpoint.run.frontier.join(', ') || '(empty)'}`);
    return;
  }

  if (sub === 'resume') {
    const runId = args[1];
    const flags = parseKvFlags(args.slice(2), ['flow', 'state']);
    if (!runId || !flags.flow) { errorln('Usage: construct flow resume <run-id> --flow=<path> [--state=<json>]'); process.exit(1); }
    const { loadFlow } = await import('../lib/flows/define.mjs');
    let flow;
    try {
      flow = await loadFlow(path.resolve(cwd, flags.flow));
    } catch (err) {
      errorln(`construct flow resume: failed to load flow "${flags.flow}": ${err.message}`);
      process.exit(1);
    }
    let initialState = {};
    if (flags.state) {
      try {
        initialState = JSON.parse(flags.state);
      } catch (err) {
        errorln(`construct flow resume: --state is not valid JSON: ${err.message}`);
        process.exit(1);
      }
    }
    const existed = Boolean(loadCheckpoint(cwd, runId));
    const run = await runCheckpointed(cwd, runId, flow, initialState);
    info(`${existed ? 'Resumed' : 'Started'} run ${runId} (flow "${flow.id ?? '(unnamed)'}")`);
    println(`Status: ${run.status}`);
    println(`Steps completed (cumulative): ${run.history.length}`);
    if (run.status === 'error' || run.status === 'budget-exhausted') {
      println(`Error: ${JSON.stringify(run.error)}`);
      process.exit(1);
    }
    return;
  }

  errorln(`Unknown flow subcommand: ${sub}. Available: resume, status`);
  process.exit(1);
}

async function cmdConfig(args) {
  const sub = args[0];

  if (!sub || sub === '--help' || sub === '-h') {
    if (!sub) { printActiveConfig(); return; }
    printConfigModeHelp();
    return;
  }

  if (sub === 'mode') {
    const value = args[1];

    if (!value) {
      println(getDeploymentMode(process.env));
      return;
    }

    if (value === '--help' || value === '-h') { printConfigModeHelp(); return; }

    // Setter consolidated into `construct config set`. Refuse here with a one-line redirect
    // so users learn the single canonical setter instead of two slightly-divergent paths.
    errorln(`\`construct config mode <value>\` is no longer a setter. Use the single canonical path:`);
    errorln(`  construct config set deployment.mode ${value}`);
    errorln('');
    errorln('For ephemeral runtime overrides (CI, scripts), export CX_DEPLOYMENT_MODE instead.');
    process.exit(1);
  }

  if (sub === 'init') {
    try {
      const filePath = initProjectConfig(process.cwd());
      info(`Created ${filePath}`);
    } catch (err) {
      errorln(err.message);
      process.exit(1);
    }
    return;
  }

  if (sub === 'show') {
    const { path: cfgPath, config, source, errors } = loadProjectConfig(process.cwd(), process.env);
    if (errors.length) {
      errorln(`Config has ${errors.length} error${errors.length === 1 ? '' : 's'}:`);
      for (const e of errors) errorln(`  - ${e}`);
    }
    println(`# source: ${source}${cfgPath ? ` (${cfgPath})` : ''}`);
    println(JSON.stringify(config, null, 2));
    return;
  }

  if (sub === 'get') {
    const keyPath = args[1];
    if (!keyPath) { errorln('Usage: construct config get <dotted.key>'); process.exit(1); }
    const { config } = loadProjectConfig(process.cwd(), process.env);
    const value = getConfigValue(config, keyPath, null);
    println(value === null ? '' : (typeof value === 'string' ? value : JSON.stringify(value)));
    return;
  }

  if (sub === 'set') {
    const keyPath = args[1];
    const rawValue = args[2];
    if (!keyPath || rawValue === undefined) {
      errorln('Usage: construct config set <dotted.key> <value>');
      process.exit(1);
    }
    let parsedValue = rawValue;
    if (rawValue === 'true') parsedValue = true;
    else if (rawValue === 'false') parsedValue = false;
    else if (rawValue === 'null') parsedValue = null;
    else if (!Number.isNaN(Number(rawValue)) && rawValue.trim() !== '') parsedValue = Number(rawValue);
    const cfgPath = findProjectConfigPath(process.cwd()) || path.join(process.cwd(), PROJECT_CONFIG_FILENAME);
    const { config } = loadProjectConfig(process.cwd(), process.env);
    const next = setConfigValue(config, keyPath, parsedValue);
    try {
      writeProjectConfig(cfgPath, next);
      info(`set ${keyPath} = ${JSON.stringify(parsedValue)} in ${cfgPath}`);
    } catch (err) {
      errorln(err.message);
      process.exit(1);
    }
    return;
  }

  if (sub === 'validate') {
    const cfgPath = findProjectConfigPath(process.cwd());
    if (!cfgPath) {
      info(`no ${PROJECT_CONFIG_FILENAME} found — using defaults`);
      return;
    }
    let raw;
    try { raw = JSON.parse(fs.readFileSync(cfgPath, 'utf8')); }
    catch (err) { errorln(`parse error: ${err.message}`); process.exit(1); }
    const result = validateProjectConfig(raw);
    if (result.valid) {
      info(`${cfgPath} is valid`);
      return;
    }
    errorln(`${cfgPath} has ${result.errors.length} error${result.errors.length === 1 ? '' : 's'}:`);
    for (const e of result.errors) errorln(`  - ${e}`);
    process.exit(1);
  }

  errorln(`Unknown config subcommand: ${sub}. Available: mode, init, show, get, set, validate`);
  process.exit(1);
}
async function cmdUninstall(args) {
  try {
    const result = await runUninstall(args);
    if (result?.canceled) process.exit(130);
  } catch (err) {
    errorln(err?.message || 'uninstall failed');
    process.exit(1);
  }
}

async function cmdUpdate() {
  try {
    runUpdate({ cwd: process.cwd(), env: process.env, stdout: process.stdout });
  } catch (error) {
    errorln(error?.message || 'construct update failed');
    process.exit(1);
  }
}

async function cmdUpgrade(args) {
  try {
    const yes = args.includes('--yes');
    const result = runUpgrade({ cwd: process.cwd(), env: process.env, stdout: process.stdout, yes });
    if (!result.success) process.exit(1);
  } catch (error) {
    errorln(error?.message || 'construct upgrade failed');
    process.exit(1);
  }
}
async function cmdValidate() {
  const reg = loadRegistry({ rootDir: ROOT_DIR });
  const result = validateRegistry(reg, { rootDir: ROOT_DIR });
  if (result.valid) {
    println(`✓ Registry valid (${result.summary})`);
    return;
  }
  if (!result.valid) result.errors.forEach((e, i) => errorln(`${i + 1}. ${e}`));
  process.exit(1);
}

async function cmdExecution(args) {
  if (args[0] === 'resolve') {
    const flag = (name) => { const i = args.indexOf(name); return i !== -1 ? args[i + 1] : undefined; };
    const { resolveExecution } = await import('../lib/embedded-contract/execution.mjs');
    const { wrapContractResult } = await import('../lib/embedded-contract/envelope.mjs');
    const request = {
      workflowType: flag('--workflow-type'),
      requestedStrategy: flag('--strategy'),
      useConstruct: !args.includes('--no-construct'),
      host: flag('--host'),
      hostModel: flag('--host-model'),
      hostProvider: flag('--host-provider'),
      requestedTier: flag('--tier'),
      capabilities: flag('--capabilities')?.split(',').map((s) => s.trim()).filter(Boolean),
      allowCrossProviderFallback: args.includes('--allow-cross-provider'),
    };
    const envelope = wrapContractResult(resolveExecution(request), { surface: 'cli' });
    println(JSON.stringify(envelope, null, 2));
    return;
  }
  println('Usage: construct execution resolve [--workflow-type T] [--strategy orchestrated|prompt-only|auto] [--host-model M] [--host-provider P] [--tier reasoning|standard|fast] [--no-construct] [--allow-cross-provider] [--json]');
}

// Human-readable summary of a shaped run's routePath (construct-d1r7.15) —
// shared by `orchestrate run` and `orchestrate status <id>` so both print the
// same team/specialist/rationale line rather than drifting formats.

function printRoutePath(routePath) {
  if (!routePath) return;
  const team = (routePath.teamPath || []).join(' > ') || 'none';
  const sequence = (routePath.specialistSequence || []).join(' → ') || 'none';
  println(`  route: team=${team} · specialists=${sequence}`);
  if (routePath.rationale) println(`  rationale: ${routePath.rationale}`);
}

async function cmdOrchestrate(args) {
  const sub = args[0];
  const rest = args.slice(1);
  const flag = (name) => { const i = rest.indexOf(name); return i !== -1 ? rest[i + 1] : undefined; };
  const eqFlag = (name) => {
    const hit = rest.find((arg) => arg.startsWith(`${name}=`));
    return hit ? hit.slice(name.length + 1) : flag(name);
  };
  const wantsJson = rest.includes('--json') || args.includes('--json');

  if (sub === 'preflight') {
    const { buildOrchestrationReadiness, recordOrchestrationReadinessEvent, summarizeOrchestrationReadiness } = await import('../lib/orchestration/readiness.mjs');
    const { probeStdioMcpTools } = await import('../lib/mcp/stdio-mcp-probe.mjs');
    const splitCsv = (value) => value ? String(value).split(',').map((s) => s.trim()).filter(Boolean) : undefined;
    const timeoutMs = Number(eqFlag('--timeout-ms') || 8000);
    let observedTools = splitCsv(eqFlag('--observed-tools'));
    let reachableTools = splitCsv(eqFlag('--reachable-tools'));
    const callerSuppliedObservations = Boolean(observedTools || reachableTools);
    let probeError = null;

    if (!rest.includes('--no-probe') && !observedTools && !reachableTools) {
      try {
        const tools = await probeStdioMcpTools(process.execPath, [path.join(ROOT_DIR, 'lib', 'mcp', 'server.mjs')], {
          env: { CX_TOOLKIT_DIR: ROOT_DIR },
          timeoutMs: Number.isFinite(timeoutMs) && timeoutMs > 0 ? timeoutMs : 8000,
        });
        observedTools = tools.map((tool) => tool.name);
        reachableTools = tools.flatMap((tool) => (
          tool.name === 'call' ? (tool.inputSchema?.properties?.tool?.enum ?? []) : []
        ));
      } catch (err) {
        probeError = err.message || String(err);
      }
    }

    const readiness = buildOrchestrationReadiness({
      host: eqFlag('--host'),
      sessionId: eqFlag('--session-id'),
      observedTools,
      reachableTools,
      requiredTools: splitCsv(eqFlag('--required-tools')),
      clientContractVersion: eqFlag('--client-contract-version'),
      observationScope: eqFlag('--observation-scope') || (callerSuppliedObservations ? 'host-session' : (observedTools || reachableTools ? 'local-probe' : 'local-config')),
      probeError,
      authRequired: rest.includes('--auth-required'),
    }, { env: process.env, cwd: process.cwd() });
    let eventResult = null;
    try { eventResult = recordOrchestrationReadinessEvent(readiness, { homeDir: HOME }); } catch { /* telemetry must not break preflight */ }

    // Opt-in deep credential check (construct-1yhp.5). Default preflight stays
    // presence-first — `--deep` performs the real network auth probe, only for
    // providers the presence-based catalog already marks configured.
    let deepProbes = null;
    if (rest.includes('--deep')) {
      try {
        const { getProviderModelCatalog } = await import('../lib/model-router.mjs');
        const { probeProviderConnection } = await import('../lib/providers/connection-probe.mjs');
        const { providers } = getProviderModelCatalog({ env: process.env });
        const probeable = providers.filter((p) => p.configured && ['openrouter', 'anthropic', 'openai'].includes(p.id));
        deepProbes = [];
        for (const p of probeable) {
          const result = await probeProviderConnection(p.id, { env: process.env, cwd: process.cwd() });
          deepProbes.push({ provider: p.id, ...result });
        }
      } catch (err) {
        deepProbes = { error: err.message };
      }
    }

    if (wantsJson) {
      println(JSON.stringify({ ...readiness, eventPath: eventResult?.path ?? null, deepProbes }, null, 2));
      process.exit(readiness.attached ? 0 : 1);
    }

    println(summarizeOrchestrationReadiness(readiness));
    println(`Reason: ${readiness.reasonCode}`);
    println(`Next: ${readiness.nextStep}`);
    const modelLine = MODEL_TIERS
      .map((tier) => `${tier}=${readiness.modelResolved?.[tier] ? 'resolved' : 'unresolved'}`)
      .join(' ');
    println(`Execution: workerBackend=${readiness.workerBackend} webMode=${readiness.webMode} credentialMaterializable=${readiness.credentialMaterializable} (${modelLine})`);
    if (Array.isArray(deepProbes)) {
      if (deepProbes.length === 0) println('Deep provider probe: no presence-configured openrouter/anthropic/openai provider to probe.');
      for (const probe of deepProbes) {
        if (probe.ok) println(`Deep provider probe — ${probe.provider}: auth-verified (SERVING)`);
        else println(`Deep provider probe — ${probe.provider}: ${probe.code}${probe.status ? ` (${probe.status})` : ''} (unverified/failing)`);
      }
    }
    println(`Diagnostic id: ${readiness.diagnosticBundle?.diagnosticId}`);
    process.exit(readiness.attached ? 0 : 1);
  }

  // Thin-client mode: drive the local orchestration daemon over HTTP instead of
  // running in-process, proving the engine-as-service contract editors/CI use.
  if (rest.includes('--remote')) {
    const remoteVal = flag('--remote');
    const base = (remoteVal && /^https?:\/\//.test(remoteVal)) ? remoteVal.replace(/\/$/, '') : (process.env.CONSTRUCT_ORCHESTRATION_URL || '').replace(/\/$/, '');
    if (!base) { errorln('No orchestration service configured. Pass --remote <url> or set CONSTRUCT_ORCHESTRATION_URL.'); process.exit(1); }
    const token = process.env.CONSTRUCT_ORCHESTRATION_TOKEN || process.env.CONSTRUCT_DASHBOARD_TOKEN || null;
    const headers = { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) };
    const positional = rest.filter((a) => !a.startsWith('--'));
    try {
      if (sub === 'run') {
        const text = flag('--text') || positional.join(' ').trim();
        if (!text) { errorln('Usage: construct orchestrate run "<request>" --remote [--strategy S] [--worker-backend provider] [--json]'); process.exit(1); }
        if (flag('--worker-backend') === 'host') {
          errorln('--worker-backend=host requires an attached MCP host session to execute the materialized prompts and submit results back — the CLI (including --remote) has no such session. Use --worker-backend=inline or --worker-backend=provider, or invoke orchestration_run through an MCP host instead.');
          process.exit(1);
        }
        const res = await fetch(`${base}/api/orchestration/runs`, { method: 'POST', headers, body: JSON.stringify({ request: text, workflowType: flag('--workflow-type'), requestedStrategy: flag('--strategy') || 'auto', host: flag('--host'), hostModel: flag('--host-model'), hostProvider: flag('--host-provider'), workerBackend: flag('--worker-backend'), fileCount: Number(flag('--file-count') || 0), moduleCount: Number(flag('--module-count') || 0) }) });
        const env = await res.json();
        if (!res.ok) { errorln(`Daemon error (${res.status}): ${env.error || 'unknown'}`); process.exit(1); }
        if (wantsJson) { println(JSON.stringify(env.data, null, 2)); return; }
        // AP5.4: the remote payload is subject to the same honest terminal-status
        // taxonomy as a local run (see the `status --remote` branch below) — shape
        // it before printing so a prepare-only remote run reports the same way.
        const { shapeRun: shapeRemoteRun } = await import('../lib/mcp/tools/orchestration-run.mjs');
        const remoteShaped = shapeRemoteRun(env.data);
        println(`Run ${env.data.runId} started on ${base} — ${remoteShaped.status} · executionMode=${env.data.execution?.executionMode}. Poll: construct orchestrate status ${env.data.runId} --remote`);
        if (remoteShaped.message) println(`  ${remoteShaped.message}`);
        return;
      }
      if (sub === 'status') {
        const { shapeRun } = await import('../lib/mcp/tools/orchestration-run.mjs');
        const runId = positional[0];
        const path = runId ? `/api/orchestration/runs/${encodeURIComponent(runId)}` : '/api/orchestration/runs';
        const res = await fetch(`${base}${path}`, { headers });
        const env = await res.json();
        if (!res.ok) { errorln(`Daemon error (${res.status}): ${env.error || 'unknown'}`); process.exit(1); }
        if (wantsJson) { println(JSON.stringify(env.data, null, 2)); return; }
        if (runId) {
          // AP5.4: a remote run payload is just as subject to the honest
          // terminal-state taxonomy as a local one — never echo its raw status.
          const shaped = shapeRun(env.data);
          println(`Run ${env.data.runId} — ${shaped.status} · executionMode=${shaped.executionMode}${shaped.degraded ? ` · degraded: ${shaped.degradationReason}` : ''}`);
          printRoutePath(shaped.routePath);
          for (const t of env.data.tasks || []) println(`  ${t.id} ${t.role} — ${t.status}${t.output ? ` (${t.output.length} chars)` : ''}`);
        } else {
          for (const r of env.data.runs || []) {
            const shaped = shapeRun(r);
            println(`  ${r.runId} — ${shaped.status}${shaped.degraded ? ' (degraded)' : ''} · ${shaped.executionMode || r.executionMode || ''} · ${r.createdAt}`);
          }
        }
        return;
      }
    } catch (err) {
      errorln(`Could not reach the orchestration service at ${base}: ${err.message}. Check CONSTRUCT_ORCHESTRATION_URL.`);
      process.exit(1);
    }
  }

  if (sub === 'run') {
    const { runOrchestration, planRun, hostAdapterMetadata } = await import('../lib/orchestration/runtime.mjs');
    const { shapeRun } = await import('../lib/mcp/tools/orchestration-run.mjs');
    const positional = rest.filter((a, i) => !a.startsWith('--') && !(i > 0 && rest[i - 1].startsWith('--') && !['--no-construct', '--no-execute', '--json'].includes(rest[i - 1])));
    const text = flag('--text') || positional.join(' ').trim();
    if (!text) { errorln('Usage: construct orchestrate run "<request>" [--workflow-type T] [--strategy orchestrated|prompt-only|auto] [--context id[:role],...] [--host H] [--host-model M] [--no-construct] [--no-execute] [--json]'); process.exit(1); }
    const cliWorkerBackend = flag('--worker-backend');
    // The host worker backend materializes prompts for an attached MCP host
    // session to execute and submit back via orchestration_task_result — a
    // bare CLI invocation has no such session on the other end, so a run
    // planned this way would stand at 'awaiting-host' forever with nobody to
    // submit results. Fail loud here instead of producing that silent
    // abandoned run (LMCP host-execution).
    if (cliWorkerBackend === 'host') {
      errorln('--worker-backend=host requires an attached MCP host session to execute the materialized prompts and submit results back — the CLI has no such session. Use --worker-backend=inline (prepare only) or --worker-backend=provider (needs a provider key), or invoke orchestration_run through an MCP host instead.');
      process.exit(1);
    }
    // --context=id[:role],id[:role] binds the run to registered source targets;
    // an unknown id is rejected at plan time (below), never a silent skip. Accept
    // both `--context=…` and `--context …` since the epic UX documents the former
    // while sibling orchestrate flags use the latter.
    const contextInline = rest.find((a) => a.startsWith('--context='));
    const contextFlag = contextInline ? contextInline.slice('--context='.length) : flag('--context');
    const contextTargets = contextFlag
      ? contextFlag.split(',').map((s) => s.trim()).filter(Boolean).map((entry) => {
          const colon = entry.indexOf(':');
          return colon === -1 ? { id: entry } : { id: entry.slice(0, colon), role: entry.slice(colon + 1) || undefined };
        })
      : undefined;

    const request = {
      request: text,
      workflowType: flag('--workflow-type'),
      requestedStrategy: flag('--strategy') || 'auto',
      useConstruct: !rest.includes('--no-construct'),
      host: flag('--host'),
      hostModel: flag('--host-model'),
      hostProvider: flag('--host-provider'),
      workerBackend: cliWorkerBackend,
      fileCount: Number(flag('--file-count') || 0),
      moduleCount: Number(flag('--module-count') || 0),
      contextTargets,
    };
    // runOrchestration/executeRun resolve the worker backend from opts.workerBackend,
    // not from request — the flag must reach opts explicitly or an override is silently
    // dropped (construct-1xlz).

    const runOpts = cliWorkerBackend ? { workerBackend: cliWorkerBackend } : {};
    let run;
    try {
      run = rest.includes('--no-execute') ? await planRun(request, runOpts) : await runOrchestration(request, runOpts);
    } catch (err) {
      if (err?.code === 'CONTEXT_TARGET_UNKNOWN') { errorln(err.message); process.exit(1); }
      throw err;
    }
    if (wantsJson) { println(JSON.stringify(hostAdapterMetadata(run), null, 2)); return; }

    // AP5.1/AP5.4: the CLI must never print the raw persisted status — a
    // pre-taxonomy run record can still carry a bare 'completed' despite being
    // degraded or prepare-only, so route through the same honest read-model
    // (shapeRun) the MCP orchestration_status tool uses.
    const shaped = shapeRun(run);
    println(`Run ${run.runId} — ${shaped.status} · executionMode=${shaped.executionMode} · backend=${run.workerBackend} · hostRole=${run.hostRole}`);
    if (shaped.degraded) println(`  degraded: ${shaped.degradationReason}`);
    // construct-vzg2i.2: shapeRun's message field carries the loud prepare-only
    // statement + exact next step so it never sits only in run metadata a
    // caller has to know to check.
    if (shaped.message) println(`  ${shaped.message}`);
    printRoutePath(shaped.routePath);
    if (run.tasks.length) println(`  tasks: ${run.tasks.map((t) => `${t.role}(${t.status})`).join(' → ')}`);
    else println('  tasks: none (no Construct-owned specialist sequence for this execution mode)');
    if (run.contextBindings?.length) {
      println(`  context: ${run.contextBindings.map((b) => `${b.id}[${b.provider}${b.role ? `:${b.role}` : ''}]${b.contentRoot ? '✓' : ''}`).join(', ')}`);
    }
    for (const t of run.tasks) {
      if (t.reasoning) println(`  ↳ ${t.role} reasoning: ${t.reasoning.length > 300 ? `${t.reasoning.slice(0, 300)}…` : t.reasoning}`);
    }
    return;
  }

  if (sub === 'status') {
    const { getRun, getRuns, hostAdapterMetadata } = await import('../lib/orchestration/runtime.mjs');
    const { shapeRun } = await import('../lib/mcp/tools/orchestration-run.mjs');
    const runId = rest.find((a) => !a.startsWith('--'));
    if (runId) {
      const run = await getRun(process.cwd(), runId);
      if (!run) { errorln(`Run not found: ${runId}`); process.exit(1); }
      if (wantsJson) { println(JSON.stringify(hostAdapterMetadata(run), null, 2)); return; }
      const shaped = shapeRun(run);
      println(`Run ${run.runId} — ${shaped.status} · executionMode=${shaped.executionMode}${shaped.degraded ? ` · degraded: ${shaped.degradationReason}` : ''}`);
      printRoutePath(shaped.routePath);
      for (const t of run.tasks) {
        println(`  ${t.id} ${t.role} — ${t.status}`);
        if (t.reasoning) println(`    reasoning: ${t.reasoning.length > 300 ? `${t.reasoning.slice(0, 300)}…` : t.reasoning}`);
      }
      return;
    }
    const runs = await getRuns(process.cwd());
    if (wantsJson) { println(JSON.stringify(runs, null, 2)); return; }
    if (!runs.length) { println('No orchestration runs recorded.'); return; }
    for (const r of runs) {
      const shaped = shapeRun(r);
      println(`  ${r.runId} — ${shaped.status}${shaped.degraded ? ' (degraded)' : ''} · ${shaped.executionMode || r.executionMode || ''} · ${r.createdAt}`);
    }
    return;
  }

  println('Usage: construct orchestrate <run|status|preflight> [options]');
  println('  run "<request>" [--workflow-type T] [--strategy S] [--host H] [--host-model M] [--no-construct] [--no-execute] [--json]');
  println('  status [run-id] [--json]');
  println('  preflight [--host H] [--json] [--no-probe] [--observed-tools=a,b] [--reachable-tools=a,b]');
}

async function cmdDb(args) {
  const sub = args[0] || 'status';
  const wantsJson = args.includes('--json');
  const sql = createSqlClient(process.env);

  async function finish(code = 0) {
    await closeSqlClient(sql);
    if (code) process.exit(code);
  }

  if (!sql) {
    const result = {
      status: 'unavailable',
      reason: 'sql-client-unavailable',
      message: 'Set DATABASE_URL or CONSTRUCT_DATABASE_URL and install optional dependency "postgres".',
      migrations: [],
    };
    if (wantsJson) println(JSON.stringify(result, null, 2));
    else {
      println('Database unavailable.');
      println(`Reason: ${result.message}`);
    }
    return finish(1);
  }

  try {
    const { probeSqlClient } = await import('../lib/storage/backend.mjs');
    const { getMigrationStatus, applyMigrations } = await import('../lib/db/migrate.mjs');
    const probe = await probeSqlClient(sql);
    if (probe.status !== 'available') {
      const result = { status: probe.status, reason: 'postgres-unavailable', message: probe.message, migrations: [] };
      if (wantsJson) println(JSON.stringify(result, null, 2));
      else {
        println('Database unavailable.');
        println(`Reason: ${probe.message}`);
      }
      return finish(1);
    }

    if (sub === 'status') {
      const migrations = await getMigrationStatus(sql);
      const result = {
        status: 'available',
        pending: migrations.filter((m) => !m.applied).map((m) => m.id),
        migrations: migrations.map((m) => ({ id: m.id, applied: m.applied })),
      };
      if (wantsJson) println(JSON.stringify(result, null, 2));
      else {
        println(`Database available. ${result.pending.length} pending migration${result.pending.length === 1 ? '' : 's'}.`);
        for (const migration of result.migrations) println(`  ${migration.applied ? 'applied' : 'pending'} ${migration.id}`);
      }
      return finish(0);
    }

    if (sub === 'migrate') {
      const result = await applyMigrations(sql);
      const output = {
        status: 'available',
        applied: result.applied,
        pending: result.status.filter((m) => !m.applied).map((m) => m.id),
        migrations: result.status.map((m) => ({ id: m.id, applied: m.applied })),
      };
      if (wantsJson) println(JSON.stringify(output, null, 2));
      else {
        println(`Applied ${output.applied.length} migration${output.applied.length === 1 ? '' : 's'}.`);
        for (const id of output.applied) println(`  ${id}`);
      }
      return finish(0);
    }

    errorln('Usage: construct db <status|migrate> [--json]');
    return finish(1);
  } catch (err) {
    await closeSqlClient(sql);
    errorln(err?.message || String(err));
    process.exit(1);
  }
}

async function cmdModels(args) {
  const envPath = getUserEnvPath(HOME);
  const sub = args[0] && !args[0].startsWith('-') ? args[0] : null;
  const KNOWN_SUBCOMMANDS = new Set(['list', 'set', 'free', 'reset', 'resolve', 'policy', 'explain']);
  if (sub && !KNOWN_SUBCOMMANDS.has(sub)) {
    errorln(`Unknown models subcommand: ${sub}. Run \`construct models --help\` for the supported set.`);
    process.exit(1);
  }

  if (sub === 'policy') {
    await cmdModelsPolicy(args.slice(1));
    return;
  }

  if (sub === 'explain') {
    await cmdModelsExplain(args.slice(1));
    return;
  }

  if (sub === 'resolve') {
    const flag = (name) => { const i = args.indexOf(name); return i !== -1 ? args[i + 1] : undefined; };
    const { resolveEmbeddedModel } = await import('../lib/embedded-contract/model-resolve.mjs');
    const { wrapContractResult } = await import('../lib/embedded-contract/envelope.mjs');
    const request = {
      workflowType: flag('--workflow-type'),
      requestedTier: flag('--tier'),
      host: flag('--host'),
      hostModel: flag('--host-model'),
      hostProvider: flag('--host-provider'),
      capabilities: flag('--capabilities')?.split(',').map((s) => s.trim()).filter(Boolean),
      allowCrossProviderFallback: args.includes('--allow-cross-provider'),
    };
    const envelope = wrapContractResult(resolveEmbeddedModel(request), { surface: 'cli' });
    println(JSON.stringify(envelope, null, 2));
    return;
  }
  // Legacy flag forms stay as compatibility aliases for the documented
  // subcommands. Each emits a one-line deprecation notice on stderr so stdout
  // stays clean while operators migrate to `models set|reset|free`.
  const tier = args.find((arg) => arg.startsWith('--tier='))?.split('=')[1] ?? '';
  const modelFlag = args.find((arg) => arg.startsWith('--model='))?.split('=')[1];
  const legacySetFlag = args.find((arg) => arg.startsWith('--set='))?.split('=')[1];
  const setModel = modelFlag ?? legacySetFlag ?? '';

  if (sub === 'reset' || args.includes('--reset')) {
    if (sub !== 'reset') errorln('Note: `construct models --reset` is a deprecated alias for `construct models reset`.');
    resetEnv(envPath);
    println(`Removed CX_MODEL_* overrides from ${envPath}.`);
    await cmdSync([]);
    return;
  }
  if (sub === 'set' || (sub === null && tier && setModel)) {
    if (!tier || !setModel) {
      errorln('Usage: construct models set --tier=<reasoning|standard|fast> --model=<provider/model-id>');
      process.exit(1);
    }
    if (modelFlag === undefined && legacySetFlag !== undefined) {
      errorln('Note: `--set=<model>` is a deprecated alias for `--model=<model>`.');
    }
    if (sub === null) {
      errorln('Note: `construct models --tier=… --set=…` is a deprecated alias for `construct models set --tier=… --model=…`.');
    }
    const preferFree = args.includes('--prefer-free');
    const preferFreeSameFamily = args.includes('--prefer-free-same-family');
    const inferred = setModelWithTierInference(envPath, tier, setModel, {}, { preferFree, preferFreeSameFamily });
    println(`Set ${tier} -> ${setModel} in ${envPath}`);
    if (preferFreeSameFamily) println('Prefer-free-same-family mode: enabled');
    if (preferFree) println('Prefer-free mode: enabled');
    println(`Resolved tier set:`);
    println(`  reasoning  ${String(inferred.reasoning)}`);
    println(`  standard   ${String(inferred.standard)}`);
    println(`  fast       ${String(inferred.fast)}`);
    await cmdSync([]);
    return;
  }
  if (sub === 'free' || args.includes('--poll')) {
    if (sub !== 'free') errorln('Note: `construct models --poll` is a deprecated alias for `construct models free`.');
    const apiKey = process.env.OPENROUTER_API_KEY || readOpenRouterApiKeyFromOpenCodeConfig();
    if (!apiKey) {
      errorln('Error: no OpenRouter API key found in OPENROUTER_API_KEY or OpenCode config.');
      process.exit(1);
    }
    const models = await pollFreeModels(apiKey);
    println('Available free models on OpenRouter:\n');
    for (const currentTier of MODEL_TIERS) {
      const top = topForTier(models, currentTier, 3);
      println(`  ${currentTier} (top ${top.length}):`);
      top.forEach((model, index) => println(`    ${index + 1}. ${model.id}`));
      println('');
    }
    return;
  }
  if (args.includes('--apply')) {
    const apiKey = process.env.OPENROUTER_API_KEY || readOpenRouterApiKeyFromOpenCodeConfig();
    const models = await pollFreeModels(apiKey);
    const selections = {};
    for (const currentTier of MODEL_TIERS) {
      const fallbacks = [];
      const id = selectForTier(models, currentTier, fallbacks);
      if (id) selections[currentTier] = id;
    }
    applyToEnv(envPath, selections);
    println(`Written to ${envPath}. Running construct sync...`);
    await cmdSync([]);
    return;
  }
  if (args.includes('--cheapest')) {
    const { selectCheapestProvider, formatCheapestProviderMessage, isCheapestProviderEnabled } =
      await import('../lib/model-cheapest-provider.mjs');
    const cheapestTier = args.find((arg) => arg.startsWith('--tier='))?.split('=')[1] ?? 'standard';
    const verbose = args.includes('--verbose');
    const enabled = isCheapestProviderEnabled(envPath, { env: process.env });
    const result = await selectCheapestProvider(cheapestTier, { env: process.env });
    const msg = formatCheapestProviderMessage(result, { showRanking: verbose });
    println(msg);
    if (enabled) println('\nCheapest provider mode: enabled');
    return;
  }
  if (args.includes('--apply-cheapest')) {
    const { setCheapestProviderPreference } =
      await import('../lib/model-cheapest-provider.mjs');
    const allTiers = args.includes('--all-tiers') || !args.find((arg) => arg.startsWith('--tier='));
    const tierArg = args.find((arg) => arg.startsWith('--tier='))?.split('=')[1];
    const tiers = allTiers ? [...MODEL_TIERS] : (tierArg ? [tierArg] : ['standard']);
    const selections = {};
    for (const currentTier of tiers) {
      const { selectCheapestProvider } = await import('../lib/model-cheapest-provider.mjs');
      const result = await selectCheapestProvider(currentTier, { env: process.env });
      if (result.modelId) selections[currentTier] = result.modelId;
    }
    if (Object.keys(selections).length === 0) {
      errorln('No configured providers found. Set API keys or install Ollama first.');
      process.exit(1);
    }
    applyToEnv(envPath, selections);
    println('Applying cheapest models:');
    for (const [tier, model] of Object.entries(selections)) {
      println(`  ${tier.padEnd(11)} ${model}`);
    }
    println(`Written to ${envPath}. Running construct sync...`);
    setCheapestProviderPreference(envPath, true);
    await cmdSync([]);
    return;
  }
  if (args.includes('--list') || sub === 'list') {
    const { getProviderModelCatalog } = await import('../lib/model-router.mjs');
    const catalog = getProviderModelCatalog({ env: process.env, cwd: process.cwd() });
    const models = listAvailableModels({ env: process.env, cwd: process.cwd() });
    if (args.includes('--json')) {
      println(JSON.stringify({ catalog, models }, null, 2));
      return;
    }
    println('Visible models (filtered by construct.config.json models.visibility):');
    for (const model of models) {
      const flag = model.available ? 'ok' : '—';
      println(`  ${flag}  ${model.id}${model.configured ? '' : ' (provider not configured)'}`);
    }
    return;
  }
  const result = readCurrentModels(envPath, {});
  const nothingSelected = MODEL_TIERS.every((t) => !result[t]);
  println('Current model assignments:');
  for (const currentTier of MODEL_TIERS) {
    const id = result[currentTier];
    const source = result.sources?.[currentTier] || (id ? 'registry' : 'not configured');
    println(`  ${currentTier.padEnd(11)}${id ? `${id} [${source}]` : '(not configured)'}`);
  }
  if (nothingSelected) {
    println('');
    println('No tier has a model selected. Construct ships with no default.');
    println('Pick one of:');
    println('  • `construct models` (single source of truth)');
    println('  • construct models set --tier=<reasoning|standard|fast> --model=<provider/model-id>');
    println('  • construct models --apply           Poll OpenRouter free catalog and seed all tiers');
  }
}

async function cmdModelsPolicy(args) {
  const sub = args[0] && !args[0].startsWith('-') ? args[0] : 'show';
  const asJson = args.includes('--json');
  const {
    computePolicyPreset, writeModelRegistry, readPolicyView, POLICY_PRESETS,
  } = await import('../lib/model-policy.mjs');
  const { defaultModelRegistryPath } = await import('../lib/model-router.mjs');
  const registryPath = defaultModelRegistryPath(process.env);

  if (sub === 'show') {
    const view = readPolicyView({ env: process.env, registryPath });
    if (asJson) {
      println(JSON.stringify(view, null, 2));
      return;
    }
    println('Effective model policy:');
    for (const t of view.tiers) {
      const model = t.model ?? '(not configured)';
      println(`  ${t.tier.padEnd(11)}${model}  [${t.source}]`);
    }
    println('');
    println('Work category → tier:');
    for (const [category, tier] of Object.entries(view.workCategoryMap)) {
      println(`  ${category.padEnd(11)}→ ${tier}`);
    }
    println('');
    println(`Registry: ${registryPath}`);
    println('Precedence: CX_MODEL_<TIER> env pins always win over registry defaults.');
    return;
  }

  if (sub === 'set') {
    const preset = args[1] && !args[1].startsWith('-') ? args[1] : null;
    if (!preset) {
      errorln(`Usage: construct models policy set <${POLICY_PRESETS.join('|')}>`);
      process.exit(1);
    }
    const apiKey = process.env.OPENROUTER_API_KEY || readOpenRouterApiKeyFromOpenCodeConfig() || null;
    const result = await computePolicyPreset(preset, { env: process.env, apiKey });
    if (!result.ok) {
      errorln(result.refusal);
      for (const w of result.warnings ?? []) errorln(`  ${w}`);
      process.exit(1);
    }
    writeModelRegistry(registryPath, result.models, { preset });
    if (asJson) {
      println(JSON.stringify({ preset, registryPath, models: result.models, warnings: result.warnings }, null, 2));
      return;
    }
    println(`Applied \`${preset}\` policy to ${registryPath}:`);
    for (const tier of MODEL_TIERS) {
      const def = result.models[tier];
      const primary = def?.primary ?? '(unset)';
      const fallback = def?.fallback?.length ? `  (fallback: ${def.fallback.join(', ')})` : '';
      println(`  ${tier.padEnd(11)}${primary}${fallback}`);
    }
    for (const w of result.warnings ?? []) errorln(`Note: ${w}`);
    println('');
    println('Env pins (CX_MODEL_<TIER>) still override these. Run `construct sync` to propagate.');
    if (!args.includes('--no-sync')) await cmdSync([]);
    return;
  }

  errorln(`Unknown models policy subcommand: ${sub}. Use \`show\` or \`set <preset>\`.`);
  process.exit(1);
}

async function cmdModelsExplain(args) {
  const asJson = args.includes('--json');
  const roleFlagIdx = args.indexOf('--role');
  const role = roleFlagIdx !== -1 ? args[roleFlagIdx + 1] : (args[0] && !args[0].startsWith('-') ? args[0] : null);
  if (!role) {
    errorln('Usage: construct models explain --role <specialist>');
    process.exit(1);
  }
  const { explainRole } = await import('../lib/model-policy.mjs');
  const trace = explainRole(role, { env: process.env, rootDir: ROOT_DIR });
  if (!trace.ok) {
    errorln(trace.error);
    process.exit(1);
  }
  if (asJson) {
    println(JSON.stringify(trace, null, 2));
    return;
  }
  println(`Resolution trace for ${trace.role}:`);
  println(`  declared tier:   ${trace.declaredTier ?? '(none)'}`);
  if (trace.declaredModel) println(`  declared model:  ${trace.declaredModel}`);
  println(`  resolved tier:   ${trace.tier}`);
  println(`  resolved model:  ${trace.resolvedModel ?? '(not configured)'}`);
  println(`  winning source:  ${trace.source}`);
  println('');
  println(`Matches: construct models resolve --json --tier ${trace.tier}`);
}

